    },
    "light": {
      "bg":          { "$type": "color", "$value": "#F6F6F4" },
      "surface":     { "$type": "color", "$value": "#FFFFFF" },
      "raised":      { "$type": "color", "$value": "#EFEFEC" },
      "hairline":    { "$type": "color", "$value": "rgba(0,0,0,0.08)" },
      "hairline-strong": { "$type": "color", "$value": "rgba(0,0,0,0.14)" },
      "highlight":   { "$type": "color", "$value": "rgba(255,255,255,0.9)" },
      "text":        { "$type": "color", "$value": "#111113", "$description": "17.4:1 on bg" },
      "muted":       { "$type": "color", "$value": "#5D5D66", "$description": "6.1:1 on bg, 5.6:1 on raised" },
      "signal":      { "$type": "color", "$value": "#E89B22", "$description": "lamp fill" },
      "signal-text": { "$type": "color", "$value": "#9A5B00", "$description": "5.4:1 on white" },
      "signal-edge": { "$type": "color", "$value": "rgba(154,91,0,0.55)" },
      "signal-glow": { "$type": "color", "$value": "rgba(232,155,34,0.12)" },
      "window-lift": { "$type": "color", "$value": "rgba(255,255,255,0)" },
      "shadow":      { "$type": "color", "$value": "rgba(17,17,19,0.16)" },
      "button-bg":   { "$type": "color", "$value": "#111113" },
      "button-fg":   { "$type": "color", "$value": "#FFFFFF" },
      "logo-dot":    { "$type": "color", "$value": "#3F6FF5" }
    }
  },
  "font": {
    "sans":    { "$type": "fontFamily", "$value": ["Geist", "Pretendard", "system-ui", "sans-serif"], "$description": "Geist — SIL OFL 1.1 (Vercel), Google Fonts" },
    "sans-ko": { "$type": "fontFamily", "$value": ["Pretendard", "Geist", "system-ui", "sans-serif"], "$description": "Pretendard — SIL OFL 1.1" },
    "mono":    { "$type": "fontFamily", "$value": ["Geist Mono", "ui-monospace", "monospace"], "$description": "Geist Mono — SIL OFL 1.1, Google Fonts" },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 }
    }
  },
  "size": {
    "display":  { "$type": "dimension", "$value": "68px", "$description": "hero headline at 1440 (ko 60px), tracking -0.035em" },
    "display-m":{ "$type": "dimension", "$value": "40px", "$description": "hero headline at 390 (ko 34px)" },
