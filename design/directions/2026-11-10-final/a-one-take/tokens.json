{
  "$description": "equipe.im — Direction A 'One take' (T-521 final). CSS variables in style.css use only these values.",
  "color": {
    "dark": {
      "bg":          { "$type": "color", "$value": "#0A0A0B", "$description": "page + stage" },
      "surface":     { "$type": "color", "$value": "#111113", "$description": "app window" },
      "raised":      { "$type": "color", "$value": "#18181B", "$description": "cards inside the window" },
      "hairline":    { "$type": "color", "$value": "rgba(255,255,255,0.08)" },
      "hairline-strong": { "$type": "color", "$value": "rgba(255,255,255,0.14)" },
      "highlight":   { "$type": "color", "$value": "rgba(255,255,255,0.06)", "$description": "1px inner top highlight on the window" },
      "text":        { "$type": "color", "$value": "#EDEDEF", "$description": "16.9:1 on bg" },
      "muted":       { "$type": "color", "$value": "#8B8B94", "$description": "5.8:1 on bg, 5.2:1 on raised" },
      "signal":      { "$type": "color", "$value": "#F2A93B", "$description": "my turn only: decision card edge/lamp, the Your-turn chip, step 6" },
      "signal-text": { "$type": "color", "$value": "#F2A93B" },
      "signal-edge": { "$type": "color", "$value": "rgba(242,169,59,0.55)" },
