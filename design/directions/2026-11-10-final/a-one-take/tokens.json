    "h2-m":     { "$type": "dimension", "$value": "28px" },
    "lead":     { "$type": "dimension", "$value": "18px" },
    "body":     { "$type": "dimension", "$value": "16px" },
    "ui":       { "$type": "dimension", "$value": "14px" },
    "ui-s":     { "$type": "dimension", "$value": "13px", "$description": "smallest text in the scene at 1440" },
    "ui-xs":    { "$type": "dimension", "$value": "12px", "$description": "smallest text in the scene at 390" },
    "metric":   { "$type": "dimension", "$value": "28px" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" },
    "20": { "$type": "dimension", "$value": "80px" },
    "30": { "$type": "dimension", "$value": "120px" },
    "40": { "$type": "dimension", "$value": "160px" }
  },
  "radius": {
    "xs":     { "$type": "dimension", "$value": "4px", "$description": "keycaps, chips" },
    "s":      { "$type": "dimension", "$value": "6px", "$description": "in-app buttons" },
    "m":      { "$type": "dimension", "$value": "10px", "$description": "in-app cards" },
    "l":      { "$type": "dimension", "$value": "14px", "$description": "app window" },
    "button": { "$type": "dimension", "$value": "999px", "$description": "page action buttons (pill) — differs from in-app buttons" }
  }
}
