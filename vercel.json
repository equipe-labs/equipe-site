{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/download/android",
      "destination": "https://github.com/equipe-labs/equipe-site/releases/download/android-v0.2.0/equipe-android-0.2.0.apk",
      "statusCode": 307
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.equipe.im" }],
      "destination": "https://equipe.im/:path",
      "statusCode": 301
    },
    {
      "source": "/:path((?!ingest/|_vercel/|\\.well-known/)(?:[^/]+/)*[^/.]+)",
      "destination": "/:path/",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/grader/r/:id([A-Za-z0-9]{6,16})/",
      "destination": "https://platform.equipe.im/v1/free/grade/:id/share?l="
    },
    {
      "source": "/:loc(ko|ja|zh-cn|es|pt-br|de|fr)/grader/r/:id([A-Za-z0-9]{6,16})/",
      "destination": "https://platform.equipe.im/v1/free/grade/:id/share?l=:loc"
    },
    {
      "source": "/tools/idea-validator/r/:id([A-Za-z0-9]{6,16})/",
      "destination": "https://platform.equipe.im/v1/free/idea/:id/share?l="
    },
    {
      "source": "/:loc(ko|ja|zh-cn|es|pt-br|de|fr)/tools/idea-validator/r/:id([A-Za-z0-9]{6,16})/",
      "destination": "https://platform.equipe.im/v1/free/idea/:id/share?l=:loc"
    },
    {
      "source": "/business-name-generator/r/:id([A-Za-z0-9]{6,16})/",
      "destination": "https://platform.equipe.im/v1/free/names/:id/share?l="
    },
    {
      "source": "/:loc(ko|ja|zh-cn|es|pt-br|de|fr)/business-name-generator/r/:id([A-Za-z0-9]{6,16})/",
      "destination": "https://platform.equipe.im/v1/free/names/:id/share?l=:loc"
    },
    {
      "source": "/ingest/static/:path(.*)",
      "destination": "https://us-assets.i.posthog.com/static/:path"
    },
    {
      "source": "/ingest/:path(.*)",
      "destination": "https://us.i.posthog.com/:path"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
        }
      ]
    },
    {
      "source": "/((?!_astro/|ingest/).*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "missing": [{ "type": "host", "value": "equipe.im" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
