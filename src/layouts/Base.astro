---
import BaseHead from '../components/BaseHead.astro';
import '../styles/global.css';
import { getLocale, type LocaleCode } from '../i18n';

interface Props {
  title: string;
  description: string;
  locale: LocaleCode;
  ogTitle?: string;
  ogDescription?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  subpage?: string;
  error?: boolean;
  alternates?: boolean;
}
const { lang } = getLocale(Astro.props.locale);
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead {...Astro.props} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* No font preloads: San Francisco is the system font on Apple devices, and Inter / Pretendard are fetched only where it is missing. */}
    <slot name="head" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <slot />
  </body>
</html>
