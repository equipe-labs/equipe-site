---
import BaseHead from '../components/BaseHead.astro';
import OwnFunnel from '../components/OwnFunnel.astro';
import '../styles/global.css';
import { getLocale, type LocaleCode } from '../i18n';

interface Props {
  title: string;
  description: string;
  locale: LocaleCode;
  ogTitle?: string;
  ogDescription?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  subpage?: string;
  error?: boolean;
  alternates?: boolean;
  langs?: LocaleCode[];
  ogType?: 'website' | 'article';
}
const { lang } = getLocale(Astro.props.locale);
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead {...Astro.props} />
    {/* No broken pictures: a picture that does not load shows a soft placeholder in its own box (the same script equipe products get from the launch kit). */}
    <style is:inline data-eq-img set:html={"img[data-eq-x]{object-fit:fill!important;object-position:center!important}"} />
    <script is:inline data-eq-img set:html={"(function(d){if(d.__eqx)return;d.__eqx=1;function S(c,k,w,h){return'data:image/svg+xml,'+encodeURIComponent('<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"'+(w||'100%')+'\" height=\"'+(h||'100%')+'\" fill=\"none\" stroke=\"'+c+'\"><rect width=\"100%\" height=\"100%\" fill=\"'+c+'\" opacity=\".08\"/><svg x=\"50%\" y=\"50%\" overflow=\"visible\"><g transform=\"scale('+k+')translate(-12-12)\" stroke-width=\"1.6\" opacity=\".45\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><circle cx=\"9\" cy=\"9\" r=\"2\"/><path d=\"m21 15-5-5L5 21\"/></g></svg></svg>')}function X(i){var r=i.getBoundingClientRect(),w=r.width|0,h=r.height|0,c=getComputedStyle(i).color,k=Math.min(1,Math.max(.3,Math.min(w,h)/48))||1,p=i.parentNode;i.setAttribute('data-eq-x','');i.removeAttribute('srcset');p&&p.tagName=='PICTURE'&&[].forEach.call(p.children,function(e){e.removeAttribute('srcset')});w&&i.addEventListener('load',function(){r=i.getBoundingClientRect();if(Math.abs(r.width-w)+Math.abs(r.height-h)>2)i.src=S(c,k,w,h)},{once:1});i.src=S(c,k)}d.addEventListener('error',function(e){var i=e.target,s=i.src;i.tagName=='IMG'&&i.getAttribute('data-fb')!='under'&&setTimeout(function(){i.isConnected&&i.src==s&&!i.naturalWidth&&X(i)})},!0);function V(){[].forEach.call(d.images,function(i){i.complete&&!i.naturalWidth&&i.getAttribute('src')&&i.decode&&i.decode().catch(function(){i.naturalWidth||X(i)})})}d.addEventListener('DOMContentLoaded',V);addEventListener('load',V)})(document)"} />
    {/* No font preloads: San Francisco is the system font on Apple devices, and Pretendard (Korean) is fetched only where Apple SD Gothic Neo is missing. */}
    <slot name="head" />
    {/* What people run into here (rage and dead clicks, script errors, slow pages, forms left): the same capture as equipe's products, counted on app.equipe.im with no id, no cookie and nothing on Do Not Track (cloud docs/analytics.md "equipe's own frustration"). */}
    {/* The landing funnel (cloud docs/analytics.md "equipe's own landing funnel"): calls wait here until the collector loads.
        A/B arms are drawn once per tab (sessionStorage, no id) before the first paint, so an arm never flickers; the page's
        CSS reads <html data-ab-NAME>. Arms change nothing for search engines (both arms are the same page). */}
    <script is:inline>
      (function (w) {
        w.__eqOwnQ = w.__eqOwnQ || []; w.eqOwn = w.eqOwn || function (k, t, f) { w.__eqOwnQ.push([k, t, f]); };
        var ab = {}, r = document.documentElement;
        try { ab = JSON.parse(sessionStorage.getItem('eq_ab') || '{}') || {}; } catch (e) {}
        ['hero'].forEach(function (x) { if (ab[x] !== 'a' && ab[x] !== 'b') ab[x] = Math.random() < 0.5 ? 'a' : 'b'; });
        try { sessionStorage.setItem('eq_ab', JSON.stringify(ab)); } catch (e) {}
        w.__eqAB = ab; for (var x in ab) r.setAttribute('data-ab-' + x, ab[x]);
      })(window);
    </script>
    <script is:inline async src="https://app.equipe.im/_own/rum.js?s=landing"></script>
    <script is:inline>
      document.documentElement.classList.add('js');
      // Theme: follows the device unless the header toggle stored 'light' or 'dark' (absent = system).
      (function () {
        var r = document.documentElement, t = null, mq = matchMedia('(prefers-color-scheme: dark)');
        try { t = localStorage.getItem('equipe-theme'); } catch (e) {}
        function apply() {
          var mode = t === 'light' || t === 'dark' ? t : mq.matches ? 'dark' : 'light';
          r.dataset.theme = mode; r.dataset.themePref = t === 'light' || t === 'dark' ? t : 'system';
          var m = document.querySelector('meta[name="theme-color"]'); if (m) m.content = mode === 'dark' ? '#17181C' : '#F6F5F1';
        }
        apply();
        mq.addEventListener && mq.addEventListener('change', function () { if (r.dataset.themePref === 'system') apply(); });
        window.__eqTheme = function (v) { t = v === 'system' ? null : v; try { t ? localStorage.setItem('equipe-theme', t) : localStorage.removeItem('equipe-theme'); } catch (e) {} apply(); };
      })();
    </script>
  </head>
  <body>
    <slot />
    <OwnFunnel />
  </body>
</html>
