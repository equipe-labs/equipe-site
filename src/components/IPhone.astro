---
// A realistic iPhone (16 Pro proportions, 393 x 852 points) drawn in CSS: titanium frame, side buttons, Dynamic Island,
// iOS status bar, optional Safari compact address bar, home indicator. Everything inside scales with --w.
// Used by the home page (the app the team shipped) and /developers (the approval screen).
interface Props { w?: number; url?: string; class?: string; label?: string }
const { w = 260, url, class: cls = '', label } = Astro.props;
---
<figure class={`iph ${cls}`.trim()} style={`--w:${w}px`} role={label ? 'img' : undefined} aria-label={label}>
  <div class="iph-frame" aria-hidden={label ? 'true' : undefined}>
    <i class="iph-btn iph-act"></i><i class="iph-btn iph-vup"></i><i class="iph-btn iph-vdn"></i><i class="iph-btn iph-pwr"></i>
    <div class="iph-screen">
      <div class="iph-status">
        <span class="iph-time">9:41</span>
        <span class="iph-island"></span>
        <span class="iph-glyphs">
          <svg viewBox="0 0 18 12"><rect x="0" y="8" width="3" height="4" rx="0.8" /><rect x="5" y="5.5" width="3" height="6.5" rx="0.8" /><rect x="10" y="3" width="3" height="9" rx="0.8" /><rect x="15" y="0" width="3" height="12" rx="0.8" /></svg>
          <svg viewBox="0 0 16 12"><path d="M8 11.2l2.2-2.6a3.2 3.2 0 0 0-4.4 0z" /><path d="M8 5.3a6.6 6.6 0 0 1 4.6 1.9l1.2-1.4a8.5 8.5 0 0 0-11.6 0l1.2 1.4A6.6 6.6 0 0 1 8 5.3z" /><path d="M8 1.6a10.3 10.3 0 0 1 7.1 2.8L16 3.1a12.2 12.2 0 0 0-16 0l.9 1.3A10.3 10.3 0 0 1 8 1.6z" /></svg>
          <svg viewBox="0 0 27 12"><rect x="0.5" y="0.5" width="23" height="11" rx="3.2" fill="none" stroke="currentColor" stroke-opacity="0.4" /><rect x="2" y="2" width="18" height="8" rx="2" /><path d="M25 4v4a2 2 0 0 0 0-4z" fill-opacity="0.45" /></svg>
        </span>
      </div>
      <div class="iph-content"><slot /></div>
      {url && (
        <div class="iph-safari">
          <span class="iph-aa">AA</span>
          <span class="iph-url"><svg viewBox="0 0 24 24"><path d="M7 11V8a5 5 0 0 1 10 0v3M5 11h14v9H5z" /></svg>{url}</span>
          <svg class="iph-rl" viewBox="0 0 24 24"><path d="M20 12a8 8 0 1 1-2.3-5.7M20 4v5h-5" /></svg>
        </div>
      )}
      <i class="iph-home"></i>
    </div>
    <i class="iph-glare"></i>
  </div>
</figure>
