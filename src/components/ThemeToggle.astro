---
// System / light / dark toggle (the page follows the device until a choice is made). Lives in the footer; the inline <head> script in Base.astro applies and remembers the choice.
interface Props { l: { system: string; light: string; dark: string } }
const { l } = Astro.props;
---
<button type="button" class="theme-t" data-theme-toggle data-l-system={l.system} data-l-light={l.light} data-l-dark={l.dark} aria-label={l.system}>
  <svg class="i-system" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4.5" width="18" height="12" rx="2" /><path d="M9 20h6M12 16.5V20" /></svg>
  <svg class="i-light" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" /></svg>
  <svg class="i-dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
</button>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) => {
    const root = document.documentElement;
    const order = ['system', 'light', 'dark'] as const;
    const sync = () => {
      const pref = (root.dataset.themePref as (typeof order)[number]) || 'system';
      const label = b.dataset[`l${pref[0].toUpperCase()}${pref.slice(1)}` as 'lSystem'] ?? '';
      b.setAttribute('aria-label', label); b.title = label; b.dataset.pref = pref;
    };
    sync();
    b.addEventListener('click', () => {
      const cur = (root.dataset.themePref as (typeof order)[number]) || 'system';
      const next = order[(order.indexOf(cur) + 1) % order.length];
      (window as unknown as { __eqTheme?: (v: string) => void }).__eqTheme?.(next);
      sync();
      (window as unknown as { eqTrack?: (n: string, p?: unknown) => void }).eqTrack?.('theme_toggle', { theme: next });
    });
  });
</script>
