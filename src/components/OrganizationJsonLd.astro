---
import JsonLd from './JsonLd.astro';
import { SITE, BRAND } from '../data/site';
import { FOUNDER } from '../data/flags';
// One brand entity on every page: the company "equipe AI" (legal name Umbriles Inc.) makes the product "equipe".
// sameAs lists official profiles only (src/data/site.ts BRAND.sameAs); add social accounts there when they exist.
---

<JsonLd
  data={{
    '@type': 'Organization',
    '@id': `${SITE.url}/#organization`,
    name: BRAND.name,
    alternateName: [BRAND.product, 'equipe.im'],
    legalName: BRAND.legalName,
    url: SITE.url,
    description: BRAND.oneLiner,
    logo: { '@type': 'ImageObject', '@id': `${SITE.url}/#logo`, url: `${SITE.url}${BRAND.logo.png}`, width: 512, height: 512, caption: BRAND.name },
    image: { '@id': `${SITE.url}/#logo` },
    foundingDate: BRAND.foundingDate,
    address: { '@type': 'PostalAddress', addressLocality: 'San Francisco', addressRegion: 'CA', addressCountry: 'US' },
    email: SITE.supportEmail,
    contactPoint: { '@type': 'ContactPoint', contactType: 'customer support', email: SITE.supportEmail, url: `${SITE.url}/app/support/` },
    brand: { '@type': 'Brand', name: BRAND.product, logo: `${SITE.url}${BRAND.logo.png}` },
    sameAs: [...BRAND.sameAs],
    ...(FOUNDER ? { founder: { '@id': `${SITE.url}/#founder` }, founders: [{ '@id': `${SITE.url}/#founder` }] } : {}),
  }}
/>
{FOUNDER && (
  <JsonLd
    data={{
      '@type': 'Person',
      '@id': `${SITE.url}/#founder`,
      name: FOUNDER.name,
      jobTitle: 'Founder',
      url: `${SITE.url}/about/`,
      image: `${SITE.url}${FOUNDER.photoLarge}`,
      worksFor: { '@id': `${SITE.url}/#organization` },
      sameAs: [FOUNDER.links.x, FOUNDER.links.linkedin],
    }}
  />
)}
