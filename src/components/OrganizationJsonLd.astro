---
import JsonLd from './JsonLd.astro';
import { SITE } from '../data/site';
import { FOUNDER } from '../data/flags';
// sameAs lists official profiles only; add social accounts here when they exist.
---

<JsonLd
  data={{
    '@type': 'Organization',
    '@id': `${SITE.url}/#organization`,
    name: SITE.name,
    alternateName: 'equipe AI',
    legalName: 'Umbriles Inc.',
    url: SITE.url,
    logo: { '@type': 'ImageObject', url: `${SITE.url}/brand/logo-512.png`, width: 512, height: 512 },
    email: SITE.supportEmail,
    contactPoint: { '@type': 'ContactPoint', contactType: 'customer support', email: SITE.supportEmail },
    sameAs: [SITE.repo],
    ...(FOUNDER ? { founder: { '@id': `${SITE.url}/#founder` } } : {}),
  }}
/>
{FOUNDER && (
  <JsonLd
    data={{
      '@type': 'Person',
      '@id': `${SITE.url}/#founder`,
      name: FOUNDER.name,
      jobTitle: 'Founder',
      url: `${SITE.url}/about/`,
      image: `${SITE.url}${FOUNDER.photoLarge}`,
      worksFor: { '@id': `${SITE.url}/#organization` },
      sameAs: [FOUNDER.links.x, FOUNDER.links.linkedin],
    }}
  />
)}
