---
import { available as allLocales, getLocale, localePath, subPath, type LocaleCode } from '../i18n';

interface Props {
  locale: LocaleCode;
  label: string;
  /** Sub-page to link to in each language; the landing page when omitted. */
  subpage?: string;
  /** Only these languages (a page that is not translated everywhere). */
  langs?: LocaleCode[];
}
const { locale, label, subpage, langs } = Astro.props;
const available = langs ? allLocales.filter((l) => langs.includes(l.code)) : allLocales;
const current = getLocale(locale);
---

{
  available.length > 1 && (
    <details class="lang" data-lang-menu>
      <summary aria-label={`${current.name}, ${label}`}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9" />
          <path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z" />
        </svg>
        <span class="lang-name" lang={current.lang}>{current.name}</span>
      </summary>
      <ul class="lm" role="list">
        {available.map((l) => (
          <li class="lm-i">
            <a href={subpage ? subPath(l, subpage) : localePath(l)} lang={l.lang} hreflang={l.lang} aria-current={l.code === locale ? 'true' : undefined} data-lang-choice
              data-ph={l.code === locale ? undefined : 'language_switch'}
              data-ph-from={current.lang}
              data-ph-to={l.lang}
              data-ph-source="menu"
            >
              <span>{l.name}</span>
              {l.code === locale && <svg class="lm-ck" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>}
            </a>
          </li>
        ))}
      </ul>
    </details>
  )
}
<script>
  import { wirePop } from '../scripts/popover';
  // Close on Escape or a click outside; arrow keys move between languages.
  document.querySelectorAll<HTMLDetailsElement>('[data-lang-menu]').forEach((d) => {
    const links = () => [...d.querySelectorAll<HTMLAnchorElement>('.lm a')];
    d.addEventListener('toggle', () => { if (d.open) (links().find((a) => a.getAttribute('aria-current')) ?? links()[0])?.focus({ preventScroll: true }); });
    wirePop(d);
    d.addEventListener('keydown', (e) => {
      if (!d.open || !['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(e.key)) return;
      e.preventDefault();
      const l = links(), i = l.indexOf(document.activeElement as HTMLAnchorElement);
      const n = e.key === 'Home' ? 0 : e.key === 'End' ? l.length - 1 : (i + (e.key === 'ArrowDown' ? 1 : -1) + l.length) % l.length;
      l[n].focus();
    });
  });
  // Keep the section the reader is on when switching language.
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-choice]').forEach((a) => {
    a.addEventListener('click', () => {
      const base = a.getAttribute('href')!.split('#')[0];
      a.setAttribute('href', base + location.hash);
    });
  });
</script>
