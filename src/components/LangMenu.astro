---
import { available, getLocale, localePath, type LocaleCode } from '../i18n';

interface Props {
  locale: LocaleCode;
  label: string;
}
const { locale, label } = Astro.props;
const current = getLocale(locale);
---

{
  available.length > 1 && (
    <details class="lang">
      <summary aria-label={label}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9" />
          <path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z" />
        </svg>
        <span class="lang-name" lang={current.lang}>{current.name}</span>
      </summary>
      <ul>
        {available.map((l) => (
          <li>
            <a href={localePath(l)} lang={l.lang} hreflang={l.lang} aria-current={l.code === locale ? 'true' : undefined} data-lang-choice
              data-ph={l.code === locale ? undefined : 'language_switch'}
              data-ph-from={current.lang}
              data-ph-to={l.lang}
              data-ph-source="menu"
            >
              {l.name}
            </a>
          </li>
        ))}
      </ul>
    </details>
  )
}
