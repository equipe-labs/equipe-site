---
import JsonLd from './JsonLd.astro';

interface Props {
  faqs: { question: string; answer: string }[];
}
const { faqs } = Astro.props;
---

<JsonLd
  data={{
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  }}
/>
