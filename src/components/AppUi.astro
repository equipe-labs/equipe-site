---
// The Mac app, drawn in code (T-242). `k` names a scene; the words come from src/i18n/app/<lang>.ts.
// Scenes: who · launch · stage · goal · build · appr · fa · fb · fc · fd · ev · st1 · st2 · st3
import type { AppText } from '../i18n/app/en';
import AppCard from './AppCard.astro';
interface Props { k: string; t: AppText; alt: string; dark?: boolean; class?: string }
const { k, t, alt, dark = false, class: cls = '' } = Astro.props;
const u = t.ui, L = t.lanes, I = t.inbox, D = t.decision, P = t.permission, C = t.chat;
const team: [string, string, string][] = [
  ['pm', u.idle, ''], ['frontend', u.permission, 'y'], ['data', u.yourTurn, 'y'],
  ['backend', `${u.working} · T-10`, 'w'], ['designer', `${u.working} · T-11`, 'w'], ['mobile', `${u.working} · T-9`, 'w'],
];
const tint = (c: string) => (c === 'y' ? 'var(--wait)' : c === 'w' ? 'var(--work)' : 'transparent');
---
<figure class={`win ${cls}`.trim()} role="img" aria-label={alt}>
<div class={`ap${dark ? ' dark' : ''}`} aria-hidden="true">
  {k === 'who' && (
    <div class="split">
      <div>
        <div class="grp">{I.permission} <span>1</span></div>
        <div class="row on"><i class="mono" style="color:var(--accent)">⚑</i><span class="id mono">T-5</span><i class="dot c-web"></i><span class="t">{I.allow}</span><span class="who">frontend</span><span></span></div>
        <div class="grp">{I.decisions} <span>2</span></div>
        <div class="row"><i class="mu">▢</i><span class="id mono">T-5</span><i class="dot c-web"></i><span class="t">{I.publish}</span><span class="who">frontend</span><span></span></div>
        <div class="row"><i class="mu">▢</i><span class="id mono">T-12</span><i class="dot c-srv"></i><span class="t">{I.paid}</span><span class="who" style="color:var(--ok)">data</span><span></span></div>
        <div class="grp">{I.yourTurn} <span>1</span></div>
        <div class="row"><i class="mu">⏸</i><span class="id mono">T-7</span><i class="dot c-web"></i><span class="t">{I.connect}</span><span class="who">{I.postHog}</span><span class="age">6{u.hours}</span></div>
        <div class="grp">{I.proposed} <span>1</span><span class="btn">{I.startAll}</span></div>
        <div class="row"><i class="mu">◌</i><span class="id mono">T-16</span><i class="dot c-web"></i><span class="t">{t.tickets[15]}</span><span class="who mu">{I.fromPm}</span><span class="age">6{u.hours}</span></div>
      </div>
      <div class="side-panel perm">
        <div class="k">{P.label}</div>
        <div class="lab">⚑ {P.label} <span class="mu">● frontend</span> <b class="mu">T-5</b></div>
        <h3>{P.title}</h3>
        <div class="cmd">{P.command}</div>
        <div class="why">{P.why}</div>
        <div class="acts"><span class="btn pri">{P.once} <kbd>A</kbd></span><span class="btn">{P.always} <kbd>⇧A</kbd></span><span class="btn">{P.deny} <kbd>N</kbd></span><span class="btn">{P.reply} <kbd>R</kbd></span></div>
        <div class="nt">{P.note}</div>
      </div>
    </div>
  )}

  {k === 'launch' && (
    <div class="lanes">
      <div class="lane"><h6>◔ {L.yourTurn} <span>1</span></h6><AppCard n={7} t={t} who="F" proj="website" kind="warn" /></div>
      <div class="lane"><h6>◕ {L.review} <span>2</span></h6><AppCard n={5} t={t} who="F" proj="website" kind="warn" cls="mv" /><AppCard n={6} t={t} who="B" proj="server" /></div>
      <div class="lane m-hide"><h6>✔ {L.done} <span>4</span></h6><AppCard n={1} t={t} who="D" proj="website" kind="done" /><AppCard n={2} t={t} who="F" proj="website" kind="done" /></div>
    </div>
  )}

  {k === 'ev' && (
    <div class="lanes" style="grid-template-columns:repeat(2,minmax(0,1fr))">
      <div class="lane"><h6>◕ {L.review} <span>2</span></h6><AppCard n={5} t={t} who="F" proj="website" kind="warn" /><AppCard n={6} t={t} who="B" proj="server" /></div>
      <div class="lane"><h6>✔ {L.done} <span>4</span></h6><AppCard n={1} t={t} who="D" proj="website" kind="done" /><AppCard n={2} t={t} who="F" proj="website" kind="done" /><AppCard n={3} t={t} who="B" proj="server" kind="done" /><AppCard n={4} t={t} who="D" proj="ios" kind="done" /></div>
    </div>
  )}

  {(k === 'fa' || k === 'build') && (
    <div class="lanes">
      <div class="lane"><h6>◌ {L.proposed} <span>1</span><i class="plus mu">+</i></h6><AppCard n={16} t={t} who="D" proj="website" level={1} /></div>
      <div class="lane m-hide"><h6>○ {L.todo} <span>3</span><i class="plus mu">+</i></h6><AppCard n={13} t={t} who="F" proj="website" level={1} /><AppCard n={14} t={t} who="B" proj="server" level={1} />{k === 'fa' && <AppCard n={15} t={t} who="M" proj="ios" level={1} />}</div>
      <div class="lane"><h6>◔ {L.inProgress} <span>5</span></h6><AppCard n={8} t={t} who="F" proj="website" busy={t.activity.t8} /><AppCard n={9} t={t} who="M" proj="ios" busy={t.activity.t9} />{k === 'fa' && <AppCard n={10} t={t} who="B" proj="server" busy={t.activity.t10} />}</div>
    </div>
  )}

  {k === 'stage' && (
    <div>
      <div class="sortbar"><b>{I.toSort}</b><span class="mu">{I.toSortHint}</span></div>
      <div class="grp">{L.yourTurn} <span>1</span></div>
      <div class="row"><i class="mu">⏸</i><span class="id mono">T-7</span><i class="dot c-web"></i><span class="t">{t.tickets[6]}</span><span class="who">frontend</span><span class="age">6{u.hours}</span></div>
      <div class="grp">{L.review} <span>2</span></div>
      <div class="row"><i class="mu">◕</i><span class="id mono">T-5</span><i class="dot c-web"></i><span class="t">{t.tickets[4]}</span><span class="who">frontend</span><span class="age">4{u.hours}</span></div>
      <div class="row"><i class="mu">◕</i><span class="id mono">T-6</span><i class="dot c-srv"></i><span class="t">{t.tickets[5]}</span><span class="who">backend</span><span class="age">5{u.hours}</span></div>
      <div class="grp">{L.inProgress} <span>5</span></div>
      <div class="row two"><i class="mu">◔</i><span class="id mono">T-8</span><i class="dot c-web"></i><span class="t">{t.tickets[7]}<span class="act">{t.activity.t8}</span></span><span class="who">frontend</span><span class="age">7{u.hours}</span></div>
      <div class="row two"><i class="mu">◔</i><span class="id mono">T-9</span><i class="dot c-ios"></i><span class="t">{t.tickets[8]}<span class="act">{t.activity.t9}</span></span><span class="who">mobile</span><span class="age">1{u.hours}</span></div>
      <div class="row two"><i class="mu">◔</i><span class="id mono">T-10</span><i class="dot c-srv"></i><span class="t">{t.tickets[9]}<span class="act">{t.activity.t10}</span></span><span class="who">backend</span><span class="age">1{u.hours}</span></div>
    </div>
  )}

  {k === 'goal' && (
    <div class="comp bare">
      <div class="ph">{u.composerBusy}</div>
      <div class="tools"><span class="plus">+</span><span><i class="dot" style="background:var(--work);width:7px;height:7px"></i> pm ⌄</span><span>{u.auto} ⌄</span><span style="margin-left:auto">◔ 31%</span><span>opus 5.5 ⌄</span><span>{u.effort} ⌄</span><span class="go">↑</span></div>
    </div>
  )}

  {k === 'appr' && (
    <div class="side-panel dec">
      <div class="k">{D.title}</div>
      <div class="hd"><span class="tag">{D.tag}</span><h3>{D.question}</h3></div>
      <div class="opt on"><b>{D.a}</b><i class="okm">✓</i><kbd>1</kbd><p>{D.aText}</p></div>
      <div class="opt"><b>{D.b}</b><kbd>2</kbd><p>{D.bText}</p></div>
      <div class="own"><span>✎</span><span>{D.own}</span><kbd>Tab</kbd></div>
      <div class="mu">⌀ {D.attach}</div>
      <div class="ft"><div class="hint"><b>● {D.asks}</b>{D.hint}</div><span class="btn">{D.skip}</span><span class="btn pri">{D.submit} <kbd>⌘↵</kbd></span></div>
    </div>
  )}

  {k === 'fb' && (
    <div class="chat">
      <div class="tool">{C.read}</div>
      <div class="who"><i class="dot" style="background:var(--work)"></i> pm</div>
      <div>{C.split}</div>
      <table>
        <thead><tr><th>{C.ticket}</th><th>{C.owner}</th><th>{C.what}</th></tr></thead>
        <tbody>
          <tr><td><u>T-8</u></td><td>frontend</td><td>{C.rows[0]}</td></tr>
          <tr><td><u>T-13</u></td><td>frontend</td><td>{C.rows[1]}</td></tr>
          <tr><td><u>T-12</u></td><td>data</td><td>{C.rows[2]}</td></tr>
          <tr><td><u>T-16</u></td><td>designer</td><td>{C.rows[3]}</td></tr>
        </tbody>
      </table>
      <div><u>{C.before}</u>{C.mid}<b>{C.bold}</b>{C.after}<u>T-8</u>{C.last}</div>
    </div>
  )}

  {k === 'fd' && (
    <div>
      <div class="cardnav"><span>{P.card}</span><span>←</span><span>→</span></div>
      <div class="side-panel perm">
        <div class="lab">⚑ {P.label} <span class="mu">● frontend</span> <b class="mu">T-5</b></div>
        <h3>{P.title}</h3>
        <div class="cmd">{P.command}</div>
        <div class="why">{P.why}</div>
        <div class="acts"><span class="btn pri">{P.once} <kbd>A</kbd></span><span class="btn">{P.always} <kbd>⇧A</kbd></span><span class="btn">{P.deny} <kbd>N</kbd></span><span class="btn">{P.reply} <kbd>R</kbd></span><span class="note">{P.note}</span></div>
      </div>
    </div>
  )}

  {(k === 'fc' || k === 'st3') && (
    <div class="side" style="border:0">
      {k === 'fc' && <>
        <h5>{u.projects}<span>+</span></h5>
        <div class="tm"><span class="mu">⌄</span><i class="dot c-web"></i><b>website</b></div>
        <div class="tk"><i class="dot" style="background:var(--wait)"></i><span>{t.tickets[4]}</span><span class="mu">4{u.hours}</span></div>
        <div class="tk"><i class="dot" style="background:var(--wait)"></i><span>{t.tickets[6]}</span><span class="mu">6{u.hours}</span></div>
        <div class="tk"><i class="dot ring"></i><span>{t.tickets[7]}</span><span class="mu">7{u.hours}</span></div>
        <div class="sep"></div>
        <div class="use"><div><span class="mu">{u.usage}</span><span class="mu" style="margin-left:auto">{u.suggest}</span></div>
          <div>Claude <span class="mu">5h</span><i class="bar"><i style="width:42%"></i></i><span class="mu">42%</span><span class="mu">wk</span><i class="bar hi"><i style="width:76%"></i></i><span class="mu">76%</span></div>
          <div>Codex <span class="mu">{u.notRead}</span></div></div>
        <div class="sep"></div>
      </>}
      <h5>⚇ {u.team} <span>6</span></h5>
      {team.map(([n, s, c]) => <div class="tm"><i class={`dot${c ? '' : ' ring'}`} style={c ? `background:${tint(c)}` : ''}></i><b>{n}</b><em class={c}>{s}</em></div>)}
    </div>
  )}

  {k === 'st1' && (
    <div class="side" style="border:0">
      <div class="it">+ {u.newMessage}</div><div class="it">▭ {u.pm}</div>
      <div class="it on">▣ {u.inbox}<span class="badge">5</span></div><div class="it">◔ {u.inProgress}<span class="n">5</span></div><div class="it">▦ {u.tickets}</div>
    </div>
  )}

  {k === 'st2' && (
    <div class="side" style="border:0"><div class="use"><div><span class="mu">{u.usage}</span><span class="mu" style="margin-left:auto">{u.suggest}</span></div>
      <div>Claude <span class="mu">5h</span><i class="bar"><i style="width:42%"></i></i><span class="mu">42%</span><span class="mu">wk</span><i class="bar hi"><i style="width:76%"></i></i><span class="mu">76%</span></div>
      <div>Codex <span class="mu">{u.notRead}</span></div></div></div>
  )}
</div>
</figure>
