---
// One person on /about, in the centered "team grid" pattern: small round avatar, name, role, a short bio, and small link icons.
interface Props { name: string; role: string; bio: string; photo?: string; initials: string; links: { linkedin: string; web?: string; github?: string; x?: string }; i?: number }
const { name, role, bio, photo, initials, links, i = 0 } = Astro.props;
// Avatars are shown at 64-80 px, so the 400 px export covers 2x and 3x screens; the page passes the 800 px path.
const small = photo ? photo.replace(/-800\.(jpe?g|webp)$/, '-400.$1') : '';
const webp = small.replace(/\.jpe?g$/, '.webp');
const I = {
  linkedin: 'M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z',
  github: 'M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.18 1.83 1.18 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z',
  x: 'M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.21-6.82-5.97 6.82H1.67l7.73-8.84L1.25 2.25h6.83l4.71 6.23 5.45-6.23zm-1.16 17.52h1.83L7.08 4.13H5.12l11.96 15.64z',
};
const items = [
  { k: 'linkedin', href: links.linkedin, label: `${name} on LinkedIn` },
  ...(links.github ? [{ k: 'github', href: links.github, label: `${name} on GitHub` }] : []),
  ...(links.x ? [{ k: 'x', href: links.x, label: `${name} on X` }] : []),
];
---
<article class="ab-p rv" style={`--i:${i}`}>
  <div class="ab-d">
    <div class="ab-sum">
      <span class="ab-av">
        {photo
          ? <picture><source type="image/webp" srcset={webp} /><img src={small} alt="" width="80" height="80" loading="lazy" decoding="async" /></picture>
          : <span class="ab-mono" aria-hidden="true">{initials}</span>}
      </span>
      <span class="ab-name">{name}</span>
      <span class="ab-role">{role}</span>
    </div>
    <p class="ab-bio">{bio}</p>
  </div>
  <p class="ab-soc">
    {items.map((x) => (
      <a href={x.href} target="_blank" rel="me noopener" aria-label={x.label} title={x.label}><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d={I[x.k as keyof typeof I]} /></svg></a>
    ))}
    {links.web && <a href={links.web} target="_blank" rel="me noopener" aria-label={`${name}, website`} title="Website"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.6 2.6 3.9 5.6 3.9 9s-1.3 6.4-3.9 9c-2.6-2.6-3.9-5.6-3.9-9S9.4 5.6 12 3z" /></svg></a>}
  </p>
</article>
