---
// One person on /about: large photo (or a monogram), name, role, a short factual line and a LinkedIn link.
interface Props { name: string; role: string; bio: string; photo?: string; initials: string; linkedin: string; extra?: { label: string; href: string }[]; i?: number }
const { name, role, bio, photo, initials, linkedin, extra = [], i = 0 } = Astro.props;
const webp = photo ? photo.replace(/\.jpe?g$/, '.webp') : '';
---
<article class="ab-p rv" style={`--i:${i}`}>
  <div class="ab-ph">
    {photo
      ? <picture><source type="image/webp" srcset={webp} /><img src={photo} alt={name} width="400" height="400" loading="lazy" decoding="async" /></picture>
      : <div class="ab-mono" aria-hidden="true">{initials}</div>}
  </div>
  <div class="ab-pb">
    <h3>{name}</h3>
    <p class="ab-role">{role}</p>
    <p class="ab-bio">{bio}</p>
    <p class="ab-soc">
      <a class="ab-in" href={linkedin} rel="me noopener" aria-label={`${name} on LinkedIn`} title="LinkedIn">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
      </a>
      {extra.map((x) => <a class="ab-ln" href={x.href} rel="me noopener">{x.label}</a>)}
    </p>
  </div>
</article>
