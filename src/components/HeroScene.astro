---
// The first screen's loop (T-243, plan A): one line to the PM → four tickets worked at once → one decision card → Live.
// Drawn in code with CSS keyframes (transform/opacity only); the base style is the 4.8 s frame, which is what shows with reduced motion.
// The progress bars and the Live banner are staged for the loop; the caption says so.
import type { AppText } from '../i18n/app/en';
interface Props { t: AppText; alt: string }
const { t, alt } = Astro.props;
const h = t.hero, u = t.ui, D = t.decision;
const S = 8; // seconds in one loop
const pc = (s: number) => +((s / S) * 100).toFixed(2);
const win = (n: string, a: number, b: number) => `@keyframes ${n}{0%,${pc(a) - 0.4}%{opacity:0}${pc(a)}%,${pc(b)}%{opacity:1}${pc(b) + 0.4}%,100%{opacity:0}}`;
const gone = (n: string, a: number, b: number) => `@keyframes ${n}{0%,${pc(a) - 0.4}%{opacity:1}${pc(a)}%,${pc(b)}%{opacity:0}${pc(b) + 0.4}%,100%{opacity:1}}`;
const rise = (n: string, a: number, b: number, y = 8) => `@keyframes ${n}{0%,${pc(a)}%{opacity:0;transform:translateY(${y}px)}${pc(b)}%,${pc(7.5)}%{opacity:1;transform:none}${pc(7.9)}%,100%{opacity:0}}`;
const tk = [
  { n: 8, who: 'F', s: 2.35, e: 4.35 }, { n: 13, who: 'F', s: 2.5, e: 4.0 }, { n: 12, who: 'D', s: 2.45, e: 4.62 }, { n: 16, who: 'D', s: 2.6, e: 4.2 },
];
const ids = [8, 13, 12, 16];
const css = [
  rise('hs-reply', 1.75, 2.0), rise('hs-reply2', 3.0, 3.3), rise('hs-dec', 4.7, 4.95, 14), rise('hs-live', 6.0, 6.3, 10),
  win('hs-pm-work', 1.35, 1.8), gone('hs-pm-idle', 1.35, 1.8),
  win('hs-fe-work', 2.35, 4.7), win('hs-fe-turn', 4.7, 5.95), win('hs-fe-done', 5.95, 7.5), `@keyframes hs-fe-idle{0%,${pc(2.35) - 0.4}%{opacity:1}${pc(2.35)}%,100%{opacity:0}}`,
  win('hs-de-work', 2.45, 4.62), `@keyframes hs-de-idle{0%,${pc(2.45) - 0.4}%{opacity:0}${pc(2.45)}%,${pc(4.62)}%{opacity:0}${pc(4.62) + 0.4}%,100%{opacity:1}}`,
  win('hs-badge', 4.7, 5.9),
  `@keyframes hs-cursor{0%,${pc(5.0)}%{opacity:0;transform:translate(120px,-40px)}${pc(5.2)}%{opacity:1;transform:translate(120px,-40px)}${pc(5.7)}%,${pc(6.0)}%{opacity:1;transform:translate(0,0)}${pc(6.3)}%,100%{opacity:0;transform:translate(0,0)}}`,
  `@keyframes hs-press{0%,${pc(5.7)}%{opacity:0}${pc(5.75)}%,100%{opacity:1}}`,
  `@keyframes hs-out{0%,${pc(5.8)}%{opacity:1;transform:none}${pc(6.05)}%,100%{opacity:0;transform:translateY(8px)}}`,
  `@keyframes hs-end{0%,${pc(7.55)}%{opacity:1}${pc(7.95)}%,100%{opacity:0}}`,
  ...tk.flatMap((k, i) => [
    rise(`hs-tc${i}`, 2.05 + 0.1 * i, 2.35 + 0.1 * i, 12),
    `@keyframes hs-bar${i}{0%,${pc(k.s)}%{transform:scaleX(0.04)}${pc(k.e)}%,100%{transform:scaleX(1)}}`,
    win(`hs-w${i}`, k.s, k.e), `@keyframes hs-d${i}{0%,${pc(k.e) - 0.4}%{opacity:0}${pc(k.e)}%,100%{opacity:1}}`,
    `@keyframes hs-c${i}{0%,${pc(k.s)}%{background:var(--muted)}${pc(k.e) - 0.5}%{background:var(--work)}${pc(k.e)}%,100%{background:var(--ok)}}`,
  ]),
].join('');
---
<figure class="win hs" role="img" aria-label={`${alt} ${h.label}`} data-hs>
  <style set:html={css} />
  <div class="ap" aria-hidden="true">
    <div class="shell">
      <div class="side">
        <div class="it">+ {u.newMessage}</div><div class="it on">▭ {u.pm}</div>
        <div class="it">▣ {u.inbox}<span class="badge hs-anim hs-b">1</span></div><div class="it">◔ {u.inProgress}</div><div class="it">▦ {u.tickets}</div>
        <h5>{u.projects}</h5><div class="tm"><i class="dot c-web"></i><b>website</b></div>
        <h5>{u.team} <span>6</span></h5>
        <div class="tm"><i class="dot ring"></i><b>pm</b><em class="st"><span class="hs-anim hs-pmi">{u.idle}</span><span class="hs-anim hs-pmw w">{h.working}</span></em></div>
        <div class="tm"><i class="dot ring"></i><b>frontend</b><em class="st"><span class="hs-anim hs-fei">{u.idle}</span><span class="hs-anim hs-few w">{h.working} · T-8</span><span class="hs-anim hs-fet y">{u.yourTurn}</span><span class="hs-anim hs-fed o">{u.done}</span></em></div>
        <div class="tm"><i class="dot ring"></i><b>designer</b><em class="st"><span class="hs-anim hs-dei">{u.idle}</span><span class="hs-anim hs-dew w">{h.working} · T-12</span></em></div>
        <div class="tm"><i class="dot ring"></i><b>data</b><em>{u.idle}</em></div>
        <div class="tm"><i class="dot ring"></i><b>backend</b><em>{u.idle}</em></div>
        <div class="tm"><i class="dot ring"></i><b>mobile</b><em>{u.idle}</em></div>
        <div class="foot"><i class="dot"></i><b>loop</b><span class="mu">{u.thisMac}</span></div>
      </div>
      <div class="main">
        <div class="top"><span class="pill"><i class="dot" style="background:var(--work)"></i> pm</span><span class="mu m-hide">{u.allProjects}</span><span class="mu m-hide" style="margin-left:auto">{u.context}</span></div>
        <div class="hs-body hs-anim hs-end">
          <div class="hs-chat">
            <div class="hs-say">{h.ask}</div>
            <div class="hs-pm hs-anim hs-reply m-hide">
              <div class="who"><i class="dot" style="background:var(--work)"></i> pm</div>
              <p>{h.reply}</p>
              <p class="hs-anim hs-reply2">{h.reply2}</p>
            </div>
            <div class="hs-decw">
              <div class="hs-dec hs-anim hs-dc">
                <div class="hs-decin hs-anim hs-outc">
                  <div class="k">◆ {D.title} · frontend · T-5</div>
                  <b class="q">{D.question}</b>
                  <p class="mu">{D.aText}</p>
                  <div class="b"><span class="btn pri">{h.publish} <kbd>1</kbd></span><span class="btn">{h.hold} <kbd>2</kbd></span><span class="btn pri hs-foc hs-anim hs-pr">{h.publish} <kbd>1</kbd></span></div>
                  <svg class="hs-cur hs-anim hs-cu" width="20" height="24" viewBox="0 0 22 26"><path d="M2 2 L2 20 L7 15.5 L10.5 23 L13.5 21.6 L10 14.5 L16.5 14 Z" fill="#fff" stroke="#000" stroke-width="1.4" stroke-linejoin="round"/></svg>
                </div>
              </div>
              <div class="hs-livew"><div class="hs-live hs-anim hs-lv"><i class="ok">✓</i><div><b>{h.liveTitle}</b><span>{h.liveText}</span></div><em>{h.approved}</em></div></div>
            </div>
          </div>
          <div class="hs-board">
            <div class="hs-bh">{t.lanes.inProgress} <span class="mu">4</span></div>
            {tk.map((k, i) => (
              <div class={`hs-tc hs-anim hs-tc${i}`}>
                <div class="l1"><span class={`av ${k.who}`}>{k.who}</span><span class="mono mu">T-{ids[i]}</span><span class="ti">{h.tickets[i]}</span>
                  <em class="hs-st"><span class={`w hs-anim hs-w${i}`}>{h.working}</span><span class={`o hs-anim hs-d${i}`}>{u.done}</span></em></div>
                <i class="hs-bar"><i class={`hs-anim hs-bar${i}`}></i></i>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
  <button class="hs-pause" type="button" data-pause data-play={h.play} data-stop={h.pause} aria-label={h.pause}><span aria-hidden="true">❚❚</span></button>
</figure>
<p class="hs-cap meta">{h.caption}</p>

<style>
  .hs { margin: 0; }
  .hs .ap { min-height: 560px; }
  .hs .shell { min-height: 560px; grid-template-columns: 224px 1fr; }
  .hs .st { position: relative; display: inline-block; min-width: 100px; height: 16px; text-align: right; }
  .hs .st span { position: absolute; right: 0; top: 0; white-space: nowrap; font-size: 12px; }
  .hs .st .w { color: var(--work); } .hs .st .y { color: var(--wait); } .hs .st .o { color: var(--ok); }
  /* rest frame (4.8 s): idle names hidden, frontend waits on you */
  .hs .st span:not(.hs-fet):not(.hs-pmi):not(.hs-dei) { opacity: 0; }
  .hs .st .hs-pmi, .hs .st .hs-dei { opacity: 1; color: var(--muted); }
  .hs-body { flex: 1; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); min-height: 0; }
  .hs-chat { position: relative; padding: 20px; border-right: 1px solid var(--line); display: grid; align-content: start; gap: 14px; }
  .hs-say { justify-self: start; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 10px 14px; font-size: 15px; }
  .hs-pm { display: grid; gap: 8px; font-size: 14px; line-height: 1.5; }
  .hs-pm p { margin: 0; } .hs-pm .who { display: flex; gap: 6px; align-items: center; color: var(--muted); font-size: 12px; }
  .hs-decw { position: absolute; left: 16px; right: 16px; bottom: 16px; }
  .hs-dec { border: 1.5px solid var(--wait); border-radius: 12px; background: var(--surface); padding: 14px; }
  .hs-decin { display: grid; gap: 8px; position: relative; }
  .hs-decin .k { font-size: 11.5px; color: var(--wait); font-weight: 600; }
  .hs-decin .q { font-size: 15px; }
  .hs-decin p { margin: 0; font-size: 12.5px; line-height: 1.45; }
  .hs-decin .b { display: flex; gap: 8px; position: relative; flex-wrap: wrap; }
  .hs .hs-foc { position: absolute; left: 0; top: 0; background: var(--accent); color: var(--on-accent); opacity: 0; }
  .hs-cur { position: absolute; left: 96px; bottom: -2px; opacity: 0; pointer-events: none; filter: drop-shadow(0 2px 3px #0008); }
  .hs-livew { position: absolute; left: 0; right: 0; bottom: 0; }
  .hs-live { display: none; }
  .hs-board { padding: 16px; display: grid; align-content: start; gap: 10px; }
  .hs-bh { font-weight: 600; margin-bottom: 2px; }
  .hs-tc { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 10px 12px; display: grid; gap: 9px; }
  .hs-tc .mono { white-space: nowrap; }
  .hs-tc .l1 { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .hs-tc .ti { font-weight: 600; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hs-st { position: relative; margin-left: auto; width: 62px; height: 16px; flex: none; font-style: normal; }
  .hs-st span { position: absolute; right: 0; top: 0; font-size: 11.5px; padding: 0 7px; border-radius: 99px; line-height: 16px; white-space: nowrap; }
  .hs-st .w { background: color-mix(in srgb, var(--work) 14%, transparent); color: var(--work); opacity: 0; }
  .hs-st .o { background: color-mix(in srgb, var(--ok) 14%, transparent); color: var(--ok); }
  .hs-bar { display: block; height: 5px; border-radius: 99px; background: var(--ap-sunken); overflow: hidden; }
  .hs-bar i { display: block; height: 100%; width: 100%; transform-origin: left; background: var(--ok); border-radius: 99px; }
  .hs-pause { position: absolute; right: 10px; bottom: 10px; width: 28px; height: 28px; border-radius: 50%; border: 1px solid var(--line); background: var(--surface); color: var(--muted); font-size: 8px; cursor: pointer; z-index: 3; }
  .hs-pause:focus-visible { outline: 2px solid var(--accent); }
  .hs-cap { margin-top: var(--s-3); max-width: 760px; }
  .hs .hs-b { opacity: 1; }
  @media (max-width: 700px) {
    .hs .ap, .hs .shell { min-height: 0; }
    .hs-body { grid-template-columns: 1fr; }
    .hs-chat { border-right: 0; border-bottom: 1px solid var(--line); padding: 14px; min-height: 0; }
    .hs-decw { position: static; }
    .hs-board { padding: 12px 14px 14px; }
    .hs .shell { grid-template-columns: 1fr; }
    .hs-pause { top: 8px; bottom: auto; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hs:not(.paused):not(.off) .hs-anim, .hs.paused .hs-anim, .hs.off .hs-anim { animation-duration: 8s; animation-iteration-count: infinite; animation-timing-function: ease-out; animation-fill-mode: both; }
    .hs.paused .hs-anim, .hs.off .hs-anim { animation-play-state: paused; }
    .hs .hs-end { animation-name: hs-end; animation-timing-function: linear; }
    .hs .hs-reply { animation-name: hs-reply; } .hs .hs-reply2 { animation-name: hs-reply2; } .hs .hs-dc { animation-name: hs-dec; } .hs .hs-lv { animation-name: hs-live; }
    .hs .hs-outc { animation-name: hs-out; }
    .hs .hs-pmi { animation-name: hs-pm-idle; } .hs .hs-pmw { animation-name: hs-pm-work; }
    .hs .hs-fei { animation-name: hs-fe-idle; } .hs .hs-few { animation-name: hs-fe-work; } .hs .hs-fet { animation-name: hs-fe-turn; } .hs .hs-fed { animation-name: hs-fe-done; }
    .hs .hs-dei { animation-name: hs-de-idle; } .hs .hs-dew { animation-name: hs-de-work; }
    .hs .hs-b { animation-name: hs-badge; }
    .hs .hs-cu { animation-name: hs-cursor; animation-timing-function: ease-in-out; } .hs .hs-pr { animation-name: hs-press; }
    .hs .hs-live { display: flex; }
    .hs .hs-tc0 { animation-name: hs-tc0; } .hs .hs-tc1 { animation-name: hs-tc1; } .hs .hs-tc2 { animation-name: hs-tc2; } .hs .hs-tc3 { animation-name: hs-tc3; }
    .hs .hs-bar0 { animation-name: hs-bar0; } .hs .hs-bar1 { animation-name: hs-bar1; } .hs .hs-bar2 { animation-name: hs-bar2; } .hs .hs-bar3 { animation-name: hs-bar3; }
    .hs .hs-w0 { animation-name: hs-w0; } .hs .hs-w1 { animation-name: hs-w1; } .hs .hs-w2 { animation-name: hs-w2; } .hs .hs-w3 { animation-name: hs-w3; }
    .hs .hs-d0 { animation-name: hs-d0; } .hs .hs-d1 { animation-name: hs-d1; } .hs .hs-d2 { animation-name: hs-d2; } .hs .hs-d3 { animation-name: hs-d3; }
  }
  @media (prefers-reduced-motion: reduce) { .hs-pause { display: none; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-hs]').forEach((el) => {
    const btn = el.querySelector<HTMLButtonElement>('[data-pause]')!;
    btn.addEventListener('click', () => {
      const p = el.classList.toggle('paused');
      btn.setAttribute('aria-label', p ? btn.dataset.play! : btn.dataset.stop!);
      btn.firstElementChild!.textContent = p ? '▶' : '❚❚';
    });
    new IntersectionObserver(([e]) => el.classList.toggle('off', !e.isIntersecting)).observe(el);
  });
</script>
