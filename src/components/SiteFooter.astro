---
// Footer for the marketing pages: Product / Company / Legal, the support address and the cookie line.
import Mark from './Mark.astro';
import Wordmark from './Wordmark.astro';
import LangMenu from './LangMenu.astro';
import ThemeToggle from './ThemeToggle.astro';
import { SITE } from '../data/site';
import { SHOW_CJ } from '../data/flags';
import { CONSENT_REQUIRED } from '../data/consent';
import { getLocale, getMessages, localePath, subPath, type LocaleCode } from '../i18n';
import { BLOG_UI, blogLangFor, blogPath } from '../data/blog';
import { DAY_ONE } from '../data/dayone';
import { FROM_CLAUDE } from '../data/fromclaude';
import { aiCopy } from '../data/productai';
import { MIGRATE } from '../data/migrate';
import { legalCopy } from '../data/legal';
import '../styles/trust.css';

interface Props { code: LocaleCode; page: string; langs?: LocaleCode[] }
const { code, page, langs } = Astro.props;
const info = getLocale(code);
const t = getMessages(code);
const f = t.foot;
const home = page === 'home' ? '' : localePath(info);
const sub = page === 'home' ? undefined : page;
// The blog and facts pages exist in English and Korean; other languages link to the English ones.
const bl = blogLangFor(code);
const bu = BLOG_UI[bl];
---
<footer class="site-foot">
  <div class="wrap">
    <div class="fb">
      <a class="brand" href={localePath(info)} aria-label="equipe"><Mark size={26} /><Wordmark height={19} /></a>
      <p>{f.tagline}</p>
      <p class="fsup"><a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a></p>
      {/* Infrastructure partner (startup credits), not a customer: Luxor Agent Cloud, formerly Tenki. Official logo from luxor.ai, shown monochrome. */}
      <p class="supported"><span>{t.footer.supportedBy}</span><a href="https://luxor.ai/?utm_source=equipe.im&utm_medium=referral" rel="noopener" title="Luxor Agent Cloud (formerly Tenki)"><img src="/brand/partners/luxor-agent-cloud.svg" alt="Luxor Agent Cloud" width="92" height="16" loading="lazy" decoding="async" /></a></p>
    </div>
    <nav class="fcols" aria-label="Footer">
      <div>
        <h2>{f.product}</h2>
        <ul>
          <li><a href={`${home}#how-it-works`}>{t.nav.how}</a></li>
          <li><a href={subPath(info, 'day-one')}>{(DAY_ONE[code] ?? DAY_ONE.en).nav}</a></li>
          <li><a href={subPath(info, 'from-claude')}>{(FROM_CLAUDE[code] ?? FROM_CLAUDE.en).nav}</a></li>
          <li><a href={subPath(info, 'features/ai')}>{aiCopy(code).nav}</a></li>
          <li><a href={subPath(info, 'migrate')}>{(MIGRATE[code] ?? MIGRATE.en).nav}</a></li>
          <li><a href={subPath(info, 'pricing')}>{t.nav.pricing}</a></li>
          <li><a href={`${home}#faq`}>{t.nav.faq}</a></li>
          <li><a href={subPath(info, 'app')}>{t.app.nav.get}</a></li>
          <li><a href={SITE.start} data-ph="signup_cta_click" data-ph-location="footer">{t.nav.cta}</a></li>
          <li><a href={SITE.login} data-ph="signin_click" data-ph-location="footer">{t.nav.signIn}</a></li>
        </ul>
      </div>
      <div>
        <h2>{f.company}</h2>
        <ul>
          <li><a href={subPath(info, 'about')}>{t.nav.about}</a></li>
          <li><a href={blogPath(bl)}>{bu.nav}</a></li>
          <li><a href={bl === 'en' ? '/facts/' : `/${bl}/facts/`}>{bu.facts}</a></li>
          <li><a href={subPath(info, 'changelog')}>{t.pages.changelog.h1}</a></li>
          {SHOW_CJ && <li><a href={subPath(info, 'customers/cj')}>CJ</a></li>}
          <li><a href={subPath(info, 'developers')} data-ph="developers_link_click" data-ph-location="footer">{t.nav.developers}</a></li>
          <li><a href={SITE.repo} data-ph="cta_github_click" data-ph-location="footer">{t.nav.github}</a></li>
        </ul>
      </div>
      <div>
        <h2>{f.legal}</h2>
        <ul>
          <li><a href={subPath(info, 'security')}>{t.nav.security}</a></li>
          <li><a href={subPath(info, 'privacy')}>{f.privacy}</a></li>
          <li><a href={subPath(info, 'terms')}>{legalCopy(code).ui.terms}</a></li>
          <li><a href={`${subPath(info, 'privacy')}#cookies`}>{f.noCookies}</a></li>
          {CONSENT_REQUIRED && <li><a href="#consent" data-consent-open>{f.cookieSettings}</a></li>}
          {CONSENT_REQUIRED && <li><a href="#consent" data-consent-open>{f.doNotSell}</a></li>}
          <li><a href={subPath(info, 'app/support')}>{f.support}</a></li>
        </ul>
      </div>
    </nav>
    <p class="fw rv" aria-hidden="true">equipe</p>
    <div class="fl">
      <div class="fl-t">
        <span>{f.engine}</span>
        <span>© Umbriles Inc. · {t.footer.built}</span>
      </div>
      <div class="fx">
        <LangMenu locale={code} label={t.ui.language} subpage={sub} langs={langs} placement="up" />
        <ThemeToggle l={{ system: t.ui.themeSystem, light: t.ui.themeLight, dark: t.ui.themeDark }} />
      </div>
    </div>
  </div>
</footer>
