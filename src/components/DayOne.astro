---
// "Day one, already done": what the person's AI team delivers from the first launch. Copy: src/data/dayone.ts (8 languages).
// Home (`page` false): a section with its own heading and a link to /day-one/. /day-one/ (`page` true): the same stage under the
// page's h1, plus every deliverable explained in full.
//
// The stage is a real product, not a drawing: Tidepool Ceramics, a demo shop an equipe team launched (tidepool.equipe.page).
// Its home page (2x) and privacy page (3x, full screen on the phone) are screenshots (light + dark, AVIF with WebP fallback), the share card is the site's own og.png, and the search result
// uses the site's real title and description. Around it, small cards show what came with the launch. The caption says the shop
// is a demo. Patterns studied on 21st.dev (device-mockup hero with floating UI cards, onboarding checklist that ticks off with a
// progress count); references: equipe-launch/ref/day-one-21st-v2.md. Plain Astro + CSS, no new dependencies.
// Motion is opt-in (see the script); the static state is the finished one.
import IPhone from './IPhone.astro';
import { DAY_ONE, FEATURED, LISTED, type DayOneKey } from '../data/dayone';
import { aiCopy } from '../data/productai';
import { getLocale, subPath, type LocaleCode } from '../i18n';
import '../styles/iphone.css';
import '../styles/dayone.css';

interface Props { code: LocaleCode; page?: boolean }
const { code, page = false } = Astro.props;
const info = getLocale(code);
const c = DAY_ONE[code] ?? DAY_ONE.en;
const v = c.vis;
const A = aiCopy(code);
const ListH = page ? 'h2' : 'h3';
const ItemH = page ? 'h3' : 'h4';
const total = LISTED.length;
const [pre, mid, post] = (() => {
  // "{n} of {total} done" in any word order: split around the two placeholders.
  const s = c.progress; const a = s.indexOf('{n}'); const b = s.indexOf('{total}');
  return a < b ? [s.slice(0, a), s.slice(a + 3, b), s.slice(b + 7)] : [s.slice(0, b), s.slice(b + 7, a), s.slice(a + 3)];
})();
const nFirst = c.progress.indexOf('{n}') < c.progress.indexOf('{total}');
const I: Record<DayOneKey, string> = {
  site: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM3.5 12h17M12 3c2.4 2.6 3.6 5.6 3.6 9s-1.2 6.4-3.6 9c-2.4-2.6-3.6-5.6-3.6-9S9.6 5.6 12 3z',
  found: 'M10.5 4a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13zM20 20l-4.8-4.8',
  share: 'M12 15V4M8 7.5L12 3.5l4 4M6 12v6.5A1.5 1.5 0 0 0 7.5 20h9a1.5 1.5 0 0 0 1.5-1.5V12',
  fast: 'M13.5 3L5.5 13.5h6l-1 7.5 8-10.5h-6l1-7.5z',
  legal: 'M7.5 3h6.5l5 5v11.5a1.5 1.5 0 0 1-1.5 1.5h-10A1.5 1.5 0 0 1 6 19.5v-15A1.5 1.5 0 0 1 7.5 3zM14 3v5h5M9 13h6M9 16.5h4',
  contact: 'M4.5 6h15a.5.5 0 0 1 .5.5v11a.5.5 0 0 1-.5.5h-15a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5zM4.5 7l7.5 6 7.5-6',
  marketing: 'M4 10v4h3l6 4.5v-13L7 10H4zM16.5 9a4 4 0 0 1 0 6M19 6.5a7.5 7.5 0 0 1 0 11',
  sources: 'M6 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM18 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM6 16V9a3 3 0 0 1 3-3h7M18 8v7a3 3 0 0 1-3 3H8',
  feedback: 'M5 4.5h14A1.5 1.5 0 0 1 20.5 6v9a1.5 1.5 0 0 1-1.5 1.5h-7.5L7 20v-3.5H5A1.5 1.5 0 0 1 3.5 15V6A1.5 1.5 0 0 1 5 4.5zM8 9h8M8 12.5h5',
  admin: 'M4.5 4.5h15v15h-15zM4.5 9.5h15M10 9.5v10',
  uptime: 'M3 12h4l2.5-6 5 12 2.5-6h4',
  compare: 'M12 3v18M4.5 5.5h15v13h-15zM8.5 10L6.5 12l2 2M15.5 10l2 2-2 2',
  weekly: 'M5 5.5h14v14H5zM5 9.5h14M9 3.5v4M15 3.5v4M8.5 16l2.5-2.5 2 1.5 3-3.5',
};
const check = 'M6 12.5l4 4 8-9';
const lock = 'M7.5 11V8.5a4.5 4.5 0 0 1 9 0V11M6 11h12v9H6z';
const R = 34; const C = 2 * Math.PI * R;
// The real product on the stage: its address, and the title and description its pages carry.
const host = 'tidepool.equipe.page';
const siteTitle = 'Tidepool Ceramics: small-batch stoneware from Lisbon';
// Screenshots (light + dark): the home page at 2x in the browser window, the privacy page full-screen at 3x (1179 x 2556) on the phone.
const themes = ['light', 'dark'] as const;
const siteSizes = '(min-width: 1248px) 672px, (min-width: 980px) 56vw, 92vw';
const siteDesc = 'Hand-thrown mugs, bowls, vases and planters made in tiny batches in Lisbon. Send a request and Mara confirms by hand.';
---
<section class={`d1${page ? ' d1-page' : ''}`} id={page ? undefined : 'day-one'} data-d1>
  <div class="wrap">
    {!page && (
      <div class="head d1-rv">
        <p class="kicker">{c.kicker}</p>
        <h2>{c.title}</h2>
        <p class="sub">{c.sub}</p>
      </div>
    )}

    <figure class="d1-stage d1-rv" data-d1-stage>
      <div class="st-in">
        <div class="st-f st-site" style="--k:0">
          <span class="st-tag"><i aria-hidden="true"><svg viewBox="0 0 24 24"><path d={check} /></svg></i>{c.items.site.title}</span>
          <div class="st-win" aria-hidden="true">
            <div class="st-bar"><span class="st-dots"><b></b><b></b><b></b></span><span class="st-url"><svg viewBox="0 0 24 24"><path d={lock} /></svg>{host}</span><span class="st-live"><i></i>{v.live}</span></div>
            <div class="st-shot">
              {themes.map((th) => (
                <picture class={th === 'light' ? 'th-l' : 'th-d'}>
                  <source type="image/avif" srcset={`/day-one/tidepool-home-${th}-1440.avif 1440w, /day-one/tidepool-home-${th}-2880.avif 2880w`} sizes={siteSizes} />
                  <img src={`/day-one/tidepool-home-${th}-1440.webp`} srcset={`/day-one/tidepool-home-${th}-1440.webp 1440w, /day-one/tidepool-home-${th}-2880.webp 2880w`} sizes={siteSizes} width="2880" height="1800" alt="" loading="lazy" decoding="async" />
                </picture>
              ))}
            </div>
          </div>
        </div>

        <div class="st-f st-serp" style="--k:1">
          <span class="st-tag"><i aria-hidden="true"><svg viewBox="0 0 24 24"><path d={check} /></svg></i>{c.items.found.title}</span>
          <div class="st-card st-res" aria-hidden="true">
            <span class="st-g"><span class="st-fav">T</span><span class="st-gs"><b>Tidepool Ceramics</b><span>{host}</span></span></span>
            <b class="st-rt" lang="en">{siteTitle}</b>
            <p class="st-rd" lang="en">{siteDesc}</p>
          </div>
        </div>

        <div class="st-f st-ai" style="--k:5" aria-hidden="true">
          <p class="st-q">{v.aiQ}</p>
          <div class="st-card st-a">
            <span class="st-spark"><svg viewBox="0 0 24 24"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3z" /></svg></span>
            <div><p>{v.aiA}</p><span class="st-src">{v.source} · {host}</span></div>
          </div>
        </div>

        <div class="st-f st-phone" style="--k:2">
          <div class="st-ph" aria-hidden="true">
            <IPhone w={200} full url={host}>
              {themes.map((th) => (
                <picture class={th === 'light' ? 'th-l' : 'th-d'}>
                  <source type="image/avif" srcset={`/day-one/tidepool-privacy-${th}-600.avif 600w, /day-one/tidepool-privacy-${th}-1179.avif 1179w`} sizes="180px" />
                  <img src={`/day-one/tidepool-privacy-${th}-600.webp`} srcset={`/day-one/tidepool-privacy-${th}-600.webp 600w, /day-one/tidepool-privacy-${th}-1179.webp 1179w`} sizes="180px" width="1179" height="2556" alt="" loading="lazy" decoding="async" />
                </picture>
              ))}
            </IPhone>
          </div>
          <span class="st-tag"><i aria-hidden="true"><svg viewBox="0 0 24 24"><path d={check} /></svg></i>{c.items.legal.title}</span>
        </div>

        <div class="st-f st-speed" style="--k:3">
          <span class="st-tag"><i aria-hidden="true"><svg viewBox="0 0 24 24"><path d={check} /></svg></i>{c.items.fast.title}</span>
          <div class="st-card st-spd" aria-hidden="true">
            <svg class="st-ring" viewBox="0 0 80 80" style={`--c:${C.toFixed(1)}`}>
              <circle class="t" cx="40" cy="40" r={R} />
              <circle class="v" cx="40" cy="40" r={R} stroke-dasharray={C.toFixed(1)} stroke-dashoffset={(C * 0.05).toFixed(1)} />
              <text x="40" y="46.5" text-anchor="middle">95+</text>
            </svg>
            <span class="st-sx"><b>{v.speed}</b><span>{v.everyRelease}</span></span>
          </div>
        </div>

        <div class="st-f st-share" style="--k:4">
          <span class="st-tag"><i aria-hidden="true"><svg viewBox="0 0 24 24"><path d={check} /></svg></i>{c.items.share.title}</span>
          <div class="st-card st-sh" aria-hidden="true">
            <img src="/day-one/tidepool-share.webp" width="600" height="315" alt="" loading="lazy" decoding="async" />
            <div class="st-shm"><b lang="en">{siteTitle}</b><span>{host}</span></div>
            <div class="st-shr">
              <span class="st-plats">
                <i><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" /></svg></i>
                <i><svg viewBox="0 0 24 24"><path d="M7 10v7M7 7v.01M11 17v-7M11 13a3 3 0 0 1 6 0v4" /></svg></i>
                <i><svg viewBox="0 0 24 24"><rect x="5" y="5" width="14" height="14" rx="4" /><circle cx="12" cy="12" r="3.2" /></svg></i>
              </span>
              <span class="st-btn">{v.shareAll}</span>
            </div>
          </div>
        </div>
      </div>
      <figcaption class="st-cap"><a href={`https://${host}/`} target="_blank" rel="noopener" data-ph="day_one_stage_open" data-ph-location={page ? 'day_one' : 'home'}>{v.caption}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 16L16 8M9.5 8H16v6.5" /></svg></a></figcaption>
    </figure>

    {page && (
      <ul class="d1-legend" role="list">
        {FEATURED.map((k, i) => (
          <li class="d1-rv" style={`--i:${i}`}>
            <span class="d1-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={I[k]} /></svg></span>
            <h2>{c.items[k].title}</h2>
            <p>{c.items[k].text}</p>
          </li>
        ))}
      </ul>
    )}

    <div class={`d1-list d1-rv${page ? ' full' : ''}`} data-d1-list>
      <div class="d1-lh">
        <ListH>{c.listTitle}</ListH>
        <p class="d1-prog"><span class="d1-pb" aria-hidden="true"><i data-d1-bar></i></span><span class="d1-pt">{pre}{nFirst ? <><b data-d1-count>{total}</b>{mid}{total}</> : <>{total}{mid}<b data-d1-count>{total}</b></>}{post}</span></p>
      </div>
      <ol>
        {LISTED.map((k) => (
          <li>
            <span class="d1-ck" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={check} /></svg></span>
            <div>
              <ItemH><svg class="d1-li" viewBox="0 0 24 24" aria-hidden="true"><path d={I[k]} /></svg>{c.items[k].title}</ItemH>
              <p class={page ? undefined : 'sr-only'}>{c.items[k].text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <div class="d1-foot d1-rv">
      <p class="d1-ok"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={lock} /></svg>{c.approval}</p>
      {!page && <a class="d1-more" href={subPath(info, 'day-one')} data-ph="day_one_link_click" data-ph-location="home">{c.more}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>}
    </div>

    <a class="d1-ai d1-rv" href={subPath(info, 'features/ai')} data-ph="ai_features_click" data-ph-location={page ? 'day_one' : 'home'}>
      <span class="d1-ai-i" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3zM18.5 15.5l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7.7-1.8z" /></svg></span>
      <span class="d1-ai-t"><b>{A.home.title}</b><span>{A.home.text}</span></span>
      <span class="d1-ai-l">{A.home.link}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
    </a>
  </div>
</section>

<script>
  // Motion, only when the visitor allows it: blocks fade up as they arrive, the stage's cards settle in one after another,
  // and the checklist ticks off one item at a time while its counter climbs. Anything already on screen at load is left as it
  // is (no flash). Without this script, or with reduced motion, everything shows its finished state.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    document.querySelectorAll<HTMLElement>('[data-d1]').forEach((sec) => {
      const vh = innerHeight;
      const seen = (el: Element, f = 1) => el.getBoundingClientRect().top < vh * f;
      const rvs = [...sec.querySelectorAll<HTMLElement>('.d1-rv')];
      const list = sec.querySelector<HTMLElement>('[data-d1-list]')!;
      const items = [...list.querySelectorAll<HTMLElement>('li')];
      const count = list.querySelector<HTMLElement>('[data-d1-count]')!;
      const bar = list.querySelector<HTMLElement>('[data-d1-bar]')!;
      rvs.forEach((el) => { if (seen(el)) el.classList.add('in'); });
      const ticked = seen(list, 0.8);
      items.forEach((li) => li.classList.toggle('on', ticked));
      if (!ticked) { count.textContent = '0'; bar.style.transform = 'scaleX(0)'; }
      sec.classList.add('d1-mo');
      const reveal = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); reveal.unobserve(e.target); } }), { rootMargin: '0px 0px -10% 0px' });
      rvs.forEach((el) => { if (!el.classList.contains('in')) reveal.observe(el); });
      const done = () => { rvs.forEach((el) => el.classList.add('in')); items.forEach((li) => li.classList.add('on')); count.textContent = String(items.length); bar.style.transform = ''; };
      addEventListener('beforeprint', done);
      if (ticked) return;
      const tick = new IntersectionObserver((es) => {
        if (!es.some((e) => e.isIntersecting)) return;
        tick.disconnect();
        items.forEach((li, i) => setTimeout(() => {
          li.classList.add('on');
          count.textContent = String(i + 1);
          bar.style.transform = `scaleX(${(i + 1) / items.length})`;
        }, 300 + i * 160));
      }, { threshold: 0.35 });
      tick.observe(list);
    });
  }
</script>
