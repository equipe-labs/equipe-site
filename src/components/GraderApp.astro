---
// The website grader: the address box, the steps while it runs, and the report (drawn here from the platform's JSON).
// mode 'run' (/grader/): the box is the hero; after a check the address bar becomes the shared link /grader/r/<id>/.
// mode 'shared' (/grader/r/<id>/): the report loads first, the box follows ("check your own site").
// Events: PostHog grader_run / grader_result / grader_error; the own funnel tool_run and tool_result, click:<data-ph>.
import { graderCopy, graderFixHref, GRADER_API, AREAS, CHECKS } from '../data/grader';
import { aivisCopy } from '../data/aivis';
import { getLocale, subPath, type LocaleCode } from '../i18n';

interface Props { code: LocaleCode; mode: 'run' | 'shared' }
const { code, mode } = Astro.props;
const info = getLocale(code);
const c = graderCopy(code);
const F = c.form;
const arrow = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>';
const data = {
  api: GRADER_API, lang: info.lang, mode,
  base: subPath(info, 'grader'), aivis: subPath(info, 'ai-visibility'),
  fixHref: graderFixHref('__SITE__', '__PLACE__'),
  areas: AREAS, checks: CHECKS,
  c: { result: c.result, areas: c.areas, fixes: c.fixes, checks: c.checks, form: c.form, progress: c.progress },
};
---
<div class={`tl-flow tl-flow-${mode}`}>
{mode === 'shared' && <section class="tl-shared-h"><div class="wrap"><h1>{c.share.pageTitle}</h1></div></section>}
<section class={mode === 'run' ? 'tl-hero' : 'tl-hero tl-again'} data-g-hero><div class="wrap">
  {mode === 'run' ? <h1>{c.page.h1}</h1> : <h2 class="tl-again-h">{c.page.h1}</h2>}
  <p class="tl-lead">{c.page.lead}</p>
  <form class="tl-form" novalidate data-g-form>
    <label class="sr-only" for={`g-url-${mode}`}>{F.label}</label>
    <div class="tl-url">
      <input id={`g-url-${mode}`} name="url" type="text" inputmode="url" autocomplete="url" autocapitalize="off" spellcheck="false" placeholder={F.placeholder} maxlength="300" required />
      <button class="btn primary" type="submit" data-ph="grader_submit" data-ph-location={mode}><span data-label>{F.button}</span><Fragment set:html={arrow} /></button>
    </div>
    <p class="tl-err" role="alert" hidden data-g-err></p>
    <p class="tl-note">{F.note}</p>
  </form>
</div></section>

<section class="tl-run" hidden data-g-run aria-live="polite">
  <div class="wrap">
    <ol class="tl-steps">
      {c.progress.map((s) => <li><span class="d"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span><span>{s}</span></li>)}
    </ol>
    <p>{c.progressNote}</p>
  </div>
</section>

<section class="tl-report" hidden data-g-report tabindex="-1"><div class="wrap" data-g-out></div></section>
</div>

<script type="application/json" data-g-data set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />

<script>
  type Json = Record<string, any>;
  const w = window as unknown as { eqTrack?: (n: string, p?: Json) => void; eqOwn?: (k: string, t: string, f?: string) => void };
  const track = (n: string, p?: Json) => w.eqTrack?.(n, p);
  const own = (k: string, t: string, f?: string) => w.eqOwn?.(k, t, f);
  const ft = (s: string) => { try { (window as unknown as { eqFeat?: (s: string) => void }).eqFeat?.(s); } catch { /* counting never breaks the page */ } };
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch]!);
  const fill = (s: string, v: Json) => s.replace(/\{(\w+)\}/g, (_, k) => (v[k] == null ? '' : String(v[k])));
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const ic = {
    check: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>',
    x: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7l10 10M17 7 7 17"/></svg>',
    dash: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 12h10"/></svg>',
    arrow: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>',
    copy: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>',
    chev: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>',
  };

  const el = document.querySelector<HTMLScriptElement>('[data-g-data]');
  const D = (el ? JSON.parse(el.textContent || '{}') : null) as Json;
  const form = document.querySelector<HTMLFormElement>('[data-g-form]')!;
  const run = document.querySelector<HTMLElement>('[data-g-run]')!;
  const rep = document.querySelector<HTMLElement>('[data-g-report]')!;
  const out = document.querySelector<HTMLElement>('[data-g-out]')!;
  if (D && form && run && rep && out) {
    const C = D.c, R = C.result;
    const input = form.querySelector<HTMLInputElement>('input')!;
    const btn = form.querySelector<HTMLButtonElement>('button')!;
    const err = form.querySelector<HTMLElement>('[data-g-err]')!;
    const steps = [...run.querySelectorAll<HTMLLIElement>('.tl-steps li')];
    let timer = 0;

    const say = (m: string) => { err.textContent = m; err.hidden = !m; if (m) { form.classList.remove('shake'); void form.offsetWidth; form.classList.add('shake'); } };
    const urlish = (v: string) => /^(https?:\/\/)?[\w-]+(\.[\w-]+)+(:\d+)?(\/\S*)?$/i.test(v.trim()) && !/\s/.test(v.trim());
    const stepTo = (i: number) => steps.forEach((s, j) => { s.classList.toggle('done', j < i); s.classList.toggle('now', j === i); });
    const startSteps = () => {
      run.hidden = false; stepTo(0);
      let i = 0;
      // About 30 seconds in all; the last step waits for the answer.
      const at = [2500, 9000, 6000, 7000];
      const next = () => { if (i >= steps.length - 1) return; i++; stepTo(i); timer = window.setTimeout(next, at[i] || 6000); };
      timer = window.setTimeout(next, at[0]);
    };
    const stopSteps = () => { clearTimeout(timer); stepTo(steps.length); setTimeout(() => { run.hidden = true; }, reduce ? 0 : 350); };

    const dateOf = (t: number) => new Date(t * 1000).toLocaleDateString(D.lang, { year: 'numeric', month: 'long', day: 'numeric' });
    const band = (s: number) => (s >= 90 ? R.bands.great : s >= 70 ? R.bands.good : s >= 50 ? R.bands.fair : R.bands.poor);
    const secs = (ms: number | null) => (ms == null ? '–' : (Math.round(ms / 100) / 10).toLocaleString(D.lang));
    const kb = (b: number | null) => (b == null ? '–' : b >= 1e6 ? `${(Math.round(b / 1e5) / 10).toLocaleString(D.lang)} MB` : `${Math.round(b / 1024)} KB`);
    const shareUrl = (id: string) => new URL(`${D.base}r/${id}/`, location.origin).href;

    function fixText(f: Json) {
      const t = C.fixes[f.key];
      if (!t) return null;
      const v = { n: f.n, of: f.of, score: f.score, sec: secs(f.lcp_ms), words: f.words, bots: (f.bots || []).join(', ') };
      return { title: fill(t.title, v), text: fill(t.text, v), area: C.areas[f.area]?.name || '' };
    }

    function draw(g: Json) {
      const score = typeof g.score === 'number' ? g.score : null;
      const site = g.final_url || g.url;
      const r = 70, circ = 2 * Math.PI * r, track = circ * 0.94;
      const areas = (D.areas as string[]).map((k) => {
        const v = g.areas?.[k];
        return `<li class="tl-area tl-in${typeof v === 'number' && v < 50 ? ' low' : ''}"><span class="an">${esc(C.areas[k].name)}</span>${typeof v === 'number' ? `<span class="as">${v}<small>/100</small></span><span class="tl-bar"><i style="--w:${v}%"></i></span>` : `<span class="as na">${esc(R.notMeasured)}</span>`}<span class="aw">${esc(C.areas[k].what)}</span></li>`;
      }).join('');
      const fixes = (g.fixes || []).map(fixText).filter(Boolean).slice(0, 5) as Json[];
      const fixesHtml = fixes.length ? `<ol class="tl-fixes">${fixes.map((f, i) => `<li class="tl-in" style="--d:${i * 70}ms"><span class="n">${i + 1}</span><div><h4>${esc(f.title)}</h4><p>${esc(f.text)}</p><span class="tl-tag">${esc(f.area)}</span></div></li>`).join('')}</ol>` : `<p class="tl-empty">${esc(R.noFixes)}</p>`;
      const facts = g.facts || {};
      const factRow = [
        facts.lcp_ms != null ? `<li>${esc(R.facts.loads)} <b>${secs(facts.lcp_ms)} s</b></li>` : '',
        facts.bytes != null ? `<li>${esc(R.facts.weight)} <b>${kb(facts.bytes)}</b></li>` : '',
        facts.words != null ? `<li>${esc(R.facts.words)} <b>${Number(facts.words).toLocaleString(D.lang)}</b></li>` : '',
      ].join('');
      const bots = (g.crawlers || []).map((b: Json) => `<li><span><b>${esc(b.name)}</b><small>${esc(b.who)}</small></span>${b.allowed ? `<span class="tl-pill ok">${ic.check}${esc(R.crawlerOk)}</span>` : `<span class="tl-pill no">${ic.x}${esc(b.firewall ? R.crawlerFirewall : R.crawlerRobots)}</span>`}</li>`).join('');
      const checks = (D.areas as string[]).map((k) => `<div><h4>${esc(C.areas[k].name)}</h4><ul>${(D.checks[k] as string[]).map((ck) => {
        const v = g.checks?.[ck];
        const cls = v === true ? 'p' : v === false ? 'f' : 'u';
        return `<li class="${cls}"><i title="${esc(v === true ? R.pass : v === false ? R.fail : R.unknown)}">${v === true ? ic.check : v === false ? ic.x : ic.dash}</i><span>${esc(C.checks[ck])}<span class="sr-only"> (${esc(v === true ? R.pass : v === false ? R.fail : R.unknown)})</span></span></li>`;
      }).join('')}</ul></div>`).join('');
      const fix = String(D.fixHref).replace('__SITE__', encodeURIComponent(site)).replace('__PLACE__', D.mode === 'shared' ? 'shared' : 'result');
      const link = g.id ? shareUrl(g.id) : '';
      out.innerHTML = `<div class="tl-rep">
        <div class="tl-card tl-top tl-in">
          <div class="tl-g" role="img" aria-label="${esc(R.overall)}: ${score ?? '–'}/100"><svg viewBox="0 0 160 160" aria-hidden="true"><circle class="tr" cx="80" cy="80" r="${r}" stroke-dasharray="${track} ${circ}"/><circle class="val" cx="80" cy="80" r="${r}" stroke-dasharray="0 ${circ}" data-to="${score == null ? 0 : (track * score) / 100}" data-c="${circ}"/></svg><div class="num"><b data-count="${score ?? ''}">${score == null ? '–' : reduce ? score : 0}</b><span>${esc(R.overall)}</span></div></div>
          <div><p class="tl-host">${esc(fill(R.heading, { host: g.host }))}</p><h2>${esc(score == null ? R.notMeasured : band(score))}</h2><p class="tl-date">${esc(fill(R.checked, { date: dateOf(g.created_at) }))}</p>${factRow ? `<ul class="tl-facts">${factRow}</ul>` : ''}</div>
        </div>
        <div><h3 class="tl-h">${esc(R.areasTitle)}</h3><ul class="tl-areas">${areas}</ul></div>
        <div><h3 class="tl-h">${esc(R.fixesTitle)}</h3><p class="tl-sub">${esc(R.fixesSub)}</p>${fixesHtml}</div>
        <div class="tl-cta tl-in"><h3>${esc(R.cta.title)}</h3><p>${esc(R.cta.text)}</p><a class="btn primary lg" href="${esc(fix)}" data-ph="grader_fix_click" data-ph-location="${D.mode === 'shared' ? 'shared' : 'result'}">${esc(R.cta.button)}${ic.arrow}</a><small>${esc(R.cta.note)}</small></div>
        ${link ? `<div class="tl-share tl-in"><label for="g-share">${esc(R.share.label)}</label><div class="tl-share-row"><input id="g-share" readonly value="${esc(link)}"><button type="button" class="btn ghost" data-g-copy data-ph="grader_share_copy" data-ph-location="${D.mode}">${ic.copy}<span>${esc(R.share.copy)}</span></button><a class="btn ghost" href="${esc(D.base)}" data-g-again data-ph="grader_again" data-ph-location="${D.mode}">${esc(R.share.again)}</a></div></div>` : ''}
        <div><h3 class="tl-h">${esc(R.crawlersTitle)}</h3><ul class="tl-bots">${bots}</ul></div>
        <details class="tl-all"><summary>${esc(R.allChecksTitle)}</summary><div class="tl-all-b">${checks}</div></details>
        <div class="tl-card tl-cross"><div><h3>${esc(R.aivis.title)}</h3><p>${esc(R.aivis.text)}</p></div><a class="btn ghost" href="${esc(D.aivis)}?url=${encodeURIComponent(site)}" data-ph="aivis_link_click" data-ph-location="grader">${esc(R.aivis.link)}${ic.arrow}</a></div>
      </div>`;
      rep.hidden = false;
      animate();
      const copyBtn = out.querySelector<HTMLButtonElement>('[data-g-copy]');
      copyBtn?.addEventListener('click', async () => {
        const f = out.querySelector<HTMLInputElement>('#g-share')!;
        let ok = false;
        try { await navigator.clipboard.writeText(f.value); ok = true; } catch { f.select(); try { ok = document.execCommand('copy'); } catch { ok = false; } }
        if (!ok) return;
        const lab = copyBtn.querySelector('span')!;
        copyBtn.classList.add('done'); lab.textContent = R.share.copied;
        setTimeout(() => { copyBtn.classList.remove('done'); lab.textContent = R.share.copy; }, 2000);
      });
    }

    function animate() {
      const root = document.documentElement;
      const items = [...out.querySelectorAll<HTMLElement>('.tl-in')];
      if (reduce || !root.classList.contains('mo')) items.forEach((x) => x.classList.add('on'));
      else items.forEach((x, i) => { x.style.setProperty('--d', x.style.getPropertyValue('--d') || `${Math.min(i, 8) * 60}ms`); requestAnimationFrame(() => requestAnimationFrame(() => x.classList.add('on'))); });
      const ring = out.querySelector<SVGCircleElement>('circle.val');
      const num = out.querySelector<HTMLElement>('[data-count]');
      const to = Number(ring?.dataset.to || 0), circ = Number(ring?.dataset.c || 0), target = Number(num?.dataset.count || 0);
      if (!ring || !num || !num.dataset.count) return;
      if (reduce) { ring.style.strokeDasharray = `${to} ${circ}`; return; }
      requestAnimationFrame(() => requestAnimationFrame(() => { ring.style.strokeDasharray = `${to} ${circ}`; }));
      const t0 = performance.now(), dur = 1200;
      const tick = (t: number) => { const p = Math.min(1, (t - t0) / dur), e = 1 - Math.pow(1 - p, 3); num.textContent = String(Math.round(target * e)); if (p < 1) requestAnimationFrame(tick); };
      requestAnimationFrame(tick);
    }

    async function check(raw: string) {
      say('');
      if (!urlish(raw)) { say(C.form.errUrl); input.setAttribute('aria-invalid', 'true'); input.focus(); return; }
      input.removeAttribute('aria-invalid');
      btn.disabled = true; btn.setAttribute('aria-busy', 'true');
      rep.hidden = true;
      own('fn', 'tool_run'); ft('start'); track('grader_run', { location: D.mode });
      startSteps();
      run.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
      let res: Response | null = null, g: Json | null = null;
      try {
        res = await fetch(D.api, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ url: raw.trim() }), signal: AbortSignal.timeout(150000) });
        g = await res.json().catch(() => null);
      } catch { /* below */ }
      stopSteps();
      btn.disabled = false; btn.removeAttribute('aria-busy');
      if (!res || !res.ok || !g || !g.id) {
        const e = g?.error;
        const m = e === 'bad_url' ? C.form.errUrl : e === 'unreachable' ? C.form.errUnreachable : e === 'rate' ? C.form.errRate : e === 'busy' ? C.form.errBusy : C.form.errFailed;
        ft('error'); track('grader_error', { error: e || (res ? `http_${res.status}` : 'network') });
        say(m); return;
      }
      own('fn', 'tool_result'); ft('done'); own('ev', 'grader_score', g.score == null ? 'none' : g.score >= 90 ? '90-100' : g.score >= 70 ? '70-89' : g.score >= 50 ? '50-69' : '0-49');
      track('grader_result', { score: g.score, cached: !!g.cached, fixes: (g.fixes || []).length });
      draw(g);
      try { history.replaceState(null, '', `${D.base}r/${g.id}/`); } catch { /* fine */ }
      setTimeout(() => { rep.focus({ preventScroll: true }); rep.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' }); }, reduce ? 0 : 380);
    }

    form.addEventListener('submit', (e) => { e.preventDefault(); check(input.value); });
    input.addEventListener('input', () => { if (!err.hidden) say(''); input.removeAttribute('aria-invalid'); });
    // "Check another site": back to the empty box on this page.
    out.addEventListener('click', (e) => {
      const a = (e.target as Element).closest('[data-g-again]');
      if (!a || D.mode === 'shared') return;
      e.preventDefault(); rep.hidden = true; input.value = ''; history.replaceState(null, '', D.base);
      form.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' }); setTimeout(() => input.focus(), reduce ? 0 : 300);
    });

    const q = new URLSearchParams(location.search);
    if (D.mode === 'shared') {
      // /grader/r/<id>/ (equipe.im's rewrite serves this page for every id): load the stored report.
      const id = (location.pathname.match(/\/grader\/r\/([A-Za-z0-9]{6,16})\/?$/) || [])[1];
      if (!id) { out.innerHTML = `<p class="tl-empty">${esc(R.notFound)}</p>`; rep.hidden = false; }
      else {
        out.innerHTML = `<p class="tl-empty">${esc(R.loading)}</p>`; rep.hidden = false;
        fetch(`${D.api}/${id}`).then((r) => (r.ok ? r.json() : null)).then((g) => {
          if (!g) { out.innerHTML = `<p class="tl-empty">${esc(R.notFound)}</p>`; return; }
          ft('shared_view'); track('grader_shared_view', { score: g.score }); draw(g);
        }).catch(() => { out.innerHTML = `<p class="tl-empty">${esc(R.notFound)}</p>`; });
      }
    } else if (q.get('url')) {
      input.value = q.get('url')!.slice(0, 300);
    }
  }
</script>
