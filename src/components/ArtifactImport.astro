---
// The "From Claude" paste box: a Claude artifact's code (pasted, or read from a dropped file in the browser) and/or its
// published link go to app.equipe.im/import, which builds it and puts it live.
// Contract with the app (decided there, do not change one side alone):
// - code present → a plain HTML form POST (application/x-www-form-urlencoded, no fetch, no CORS) to /import with
//   `code`, `url` (when given), `filename` (when a file was dropped), `lang` (page locale) and utm_source/medium/campaign
//   passed through from this page's URL;
// - only a link → GET /import?url=<link>&lang=<locale> (+ the same utm fields). The link is checked here first:
//   https://claude.ai/ with a path under /public/artifacts/, /share/ or /artifacts/.
// Without JavaScript the form still posts `code`, `url` and `lang`. The file picker, drag and drop, the checks and the
// link-only GET need the script.
// `compact`: the home page version (shorter box, no long note).
import { FROM_CLAUDE, IMPORT_EXTS, IMPORT_MAX_BYTES, IMPORT_URL } from '../data/fromclaude';
import { getLocale, type LocaleCode } from '../i18n';
import '../styles/fromclaude.css';

interface Props { code: LocaleCode; id: string; location: string; compact?: boolean }
const { code, id, location, compact = false } = Astro.props;
const info = getLocale(code);
const b = (FROM_CLAUDE[code] ?? FROM_CLAUDE.en).box;
const free = b.free.split(' · ');
const words = {
  lines: b.lines, remove: b.remove, sending: b.sending,
  errEmpty: b.errEmpty, errLink: b.errLink, errType: b.errType, errSize: b.errSize, errRead: b.errRead, moved: b.moved,
  exts: IMPORT_EXTS, max: IMPORT_MAX_BYTES, url: IMPORT_URL, lang: info.lang,
};
---
<form class={`aim${compact ? ' compact' : ''}`} action={IMPORT_URL} method="post" enctype="application/x-www-form-urlencoded" accept-charset="UTF-8" novalidate data-aim data-location={location} data-words={JSON.stringify(words)}>
  <div class="aim-box" data-drop>
    <div class="aim-top">
      <label class="aim-l" for={`${id}-code`}>{b.codeLabel}</label>
      <span class="aim-count" data-count></span>
    </div>
    <textarea id={`${id}-code`} name="code" rows={compact ? 4 : 8} wrap="off" spellcheck="false" autocapitalize="off" autocomplete="off" autocorrect="off" placeholder={b.codePh} data-code></textarea>
    <div class="aim-bar">
      <span class="aim-file" data-file-row>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15V3" /><path d="m7 8 5-5 5 5" /><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /></svg>
        <span class="aim-ft"><span class="aim-dl">{b.dropLead}</span> <button type="button" class="aim-pick" data-pick>{b.choose}</button></span>
        <input type="file" accept={IMPORT_EXTS.join(',')} class="aim-fin" tabindex="-1" aria-hidden="true" data-file />
      </span>
      <span class="aim-chip" data-chip hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" /><path d="M14 2v4a2 2 0 0 0 2 2h4" /></svg>
        <b data-chip-name></b><small data-chip-size></small>
        <button type="button" aria-label={b.remove} title={b.remove} data-chip-x><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg></button>
      </span>
      <span class="aim-types" aria-hidden="true">{IMPORT_EXTS.join(' ')}</span>
    </div>
    <div class="aim-over" aria-hidden="true"><span><svg viewBox="0 0 24 24"><path d="M12 15V3" /><path d="m7 8 5-5 5 5" /><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /></svg>{b.dropHere}</span></div>
  </div>

  <div class="aim-link">
    <label for={`${id}-url`}>{b.linkLabel} <span class="aim-opt">{b.optional}</span></label>
    <div class="aim-lrow">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" /><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" /></svg>
      <input id={`${id}-url`} type="url" name="url" inputmode="url" autocomplete="off" spellcheck="false" autocapitalize="off" placeholder={b.linkPh} data-url />
    </div>
  </div>

  <input type="hidden" name="filename" value="" disabled data-filename />
  <input type="hidden" name="lang" value={info.lang} />

  <div class="aim-go">
    <button class="btn primary lg aim-submit" type="submit" data-submit>
      <span class="aim-sl">{b.submit}</span>
      <span class="aim-spin" aria-hidden="true"></span>
      <svg class="aim-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </button>
    <span class="aim-free">{free.map((f) => <span>{f}</span>)}</span>
  </div>
  <p class="aim-msg" role="status" aria-live="polite" data-msg hidden></p>
  {!compact && <p class="aim-note">{b.note}</p>}
</form>

<script>
  type Words = { lines: string; remove: string; sending: string; errEmpty: string; errLink: string; errType: string; errSize: string; errRead: string; moved: string; exts: string[]; max: number; url: string; lang: string };
  const track = (n: string, p?: Record<string, unknown>) => (window as unknown as { eqTrack?: (n: string, p?: unknown) => void }).eqTrack?.(n, p);
  const UTM = ['utm_source', 'utm_medium', 'utm_campaign'] as const;

  /** A Claude artifact link, normalised (https, no hash), or '' when it is not one. */
  const artifactLink = (raw: string) => {
    let v = raw.trim();
    if (!v || /\s/.test(v)) return '';
    if (/^(www\.)?claude\.ai\//i.test(v)) v = 'https://' + v;
    try {
      const u = new URL(v);
      if (u.protocol !== 'https:' || !/^(www\.)?claude\.ai$/i.test(u.hostname)) return '';
      if (!/^\/(public\/artifacts|share|artifacts)\/[^/]/.test(u.pathname)) return '';
      u.hash = '';
      return u.toString();
    } catch { return ''; }
  };
  const kb = (n: number) => (n < 1024 ? `${n} B` : `${Math.max(1, Math.round(n / 1024))} KB`);
  const bytes = (s: string) => new Blob([s]).size;

  // Dropping a file anywhere else on the page must not navigate away from it.
  if (document.querySelector('[data-aim]')) {
    const hasFiles = (e: DragEvent) => !!e.dataTransfer && [...e.dataTransfer.types].includes('Files');
    addEventListener('dragover', (e) => { if (hasFiles(e) && !(e.target as Element | null)?.closest?.('[data-drop]')) e.preventDefault(); });
    addEventListener('drop', (e) => { if (hasFiles(e) && !(e.target as Element | null)?.closest?.('[data-drop]')) e.preventDefault(); });
  }

  document.querySelectorAll<HTMLFormElement>('[data-aim]').forEach((form) => {
    const W: Words = JSON.parse(form.dataset.words || '{}');
    const loc = form.dataset.location || '';
    const ta = form.querySelector<HTMLTextAreaElement>('[data-code]')!;
    const urlIn = form.querySelector<HTMLInputElement>('[data-url]')!;
    const fileIn = form.querySelector<HTMLInputElement>('[data-file]')!;
    const fname = form.querySelector<HTMLInputElement>('[data-filename]')!;
    const box = form.querySelector<HTMLElement>('[data-drop]')!;
    const count = form.querySelector<HTMLElement>('[data-count]')!;
    const row = form.querySelector<HTMLElement>('[data-file-row]')!;
    const chip = form.querySelector<HTMLElement>('[data-chip]')!;
    const msg = form.querySelector<HTMLElement>('[data-msg]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const label = submit.querySelector<HTMLElement>('.aim-sl')!;
    const idle = label.textContent || '';
    const motion = !matchMedia('(prefers-reduced-motion: reduce)').matches;
    form.classList.add('ready');

    const say = (text: string, kind: 'err' | 'info' = 'err') => {
      msg.textContent = text; msg.hidden = !text; msg.dataset.kind = kind;
      if (text && motion) { msg.classList.remove('pop'); void msg.offsetWidth; msg.classList.add('pop'); }
    };
    const nudge = (el: HTMLElement) => { if (!motion) return; el.classList.remove('nudge'); void el.offsetWidth; el.classList.add('nudge'); };
    const refresh = () => {
      const v = ta.value;
      const n = v ? v.replace(/\n$/, '').split('\n').length : 0;
      count.textContent = v.trim() ? W.lines.replace('{n}', n.toLocaleString(document.documentElement.lang || undefined)) : '';
      form.classList.toggle('has-code', !!v.trim());
    };
    const setFile = (name: string, size: number) => {
      fname.value = name; fname.disabled = !name;
      chip.hidden = !name; row.hidden = !!name;
      if (name) { chip.querySelector('[data-chip-name]')!.textContent = name; chip.querySelector('[data-chip-size]')!.textContent = kb(size); }
    };

    // A pasted link in the code box goes to the link field.
    const linkInCode = () => {
      const link = artifactLink(ta.value);
      if (!link) return;
      ta.value = ''; urlIn.value = link; refresh(); setFile('', 0);
      say(W.moved, 'info');
      urlIn.focus({ preventScroll: true });
    };
    ta.addEventListener('input', () => { refresh(); if (msg.dataset.kind === 'err') say(''); });
    ta.addEventListener('paste', () => setTimeout(linkInCode, 0));
    // Typing over a dropped file's text keeps the file name only while the text is still there.
    ta.addEventListener('input', () => { if (!ta.value.trim()) setFile('', 0); });
    // ⌘/Ctrl + Enter sends from the code box (plain Enter is a new line in code).
    ta.addEventListener('keydown', (e) => { if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) { e.preventDefault(); form.requestSubmit(); } });
    urlIn.addEventListener('input', () => { if (msg.dataset.kind === 'err') say(''); urlIn.removeAttribute('aria-invalid'); });

    // Files are read here, in the browser, into the code box. Nothing is uploaded until the person presses the button.
    const readFile = (f: File | undefined | null) => {
      if (!f) return;
      const ext = (f.name.match(/\.[^.]+$/)?.[0] || '').toLowerCase();
      if (!W.exts.includes(ext)) { say(W.errType); nudge(box); return; }
      if (f.size > W.max) { say(W.errSize); nudge(box); return; }
      const r = new FileReader();
      r.onload = () => {
        ta.value = String(r.result || ''); ta.scrollTop = 0; ta.scrollLeft = 0;
        setFile(f.name, f.size); refresh(); say('');
        track('from_claude_file', { location: loc, ext: ext.slice(1), kb: Math.round(f.size / 1024) });
      };
      r.onerror = () => say(W.errRead);
      r.readAsText(f);
    };
    form.querySelector<HTMLButtonElement>('[data-pick]')!.addEventListener('click', () => fileIn.click());
    fileIn.addEventListener('change', () => { readFile(fileIn.files?.[0]); fileIn.value = ''; });
    chip.querySelector<HTMLButtonElement>('[data-chip-x]')!.addEventListener('click', () => { ta.value = ''; setFile('', 0); refresh(); ta.focus(); });

    let depth = 0;
    const files = (e: DragEvent) => !!e.dataTransfer && [...e.dataTransfer.types].includes('Files');
    box.addEventListener('dragenter', (e) => { if (!files(e)) return; e.preventDefault(); depth++; box.classList.add('over'); });
    box.addEventListener('dragover', (e) => { if (!files(e)) return; e.preventDefault(); e.dataTransfer!.dropEffect = 'copy'; });
    box.addEventListener('dragleave', (e) => { if (!files(e)) return; depth = Math.max(0, depth - 1); if (!depth) box.classList.remove('over'); });
    box.addEventListener('drop', (e) => { if (!files(e)) return; e.preventDefault(); depth = 0; box.classList.remove('over'); readFile(e.dataTransfer!.files[0]); });

    form.addEventListener('submit', (e) => {
      const code = ta.value;
      const raw = urlIn.value.trim();
      const link = raw ? artifactLink(raw) : '';
      if (raw && !link) { e.preventDefault(); say(W.errLink); urlIn.setAttribute('aria-invalid', 'true'); urlIn.focus(); nudge(urlIn.parentElement!); return; }
      if (!code.trim() && !link) { e.preventDefault(); say(W.errEmpty); ta.focus(); nudge(box); return; }
      if (code.trim() && bytes(code) > W.max) { e.preventDefault(); say(W.errSize); nudge(box); return; }
      const params = new URLSearchParams(location.search);
      const utm = UTM.filter((k) => params.get(k)).map((k) => [k, params.get(k)!] as const);
      say('');
      submit.classList.add('busy'); submit.setAttribute('aria-busy', 'true'); label.textContent = W.sending;

      if (!code.trim()) {
        // Only a link: open the import with it (GET), so the app reads the artifact from its page.
        e.preventDefault();
        const q = new URLSearchParams({ url: link, lang: W.lang });
        utm.forEach(([k, v]) => q.set(k, v));
        track('from_claude_submit', { mode: 'link', location: loc });
        location.href = `${W.url}?${q.toString().replace(/\+/g, '%20')}`;
        return;
      }
      // Code: the browser posts the form. Empty optional fields stay out; utm fields ride along as hidden inputs.
      urlIn.value = link; urlIn.disabled = !link;
      const extra = utm.map(([k, v]) => { const h = document.createElement('input'); h.type = 'hidden'; h.name = k; h.value = v; form.appendChild(h); return h; });
      track('from_claude_submit', { mode: 'code', location: loc, has_file: !!fname.value, has_link: !!link });
      setTimeout(() => { urlIn.disabled = false; extra.forEach((h) => h.remove()); }, 0);
    });
    // Back from app.equipe.im (page restored from the back/forward cache): the button is ready again.
    addEventListener('pageshow', () => { submit.classList.remove('busy'); submit.removeAttribute('aria-busy'); label.textContent = idle; urlIn.disabled = false; refresh(); });
    refresh();
  });

  // "Paste your artifact" links elsewhere on the page scroll to the box and put the caret in it.
  document.querySelectorAll<HTMLAnchorElement>('[data-aim-focus]').forEach((a) => a.addEventListener('click', (e) => {
    const target = document.querySelector<HTMLTextAreaElement>(a.getAttribute('href') + ' [data-code]');
    if (!target) return;
    e.preventDefault();
    target.closest('form')!.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'center' });
    setTimeout(() => target.focus({ preventScroll: true }), 350);
  }));
</script>
