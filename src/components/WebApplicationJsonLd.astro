---
// The hosted product for the home page and /pricing: equipe in the browser (app.equipe.im), with the Mac and iPhone apps.
import JsonLd from './JsonLd.astro';
import { SITE, BRAND } from '../data/site';

interface Props { lang: string; url: string; description: string; featureList?: string[] }
const { lang, url, description, featureList } = Astro.props;
---

<JsonLd
  data={{
    '@type': 'SoftwareApplication',
    '@id': `${url}#app`,
    name: SITE.name,
    alternateName: BRAND.name,
    image: `${SITE.url}${BRAND.logo.png}`,
    brand: { '@type': 'Brand', name: SITE.name },
    url,
    inLanguage: lang,
    description,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web, macOS, iOS',
    ...(featureList ? { featureList } : {}),
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', description: 'Start free with 500 credits (100 credits = $1); no card needed.', url: `${SITE.url}/pricing/` },
    publisher: { '@id': `${SITE.url}/#organization` },
    sameAs: [SITE.appStore],
  }}
/>
