---
import { available } from '../i18n';
// PostHog, cookieless and lazy. Renders nothing at all unless PUBLIC_POSTHOG_KEY is set at
// build time (local builds, forks). Details and event list: docs/analytics.md.
const key = import.meta.env.PUBLIC_POSTHOG_KEY;
// The PostHog app host (only used for toolbar/UI links); events go through /ingest regardless.
const uiHost = import.meta.env.PUBLIC_POSTHOG_HOST || 'https://us.posthog.com';
// Vercel sets VERCEL_ENV to production | preview | development during the build.
// Every event carries it as `environment`, so Preview data never mixes into Production views.
const environment = process.env.VERCEL_ENV ?? 'local';
// Languages that have pages, for the `browser_language_supported` property.
const locales = available.map((l) => l.lang);
const config = JSON.stringify({ key, uiHost, environment, locales }).replace(/</g, '\\u003c');
---

{
  key && (
    <>
      <script is:inline type="application/json" id="analytics-config" set:html={config} />
      <script is:inline>
        window.eqTrack = function (n, p) { (window.__eqq = window.__eqq || []).push([n, p]); };
      </script>
      <script>
        import '../analytics/client';
      </script>
    </>
  )
}

<!-- How people found us: first and last touch (utm_*, referrer host, ref codes like the badge's ?ref=badge&site=, which ad
     click id was there but never its value) are kept in sessionStorage, cookieless, and handed to app.equipe.im in the
     links as a small `_eqa` parameter, so the sign-up can be traced back (with `p`, the page the click was on, for the
     Features view's sign-ups per feature). Nothing is sent from here. -->
<script is:inline>
  (function () { try {
    var S = sessionStorage, L = location, q = new URLSearchParams(L.search), o = {};
    ['source', 'medium', 'campaign', 'content', 'term'].forEach(function (n) { var v = q.get('utm_' + n); if (v) o[n] = v.toLowerCase().slice(0, 80); });
    var ref = q.get('ref'); if (ref) o.ref = ref.toLowerCase().slice(0, 40);
    var site = q.get('site'); if (site) o.site = site.toLowerCase().slice(0, 60);
    ['gclid', 'gbraid', 'wbraid', 'fbclid', 'msclkid', 'ttclid', 'twclid', 'li_fat_id', 'rdt_cid'].forEach(function (c) { if (q.get(c)) o.click = c; });
    try { var h = document.referrer ? new URL(document.referrer).hostname.replace(/^www\./, '') : ''; if (h && !/(^|\.)equipe\.(im|page)$/.test(h) && h !== L.hostname) o.referrer = h.slice(0, 80); } catch (e) {}
    var landing = L.pathname.slice(0, 100);
    if (!S.eq_af) S.eq_af = JSON.stringify(Object.assign({}, o, { landing: landing, at: Math.floor(Date.now() / 1000) }));
    if (Object.keys(o).length) S.eq_al = JSON.stringify(Object.assign({}, o, { landing: landing }));
    // The A/B arms this tab is in (Base.astro), so the app can count each arm's sign-ups (x: "hero=b").
    function arms() { var a = window.__eqAB || {}, o = []; for (var k in a) o.push(k + '=' + a[k]); return o.join(','); }
    function enc() { var x = arms(), f = JSON.parse(S.eq_af), l = JSON.parse(S.eq_al || S.eq_af); if (x) { f.x = x; l.x = x; } var j = JSON.stringify({ f: f, l: l, p: L.pathname.slice(0, 100) }); return btoa(unescape(encodeURIComponent(j))).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, ''); }
    function tag(a) { try { var u = new URL(a.href); if (u.hostname === 'app.equipe.im' && !u.searchParams.has('_eqa')) { u.searchParams.set('_eqa', enc()); a.href = u.toString(); } } catch (e) {} }
    window.__eqaEnc = function () { try { return enc(); } catch (e) { return ''; } };
    function all() { [].forEach.call(document.querySelectorAll('a[href*="app.equipe.im"]'), tag); }
    all(); document.addEventListener('DOMContentLoaded', all);
    document.addEventListener('click', function (e) { var a = e.target.closest && e.target.closest('a'); if (a) tag(a); }, true);
  } catch (e) {} })();
</script>
