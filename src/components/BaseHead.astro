---
import { SITE } from '../data/site';
import { available, getLocale, localePath, subPath, type LocaleCode } from '../i18n';

interface Props {
  title: string;
  description: string;
  locale: LocaleCode;
  ogTitle?: string;
  ogDescription?: string;
  /** Path or absolute URL of the social image. */
  image?: string;
  imageAlt?: string;
  /** Pixel size of the social image; defaults match the images from scripts/og.mjs (1200x630). */
  imageWidth?: number;
  imageHeight?: number;
  /** Override canonical; defaults to the current page URL on SITE. */
  canonical?: string;
  themeColor?: string;
  /** Favicon slot: href + optional type, e.g. { href: '/favicon.svg', type: 'image/svg+xml' }. */
  favicon?: { href: string; type?: string };
  noindex?: boolean;
  ogType?: 'website' | 'article';
  /** Sub-page this head belongs to (e.g. `app/privacy`); hreflang alternates point to the same page in each language. */
  subpage?: string;
  /** Error page (404): no canonical, no hreflang cluster, no og:url — it is not one fixed URL. */
  error?: boolean;
  /** Emit the hreflang cluster; false for pages that are not meant to be found yet. */
  alternates?: boolean;
  /** Languages this page exists in (hreflang cluster, og:locale:alternate); all available languages when omitted. For pages with partial translations, e.g. the blog. */
  langs?: LocaleCode[];
}

const {
  title,
  description,
  locale,
  ogTitle = title,
  ogDescription = description,
  image,
  imageAlt,
  imageWidth = 1200,
  imageHeight = 630,
  themeColor = SITE.themeColor,
  favicon = { href: '/favicon.svg', type: 'image/svg+xml' },
  noindex = false,
  ogType = 'website',
  subpage,
  error = false,
  alternates: withAlternates = true,
  langs,
} = Astro.props;

const canonical = Astro.props.canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const current = getLocale(locale);
const pageLocales = langs ? available.filter((l) => langs.includes(l.code)) : available;
const alternates = pageLocales.map((l) => ({ lang: l.lang, href: new URL(subpage ? subPath(l, subpage) : localePath(l), Astro.site).href }));
const xDefault = alternates.find((a) => a.lang === getLocale('en').lang)!.href;
const others = pageLocales.filter((l) => l.code !== locale);
const imageUrl = image ? new URL(image, Astro.site).href : undefined;
const imageType = imageUrl
  ? ({ png: 'image/png', jpg: 'image/jpeg', jpeg: 'image/jpeg', webp: 'image/webp', gif: 'image/gif' } as Record<string, string>)[
      new URL(imageUrl).pathname.split('.').pop()!.toLowerCase()
    ]
  : undefined;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
{!error && <link rel="canonical" href={canonical} />}
{!error && withAlternates && alternates.length > 1 && alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
{!error && withAlternates && alternates.length > 1 && <link rel="alternate" hreflang="x-default" href={xDefault} />}
<meta name="theme-color" content={themeColor} />
{noindex && <meta name="robots" content="noindex" />}
<link rel="icon" href={`${favicon.href}?v=2`} type={favicon.type} />
<link rel="icon" href="/favicon.ico?v=2" sizes="48x48 32x32 16x16" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
<link rel="manifest" href="/site.webmanifest?v=2" />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:site_name" content={SITE.name} />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={ogDescription} />
{!error && <meta property="og:url" content={canonical} />}
<meta property="og:locale" content={current.og} />
{others.map((l) => <meta property="og:locale:alternate" content={l.og} />)}
{imageUrl && <meta property="og:image" content={imageUrl} />}
{imageUrl && <meta property="og:image:width" content={String(imageWidth)} />}
{imageUrl && <meta property="og:image:height" content={String(imageHeight)} />}
{imageType && <meta property="og:image:type" content={imageType} />}
{imageUrl && imageAlt && <meta property="og:image:alt" content={imageAlt} />}

<meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={ogDescription} />
{imageUrl && <meta name="twitter:image" content={imageUrl} />}
