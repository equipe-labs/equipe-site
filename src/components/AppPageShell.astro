---
// Page chrome (header, footer, language menu) shared by the app privacy and support pages.
import Base from '../layouts/Base.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import '../styles/site.css';
import Analytics from './Analytics.astro';
import LangBanner from './LangBanner.astro';
import OrganizationJsonLd from './OrganizationJsonLd.astro';
import { SITE } from '../data/site';
import { getLocale, getMessages, localePath, subPath, type LocaleCode } from '../i18n';

interface Props {
  code: LocaleCode;
  /** `app` (get the app), `app/privacy` or `app/support`. */
  subpage: 'app' | 'app/privacy' | 'app/support';
  /** The get-the-app page lays out its own sections: no reading column, no contact line. */
  wide?: boolean;
  title: string;
  description: string;
}
const { code, subpage, title, description, wide = false } = Astro.props;
const info = getLocale(code);
const t = getMessages(code);
---

<Base locale={code} title={title} description={description} image={SITE.ogImage} imageAlt={t.meta.ogImageAlt} subpage={subpage}>
  <Fragment slot="head">
    <OrganizationJsonLd />
    <slot name="head" />
  </Fragment>

  <a class="skip" href="#main">{t.ui.skip}</a>
  <SiteHeader code={code} page={subpage} />

  {wide
    ? <main id="main" class="get-app"><slot /></main>
    : <main id="main" class="doc app-doc">
        <div class="wrap col">
          <slot />
          <p class="contact"><a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a> · <a href={SITE.issues}>GitHub</a></p>
        </div>
      </main>}

  <SiteFooter code={code} page={subpage} />

  <Analytics />
  <LangBanner locale={code} subpage={subpage} />
</Base>
