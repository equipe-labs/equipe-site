---
import JsonLd from './JsonLd.astro';
import { SITE } from '../data/site';
---

<JsonLd
  data={{
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    name: SITE.name,
    url: SITE.url,
    inLanguage: 'en',
    description: SITE.description,
    publisher: { '@id': `${SITE.url}/#organization` },
  }}
/>
