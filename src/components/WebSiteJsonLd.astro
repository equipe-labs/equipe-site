---
import JsonLd from './JsonLd.astro';
import { SITE } from '../data/site';

interface Props {
  lang: string;
  url: string;
  description: string;
}
const { lang, url, description } = Astro.props;
---

<JsonLd
  data={{
    '@type': 'WebSite',
    '@id': `${url}#website`,
    name: SITE.name,
    url,
    inLanguage: lang,
    description,
    publisher: { '@id': `${SITE.url}/#organization` },
  }}
/>
