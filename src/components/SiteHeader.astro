---
// Header for the marketing pages: the wordmark, How it works, Examples, Pricing, a Resources menu and About, then Sign in and the main call to action.
// Language and theme live in the footer (and the language list at the bottom of the mobile menu).
import Mark from './Mark.astro';
import Wordmark from './Wordmark.astro';
import LangMenu from './LangMenu.astro';
import { SITE } from '../data/site';
import { NAV } from '../data/nav';
import { getLocale, getMessages, localePath, subPath, type LocaleCode } from '../i18n';
import { BLOG_UI, blogLangFor, blogPath } from '../data/blog';

interface Props { code: LocaleCode; page: string; langs?: LocaleCode[] }
const { code, page, langs } = Astro.props;
const info = getLocale(code);
const t = getMessages(code);
const N = NAV[code] ?? NAV.en;
// Off the home page, the section links go back to it.
const home = page === 'home' ? '' : localePath(info);
const sub = page === 'home' ? undefined : page;
const bl = blogLangFor(code);
const bu = BLOG_UI[bl];
const how = `${home}#how-it-works`;
const examples = `${home}#gallery`;
const aboutHref = `${subPath(info, 'about')}#team`;
const I = {
  blog: 'M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3V4zM9 9h6M9 13h6',
  security: 'M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3zM9.5 12l2 2 3.5-4',
  facts: 'M4 20V10M10 20V4M16 20v-7M22 20H2',
  changelog: 'M12 7v5l3 2M21 12a9 9 0 1 1-3-6.7M21 4v5h-5',
  developers: 'M8 8l-4 4 4 4M16 8l4 4-4 4M13.5 5l-3 14',
};
const res = [
  { k: 'blog', href: blogPath(bl), label: bu.nav, d: N.desc.blog },
  { k: 'security', href: subPath(info, 'security'), label: t.nav.security, d: N.desc.security },
  { k: 'facts', href: bl === 'en' ? '/facts/' : `/${bl}/facts/`, label: bu.facts, d: N.desc.facts },
  { k: 'changelog', href: subPath(info, 'changelog'), label: t.pages.changelog.h1, d: N.desc.changelog },
  { k: 'developers', href: subPath(info, 'developers'), label: t.nav.developers, d: N.desc.developers },
] as const;
const resActive = ['security', 'developers', 'changelog', 'facts', 'blog'].includes(page);
---
<header class="site" data-site-header>
  <div class="wrap">
    <a class="brand" href={localePath(info)} aria-label="equipe"><Mark size={26} /><Wordmark height={19} /></a>
    <nav class="nav-c" aria-label={t.ui.primaryNav}>
      <ul>
        <li class="opt"><a href={how}>{t.nav.how}</a></li>
        <li class="opt"><a href={examples}>{N.examples}</a></li>
        <li class="opt"><a href={subPath(info, 'pricing')} aria-current={page === 'pricing' ? 'page' : undefined}>{t.nav.pricing}</a></li>
        <li class="opt">
          <details class="navdd" data-navdd>
            <summary class={resActive ? 'on' : undefined}>{N.resources}</summary>
            <ul class="lm res">
              {res.map((x) => (
                <li class="lm-i"><a class="rs" href={x.href} aria-current={page === x.k ? 'page' : undefined}>
                  <span class="rs-i" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d={I[x.k]} /></svg></span>
                  <span class="rs-t"><b>{x.label}</b><i>{x.d}</i></span>
                </a></li>
              ))}
            </ul>
          </details>
        </li>
        <li class="opt"><a href={aboutHref} aria-current={page === 'about' ? 'page' : undefined}>{t.nav.about}</a></li>
      </ul>
    </nav>
    <div class="nav-r">
      <a class="si" href={SITE.login} data-ph="signin_click" data-ph-location="header">{t.nav.signIn}</a>
      <a class="pill dark" href={SITE.start} data-ph="signup_cta_click" data-ph-location="header">{N.start}</a>
      <details class="navdd mnav" data-navdd>
        <summary aria-label={t.ui.primaryNav}>
          <svg class="mn-o" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 8h16M4 16h16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
          <svg class="mn-x" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
        </summary>
        <div class="sheet">
          <ul class="sh-main">
            <li><a href={how}>{t.nav.how}</a></li>
            <li><a href={examples}>{N.examples}</a></li>
            <li><a href={subPath(info, 'pricing')}>{t.nav.pricing}</a></li>
            <li><a href={aboutHref}>{t.nav.about}</a></li>
          </ul>
          <p class="sh-h">{N.resources}</p>
          <ul class="sh-res">{res.map((x) => <li><a href={x.href}>{x.label}</a></li>)}</ul>
          <div class="sh-foot">
            <a class="si-m" href={SITE.login} data-ph="signin_click" data-ph-location="menu">{t.nav.signIn}</a>
            <LangMenu locale={code} label={t.ui.language} subpage={sub} langs={langs} placement="sheet" />
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  import { wirePop, closePop } from '../scripts/popover';
  // Resources menu and mobile menu: close on Escape or a click outside; a link inside the mobile menu closes it.
  document.querySelectorAll<HTMLDetailsElement>('[data-navdd]').forEach((d) => {
    wirePop(d);
    if (d.classList.contains('mnav')) d.querySelectorAll('.sheet a[href]').forEach((a) => a.addEventListener('click', () => closePop(d)));
  });
  // The header turns into a translucent, blurred bar once the page scrolls.
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  if (header) {
    const on = () => header.classList.toggle('scrolled', window.scrollY > 6);
    on();
    window.addEventListener('scroll', on, { passive: true });
  }
</script>
