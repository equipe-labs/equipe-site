---
// Header for the home page and /developers: the wordmark, section links, Developers, language, Sign in and Get started (both on app.equipe.im).
import Mark from './Mark.astro';
import Wordmark from './Wordmark.astro';
import { SITE } from '../data/site';
import LangMenu from './LangMenu.astro';
import { DESIGN_LIVE } from '../data/design';
import { getDesignText } from '../i18n/design';
import { getLocale, getMessages, localePath, subPath, type LocaleCode } from '../i18n';

interface Props { code: LocaleCode; page: string }
const { code, page } = Astro.props;
const info = getLocale(code);
const t = getMessages(code);
const dz = getDesignText(code);
// Off the home page, the section links go back to it.
const home = page === 'home' ? '' : localePath(info);
const sub = page === 'home' ? undefined : page;
const product = [
  { href: `${home}#how-it-works`, label: t.nav.how },
  { href: `${home}#team`, label: t.nav.team },
  { href: `${home}#from-claude`, label: t.wedge.kicker },
  { href: `${home}#faq`, label: t.nav.faq },
];
---
<header class="site">
  <div class="wrap">
    <a class="brand" href={localePath(info)} aria-label="equipe"><Mark size={28} /><Wordmark height={20} /></a>
    <nav class="nav-c" aria-label={t.ui.primaryNav}>
      <ul>
        <li class="opt">
          <details class="navdd" data-navdd>
            <summary>{t.nav.product}</summary>
            <ul class="lm">{product.map((x) => <li class="lm-i"><a href={x.href}>{x.label}</a></li>)}</ul>
          </details>
        </li>
        <li class="opt"><a href={subPath(info, 'pricing')} aria-current={page === 'pricing' ? 'page' : undefined}>{t.nav.pricing}</a></li>
        <li class="opt"><a href={subPath(info, 'security')} aria-current={page === 'security' ? 'page' : undefined}>{t.nav.security}</a></li>
        {DESIGN_LIVE && <li class="opt dz-link"><a href={subPath(info, 'design')} data-ph="design_menu_click">{dz.menu}</a></li>}
        <li class="opt"><a href={subPath(info, 'developers')} aria-current={page === 'developers' ? 'page' : undefined} data-ph="developers_link_click" data-ph-location="header">{t.nav.developers}</a></li>
        <li class="opt"><a href={subPath(info, 'about')} aria-current={page === 'about' ? 'page' : undefined}>{t.nav.about}</a></li>
      </ul>
    </nav>
    <div class="nav-r">
      <LangMenu locale={code} label={t.ui.language} subpage={sub} />
      <button type="button" class="theme-t" data-theme-toggle data-l-system={t.ui.themeSystem} data-l-light={t.ui.themeLight} data-l-dark={t.ui.themeDark} aria-label={t.ui.themeSystem}>
        <svg class="i-system" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4.5" width="18" height="12" rx="2" /><path d="M9 20h6M12 16.5V20" /></svg>
        <svg class="i-light" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" /></svg>
        <svg class="i-dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
      </button>
      <a class="pill out signin" href={SITE.login} data-ph="signin_click" data-ph-location="header"><span class="si-l">{t.nav.signIn}</span><span class="si-s">{t.nav.signInShort}</span></a>
      <a class="pill dark" href={SITE.start} data-ph="signup_cta_click" data-ph-location="header"><span class="cta-l">{t.nav.cta}</span><span class="cta-s">{t.nav.ctaShort}</span></a>
    </div>
  </div>
</header>

<script>
  import { wirePop } from '../scripts/popover';
  // Product dropdown: close on Escape or a click outside.
  document.querySelectorAll<HTMLDetailsElement>('[data-navdd]').forEach((d) => {
    wirePop(d);
  });
  // Theme toggle: system (follow the device) -> light -> dark -> system. The choice is remembered by the inline head script (window.__eqTheme).
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) => {
    const root = document.documentElement;
    const order = ['system', 'light', 'dark'] as const;
    const sync = () => {
      const pref = (root.dataset.themePref as (typeof order)[number]) || 'system';
      const label = b.dataset[`l${pref[0].toUpperCase()}${pref.slice(1)}` as 'lSystem'] ?? '';
      b.setAttribute('aria-label', label); b.title = label; b.dataset.pref = pref;
    };
    sync();
    b.addEventListener('click', () => {
      const cur = (root.dataset.themePref as (typeof order)[number]) || 'system';
      const next = order[(order.indexOf(cur) + 1) % order.length];
      (window as unknown as { __eqTheme?: (v: string) => void }).__eqTheme?.(next);
      sync();
      (window as unknown as { eqTrack?: (n: string, p?: unknown) => void }).eqTrack?.('theme_toggle', { theme: next });
    });
  });
</script>
