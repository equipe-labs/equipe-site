---
// The equipe web app (app.equipe.im), drawn in code. No screenshots, no images.
// `k` names a scene: hero · mini · chat · team · decision · growth · cost · import. Words come from messages.scene.
// The example product is "Stride", a habit app at getstride.app; names and amounts stay the same in every language.
// Motion: the page adds `.live` to a scene while it is on screen (and motion is allowed); motion.css animates from there.
// Without it every scene shows its final, static state.
import Mark from './Mark.astro';
import IPhone from './IPhone.astro';
import StrideApp from './StrideApp.astro';
import RoleIcon from './RoleIcon.astro';
import type { Messages } from '../i18n';
interface Props { k: 'hero' | 'mini' | 'chat' | 'team' | 'decision' | 'growth' | 'cost' | 'import'; s: Messages['scene']; alt: string; class?: string }
const { k, s, alt, class: cls = '' } = Astro.props;
const A = s.activity, D = s.decision, G = s.growth, C = s.cost;
const domain = 'getstride.app';
const icons: Record<string, string> = {
  pm: 'M5 20V5h11l-2 4 2 4H5',
  eng: 'M9 7l-5 5 5 5M15 7l5 5-5 5',
  design: 'M4 20l4-1 11-11-3-3L5 16zM14 7l3 3',
  qa: 'M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6zM8.5 12l2.5 2.5 4.5-5',
  data: 'M5 20V11M12 20V5M19 20v-6',
  check: 'M5 12.5l4.5 4.5L19 7.5',
  lock: 'M7 11V8a5 5 0 0 1 10 0v3M5 11h14v9H5z',
  send: 'M12 19V5M6 11l6-6 6 6',
  chat: 'M4 5h16v11H9l-5 4z',
  team: 'M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM3 20c0-3 3-5 6-5s6 2 6 5M16 5a3 3 0 0 1 0 6M18 15c2 .5 3 2.5 3 5',
  dec: 'M4 6h16v12H4zM4 10h16',
  usage: 'M4 20h16M7 16v-5M12 16V7M17 16v-8',
  arrow: 'M5 12h14M13 6l6 6-6 6',
};
// Who does what. `swap` rows change from Working to Done on a loop while the scene is live.
const tasks = [
  { r: 'eng', st: 'working', swap: true }, { r: 'eng', st: 'working' }, { r: 'design', st: 'done' }, { r: 'qa', st: 'working', swap: true, late: true }, { r: 'data', st: 'next' },
] as const;
const roleName = (r: string) => (A.roles as Record<string, string>)[r];
const stateName = (st: string) => (A.states as Record<string, string>)[st];
// This month's spend by role (dollars; adds up to $38).
const spend = [{ r: 'eng', v: 19 }, { r: 'pm', v: 7 }, { r: 'design', v: 5 }, { r: 'qa', v: 4 }, { r: 'data', v: 3 }];
---
<figure class={`wa-fig wa-${k} ${cls}`.trim()} role="img" aria-label={alt} data-scene={k}>
<div class="wa" aria-hidden="true">

  {k === 'hero' && (
    <div class="wa-win">
      <div class="wa-bar"><i></i><i></i><i></i><span class="wa-url"><svg viewBox="0 0 24 24"><path d={icons.lock} /></svg>app.equipe.im</span></div>
      <div class="wa-app">
        <aside class="wa-side">
          <div class="wa-brand"><Mark size={20} /><b>equipe</b></div>
          <div class="wa-proj"><span class="wa-pi">S</span><span><b>Stride</b><em><i class="wa-live-dot"></i>{s.live}</em></span></div>
          <nav>
            <span class="on"><svg viewBox="0 0 24 24"><path d={icons.chat} /></svg>{s.nav.chat}</span>
            <span><svg viewBox="0 0 24 24"><path d={icons.team} /></svg>{s.nav.team}</span>
            <span><svg viewBox="0 0 24 24"><path d={icons.dec} /></svg>{s.nav.decisions}<b class="wa-badge">1</b></span>
            <span><svg viewBox="0 0 24 24"><path d={icons.usage} /></svg>{s.nav.usage}</span>
          </nav>
        </aside>
        <div class="wa-chat">
          <div class="wa-chat-h"><span class="wa-av pm"><RoleIcon r="pm" /></span><b>PM</b><span class="wa-mu">Stride</span></div>
          <div class="wa-msgs">
            <p class="me">{s.ask}</p>
            <div class="pm"><span class="wa-av pm"><RoleIcon r="pm" /></span><p>{s.reply}</p></div>
            <p class="me">{s.answer}</p>
            <div class="wa-dec inchat">
              <div class="wa-dec-k"><i></i>{D.label}</div>
              <b class="wa-dec-q">{D.title}</b>
              <div class="wa-opt on"><span class="wa-radio"></span><span><b>{D.a}</b><em>{D.aText}</em></span><span class="wa-rec">{D.rec}</span></div>
              <div class="wa-opt"><span class="wa-radio"></span><span><b>{D.b}</b><em>{D.bText}</em></span></div>
              <div class="wa-dec-f"><span class="wa-cost">{D.cost} <b>$6</b></span><span class="wa-btn">{D.ask}</span><span class="wa-btn pri">{D.approve}</span></div>
            </div>
          </div>
        </div>
        <div class="wa-right">
          <div class="wa-act">
            <div class="wa-act-h">{A.title}</div>
            {tasks.map((t, i) => (
              <div class="wa-row"><span class={`wa-av ${t.r}`}><RoleIcon r={t.r} /></span><span class="wa-row-t"><b>{roleName(t.r)}</b><span>{A.tasks[i]}</span></span>
                {'swap' in t && t.swap
                  ? <em class={`wa-sw${'late' in t && t.late ? ' late' : ''}`}><span class="wa-st working">{stateName('working')}</span><span class="wa-st done">{stateName('done')}</span></em>
                  : <em class={`wa-st ${t.st}`}>{stateName(t.st)}</em>}
              </div>
            ))}
          </div>
          <div class="wa-week">
            <div class="wa-act-h">{G.week}<span class="wa-live"><i class="wa-live-dot"></i>{s.live}</span></div>
            <div class="wa-stats">
              <div><b data-tick="412">412</b><span>{G.stats[0]}</span></div>
              <div><b data-tick="186">186</b><span>{G.stats[1]}</span></div>
            </div>
            <div class="wa-spark"><svg viewBox="0 0 200 48" preserveAspectRatio="none"><path class="ar" d="M0 40 L28 36 L57 38 L85 28 L114 30 L142 18 L171 20 L200 8 L200 48 L0 48Z" /><path class="ln" d="M0 40 L28 36 L57 38 L85 28 L114 30 L142 18 L171 20 L200 8" /></svg></div>
          </div>
        </div>
      </div>
      <div class="wa-device"><IPhone w={232} url={domain}><StrideApp s={s} /></IPhone></div>
      <div class="wa-metrics">
        <div class="wa-m"><span>{s.metrics.signups}</span><b data-tick="128">128</b><em class="up">▲ 18%</em></div>
        <div class="wa-m"><span>{s.metrics.conv}</span><b data-tick="4.2" data-dec="1">4.2</b><em>%</em></div>
        <svg class="wa-m-sp" viewBox="0 0 120 28" preserveAspectRatio="none"><path d="M0 24 L15 22 L30 23 L45 17 L60 18 L75 11 L90 12 L105 6 L120 3" /></svg>
      </div>
    </div>
  )}

  {k === 'mini' && (
    <div class="wa-card wa-minic">
      <div class="wa-act-h">{A.title}<span class="wa-live"><i class="wa-live-dot"></i>{s.live}</span></div>
      {[0, 2, 3].map((i) => {
        const t = tasks[i];
        return (
          <div class="wa-row"><span class={`wa-av ${t.r}`}><RoleIcon r={t.r} /></span><span class="wa-row-t"><b>{roleName(t.r)}</b><span>{A.tasks[i]}</span></span>
            {'swap' in t && t.swap
              ? <em class={`wa-sw${'late' in t && t.late ? ' late' : ''}`}><span class="wa-st working">{stateName('working')}</span><span class="wa-st done">{stateName('done')}</span></em>
              : <em class={`wa-st ${t.st}`}>{stateName(t.st)}</em>}
          </div>
        );
      })}
      <div class="wa-mini-dec"><span class="wa-dec-k"><i></i>{D.label}</span><b>{D.title}</b><span class="wa-btn pri">{D.approve}</span></div>
    </div>
  )}

  {k === 'chat' && (
    <div class="wa-card wa-chat solo">
      <div class="wa-chat-h"><span class="wa-av pm"><RoleIcon r="pm" /></span><b>PM</b><span class="wa-mu">Stride</span></div>
      <div class="wa-msgs">
        <p class="me">{s.ask}</p>
        <div class="pm"><span class="wa-av pm"><RoleIcon r="pm" /></span><p>{s.reply}</p></div>
        <p class="me">{s.answer}</p>
        <div class="pm tw"><span class="wa-av pm"><RoleIcon r="pm" /></span><span class="tw-c"><span class="tw-dots"><i></i><i></i><i></i></span><p>{s.reply2}</p></span></div>
      </div>
      <div class="wa-comp"><span>{s.composer}</span><i><svg viewBox="0 0 24 24"><path d={icons.send} /></svg></i></div>
    </div>
  )}

  {k === 'team' && (
    <div class="wa-teamscene">
      <div class="wa-card wa-act">
        <div class="wa-act-h">{A.title}<span class="wa-mu">Stride</span></div>
        {tasks.map((t, i) => (
          <div class="wa-row"><span class={`wa-av ${t.r}`}><RoleIcon r={t.r} /></span><span class="wa-row-t"><b>{roleName(t.r)}</b><span>{A.tasks[i]}</span></span>
            {'swap' in t && t.swap
              ? <em class={`wa-sw${'late' in t && t.late ? ' late' : ''}`}><span class="wa-st working">{stateName('working')}</span><span class="wa-st done">{stateName('done')}</span></em>
              : <em class={`wa-st ${t.st}`}>{stateName(t.st)}</em>}
          </div>
        ))}
      </div>
      <div class="wa-phone"><IPhone w={196} url={domain}><StrideApp s={s} /></IPhone></div>
    </div>
  )}

  {k === 'decision' && (
    <div class="wa-card wa-dec solo">
      <div class="wa-dec-k"><i></i>{D.label}</div>
      <b class="wa-dec-q">{D.title}</b>
      <div class="wa-opt on"><span class="wa-radio"></span><span><b>{D.a}</b><em>{D.aText}</em></span><span class="wa-rec">{D.rec}</span></div>
      <div class="wa-opt"><span class="wa-radio"></span><span><b>{D.b}</b><em>{D.bText}</em></span></div>
      <div class="wa-dec-f"><span class="wa-cost">{D.cost} <b>$6</b></span><span class="wa-btn">{D.ask}</span><span class="wa-btn pri wa-ap">{D.approve}</span></div>
    </div>
  )}

  {k === 'growth' && (
    <div class="wa-card wa-grow">
      <div class="wa-grow-k"><span class="wa-av data"><RoleIcon r="data" /></span>{G.label}<span class="wa-mu">{G.week}</span></div>
      <div class="wa-stats">
        <div><b data-tick="412">412</b><span>{G.stats[0]}</span></div>
        <div><b data-tick="186">186</b><span>{G.stats[1]}</span></div>
        <div class="warn"><b data-tick="41" data-suffix="%">41%</b><span>{G.stats[2]}</span></div>
      </div>
      <b class="wa-grow-t">{G.title}</b>
      <p>{G.text}</p>
      <div class="wa-dec-f"><span class="wa-cost">{G.cost} <b>~$3</b></span><span class="wa-btn">{G.no}</span><span class="wa-btn pri">{G.yes}</span></div>
    </div>
  )}

  {k === 'cost' && (
    <div class="wa-card wa-costc">
      <div class="wa-cost-h"><span class="wa-cost-ic"><svg viewBox="0 0 24 24"><path d={icons.usage} /></svg></span><span>{C.title}</span><em class="ok"><svg viewBox="0 0 24 24"><path d={icons.check} /></svg>{C.under}</em></div>
      <div class="wa-cost-n"><b data-tick="38" data-prefix="$">$38</b><span>/ $100 · {C.cap}</span></div>
      <div class="wa-meter seg">
        {spend.map((x) => <i class={`r-${x.r}`} style={`width:${x.v}%`}></i>)}
        <i class="exp" style="width:26%"></i>
      </div>
      <ul class="wa-split">
        {spend.map((x) => <li><span class={`rav rav-${x.r}`}><RoleIcon r={x.r} /></span><span>{roleName(x.r)}</span><b>${x.v}</b><em>{Math.round((x.v / 38) * 100)}%</em></li>)}
      </ul>
      <div class="wa-cost-f"><span><i class="k2"></i>{C.expected}</span><b>~$64</b></div>
    </div>
  )}

  {k === 'import' && (
    <div class="wa-flow">
      <div class="wa-card wa-step">
        <div class="wa-step-h"><span class="wa-chipk">{s.imp.from}</span></div>
        <div class="wa-art">
          <b>Stride</b>
          <span class="l w70"></span><span class="l w90"></span><span class="l w50"></span>
          <span class="box"></span>
          <span class="l w60"></span>
        </div>
      </div>
      <span class="wa-link"><svg viewBox="0 0 24 24"><path d={icons.arrow} /></svg></span>
      <div class="wa-card wa-step">
        <div class="wa-step-h"><span class="wa-chipk">{s.imp.setup}</span></div>
        <ul class="wa-checks">
          {s.imp.checks.map((c) => <li><i><svg viewBox="0 0 24 24"><path d={icons.check} /></svg></i>{c}</li>)}
        </ul>
      </div>
      <span class="wa-link"><svg viewBox="0 0 24 24"><path d={icons.arrow} /></svg></span>
      <div class="wa-card wa-step wa-prev">
        <div class="wa-prev-bar"><span class="wa-url sm"><svg viewBox="0 0 24 24"><path d={icons.lock} /></svg>{domain}</span><span class="wa-live"><i class="wa-live-dot"></i>{s.live}</span></div>
        <div class="wa-stride-web">
          <span class="sw-logo"><i></i>Stride</span>
          <b>{s.app.tagline}</b>
          <span class="sw-cta">{s.app.add}</span>
        </div>
      </div>
    </div>
  )}

</div>
</figure>
