---
// One role's glyph (white, SF Symbols-like), for the gradient role avatar. Shared set: public/brand/avatars/, data: src/data/roles.json.
import roles from '../data/roles.json';
interface Props { r: string }
const map: Record<string, keyof typeof roles> = { pm: 'pm', eng: 'engineer', engineer: 'engineer', design: 'designer', designer: 'designer', qa: 'qa', data: 'data', marketing: 'marketing' };
const body = roles[map[Astro.props.r] ?? 'pm'].glyph;
---
<svg viewBox="0 0 24 24" aria-hidden="true" set:html={body} />
