---
// The `e.` tile (brand v1 mark); `single` renders one dot (solid or faded) for card markers.
interface Props { size?: number; single?: 'solid' | 'faded' }
const { size = 32, single } = Astro.props;
---

{single ? (
  <svg viewBox="0 0 16 16" width={size} height={size} fill="var(--accent)" aria-hidden="true">
    <circle cx="8" cy="8" r="6" opacity={single === 'faded' ? 0.55 : 1} />
  </svg>
) : (
  <svg viewBox="0 0 100 100" width={size} height={size} aria-hidden="true">
    <rect width="100" height="100" rx="22" fill="#0A0A0C" />
    <text x="50" y="0" text-anchor="middle" font-family="Helvetica Neue,Arial,sans-serif" font-weight="700" font-size="74" letter-spacing="-4.4" transform="translate(-2,70)" fill="#EFEDE7">e<tspan fill="none">.</tspan></text>
    <circle cx="70.5" cy="66.5" r="6.4" fill="#3F6FF5" />
  </svg>
)}
