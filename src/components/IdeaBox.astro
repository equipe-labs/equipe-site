---
// "What business do you want to run?" — the idea box that starts sign-up, the same composer as app.equipe.im/new.
// It is a plain GET form to app.equipe.im/start?idea=<text>, so it works without JavaScript; the script adds the
// growing box, example businesses rotating in the placeholder (still under reduced motion), Enter-to-send, Tab to
// take the example shown, and the goals. A goal never replaces typing: on an empty box it starts a sentence the person
// finishes, and it goes with the idea as one last line ("Goal: Sell my service online") for the PM. The goals are
// ordered by demand (service, paid app, store, expertise) and match app.equipe.im/new. "+" brings an existing site
// (the app's import). "Like this app" starts from a reference: links to an existing app or site (App Store, Google Play,
// any website, Product Hunt, Figma), each shown as a preview card that app.equipe.im reads on its server (POST
// /api/ref-peek, CORS for equipe.im; the link goes in the body, never a URL), and one line of what to make different.
// They go to /start as ref= and change=, and the team builds an original product inspired by them, never a copy.
// `big`: the hero version (large rounded surface, + and a round send button, the free-to-start
// note beside send, goals in a 2 x 2 grid that lines up with the box, one quiet line of what the team does next).
import { SITE } from '../data/site';
import { getMessages, type LocaleCode } from '../i18n';

interface Props { code: LocaleCode; id: string; location: string; big?: boolean }
const { code, id, location, big = false } = Astro.props;
const m = getMessages(code);
const p = m.prompt;
const sv = (d: string) => `<svg viewBox="0 0 24 24" aria-hidden="true">${d}</svg>`;
// Lucide shapes (ISC): briefcase, credit card, shopping bag, graduation cap.
const GI: Record<string, string> = {
  service: sv('<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M3 13h18"/>'),
  app: sv('<rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="M2.5 10h19"/><path d="M6.5 15h4"/>'),
  store: sv('<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>'),
  expert: sv('<path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c3 2.5 9 2.5 12 0v-5"/>'),
};
// "Free to start · $5 credit · No card needed" as parts, so phones can drop the middle one.
const free = p.note.split(' · ');
const words = { ex: p.examples, goals: Object.fromEntries(p.goals.map((g) => [g.key, [g.label, g.starter]])), goalLine: p.goalLine, goalRemove: p.goalRemove, ref: p.ref, peek: new URL('/api/ref-peek', SITE.start).toString() };
// Lucide shapes (ISC): copy (a reference), globe (a site), x.
const REF_ICON = sv('<rect x="8" y="8" width="13" height="13" rx="2"/><path d="M4 16a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2"/>');
const like = `<button type="button" class="idea-like" aria-expanded="false" aria-controls="${id}-ref" data-ref-toggle>${REF_ICON}<span>${p.ref.toggle}</span></button>`;
---
<form class={`idea${big ? ' big' : ''}`} action={SITE.start} method="get" data-idea data-ph-location={location} data-words={JSON.stringify(words)}>
  <label class={big ? 'sr-only' : 'idea-l'} for={id}>{p.label}</label>
  <div class="idea-box">
    {big && <kbd class="idea-tab" aria-hidden="true">Tab</kbd>}
    <div class="idea-in">
      <textarea id={id} name="idea" rows="3" maxlength="2000" placeholder=" " enterkeyhint="send"></textarea>
      <span class="idea-ph" aria-hidden="true">{p.examples[0]}</span>
    </div>
    <div class="idea-refs" id={`${id}-ref`} data-refs hidden>
      <div class="idea-rrow"><Fragment set:html={REF_ICON} /><input type="url" inputmode="url" autocomplete="off" spellcheck="false" placeholder={p.ref.ph} aria-label={p.ref.title} data-ref-in /><button type="button" class="idea-radd" data-ref-add>{p.ref.add}</button></div>
      <div class="idea-rlist" data-ref-list aria-live="polite"></div>
      <label class="idea-rwhat" data-ref-what-wrap hidden><span>{p.ref.what}</span><input type="text" name="change" maxlength="200" autocomplete="off" placeholder={p.ref.whatPh} data-ref-what disabled /></label>
      <p class="idea-rnote">{p.ref.note}</p>
      <p class="idea-rmsg" data-ref-msg role="status" hidden></p>
    </div>
    <div class="idea-bar">
      {big ? (
        <>
          <div class="idea-l2">
            <a class="idea-plus" href={SITE.importProject} aria-label={p.siteGoal} title={p.siteGoal} data-ph="import_click" data-ph-location={location}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
            </a>
            <Fragment set:html={like} />
            <span class="idea-gslot" data-gslot></span>
          </div>
          <div class="idea-r">
            <span class="idea-free">{free.map((f) => <span>{f}</span>)}</span>
            <button class="idea-send" type="submit" aria-label={p.submit} data-send><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M5.5 11.5L12 5l6.5 6.5" /></svg></button>
          </div>
        </>
      ) : (
        <>
          <Fragment set:html={like} />
          <span class="idea-gslot" data-gslot></span>
          <button class="btn primary idea-go" type="submit"><span>{p.submit}</span><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
        </>
      )}
    </div>
  </div>
  <div class="idea-goals" role="group" aria-label={p.goalsLabel}>
    {p.goals.map((g, i) => <button type="button" class="idea-goal" data-goal={g.key} aria-pressed="false" style={`--i:${i}`}><Fragment set:html={GI[g.key]} /><span>{g.label}</span></button>)}
  </div>
  {location === 'hero' ? (
    /* The hero's step strip: four numbered steps on one connector; the brand fill runs along it and lights each step in turn. */
    <div class="flow" role="group" aria-labelledby={`${id}-flow`}>
      <p class="flow-h" id={`${id}-flow`}>{p.nextLabel}</p>
      <ol class="flow-s">
        {p.steps.map((s, i) => <li style={`--i:${i}`}><span class="fm" aria-hidden="true">{i + 1}</span><span class="ft"><b>{s}</b><small>{p.stepNotes[i]}</small></span></li>)}
      </ol>
    </div>
  ) : (
    <p class="idea-next"><span class="nl">{p.nextLabel}</span>{p.steps.map((s, i) => <>{i > 0 && <svg class="sep" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>}<span>{s}</span></>)}</p>
  )}
  {!big && <p class="idea-note">{p.note}</p>}
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-idea]').forEach((form) => {
    const ta = form.querySelector('textarea')!;
    const ph = form.querySelector<HTMLElement>('.idea-ph')!;
    const slot = form.querySelector<HTMLElement>('[data-gslot]')!;
    type RefWords = { toggle: string; title: string; ph: string; add: string; bad: string; what: string; whatPh: string; note: string; remove: string; fail: string; reading: string; max: string; close: string };
    const W: { ex: string[]; goals: Record<string, [string, string]>; goalLine: string; goalRemove: string; ref: RefWords; peek: string } = JSON.parse(form.dataset.words || '{}');
    const track = (n: string, props?: Record<string, unknown>) => (window as unknown as { eqTrack?: (n: string, p?: unknown) => void }).eqTrack?.(n, props);
    const send = form.querySelector<HTMLElement>('[data-send]');
    const esc = (x: string) => x.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
    // Grow with the text up to about seven lines, then scroll inside; the send button looks idle while the box is empty.
    const fit = () => {
      ta.style.height = 'auto';
      const lh = parseFloat(getComputedStyle(ta).lineHeight) || 26;
      const max = lh * 7 + 30;
      ta.style.height = Math.min(ta.scrollHeight, max) + 'px';
      ta.style.overflowY = ta.scrollHeight > max ? 'auto' : 'hidden';
      send?.classList.toggle('idle', !ta.value.trim());
      form.classList.toggle('empty', !ta.value);
    };
    // Goals: one at a time, tap again to clear. On an empty box (or one holding only another goal's sentence start) the
    // sentence start goes in, caret at its end; what the person already typed is never replaced.
    let goal = '', starter = '';
    const setGoal = (k: string) => {
      goal = k;
      form.querySelectorAll<HTMLElement>('.idea-goal[data-goal]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.goal === goal)));
      const untouched = !ta.value.trim() || (starter && ta.value === starter);
      if (untouched) { starter = goal ? W.goals[goal][1] : ''; ta.value = starter; if (goal) { ta.focus(); ta.setSelectionRange(ta.value.length, ta.value.length); } }
      else if (!goal) starter = '';
      const g = goal ? W.goals[goal] : null;
      slot.innerHTML = g ? `<span class="idea-gchip">${form.querySelector(`.idea-goal[data-goal="${goal}"] svg`)?.outerHTML || ''}<span>${esc(g[0])}</span><button type="button" aria-label="${esc(W.goalRemove)}" title="${esc(W.goalRemove)}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></button></span>` : '';
      slot.querySelector('button')?.addEventListener('click', () => { setGoal(''); ta.focus(); });
      fit();
      if (goal) track('idea_goal', { location: form.dataset.phLocation, goal });
    };
    form.querySelectorAll<HTMLButtonElement>('.idea-goal[data-goal]').forEach((b) => b.addEventListener('click', () => setGoal(goal === b.dataset.goal ? '' : b.dataset.goal!)));
    ta.addEventListener('input', () => { fit(); if (goal && starter && !ta.value.trim()) setGoal(''); });
    fit();
    // Tab takes the example shown, only while the box is empty; otherwise Tab moves focus as usual (no focus trap).
    let pi = 0;
    ta.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab' || e.shiftKey || e.altKey || e.ctrlKey || e.metaKey || ta.value) return;
      e.preventDefault();
      ta.value = W.ex[pi] || '';
      fit();
      ta.setSelectionRange(ta.value.length, ta.value.length);
      track('idea_tab_accept', { location: form.dataset.phLocation });
    });
    // Enter sends, Shift+Enter adds a line; never while an input method (Korean, Japanese, Chinese) is composing.
    ta.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey && !e.isComposing && e.keyCode !== 229) { e.preventDefault(); form.requestSubmit(); }
    });
    form.classList.add('sug');
    // Example businesses rotate in the placeholder while the box is empty and on screen (motion allowed only).
    if (document.documentElement.classList.contains('mo') && W.ex.length > 1) {
      let visible = false;
      new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(form);
      setInterval(() => {
        if (!visible || document.hidden || ta.value) return;
        ph.classList.add('out');
        setTimeout(() => { pi = (pi + 1) % W.ex.length; ph.textContent = W.ex[pi]; ph.classList.remove('out'); ph.classList.add('pre'); void ph.offsetWidth; ph.classList.remove('pre'); }, 280);
      }, 3600);
    }
    // "Like this app": reference links as preview cards (read by app.equipe.im's server), at most four.
    type Card = { ok?: boolean; kind?: string; name?: string; host?: string; developer?: string; category?: string; rating?: number | null; icon?: string; image?: string; description?: string; screenshots?: string[] };
    type Ref = { url: string; host: string; state: 'loading' | 'ok' | 'fail'; card: Card | null };
    const refs: Ref[] = [];
    const panel = form.querySelector<HTMLElement>('[data-refs]')!;
    const toggle = form.querySelector<HTMLButtonElement>('[data-ref-toggle]')!;
    const rin = form.querySelector<HTMLInputElement>('[data-ref-in]')!;
    const list = form.querySelector<HTMLElement>('[data-ref-list]')!;
    const whatWrap = form.querySelector<HTMLElement>('[data-ref-what-wrap]')!;
    const what = form.querySelector<HTMLInputElement>('[data-ref-what]')!;
    const rmsg = form.querySelector<HTMLElement>('[data-ref-msg]')!;
    const RM = !document.documentElement.classList.contains('mo');
    const KIND: Record<string, string> = { appstore: 'App Store', playstore: 'Google Play', producthunt: 'Product Hunt', figma: 'Figma' };
    const say = (t: string) => { rmsg.textContent = t; rmsg.hidden = !t; };
    const norm = (v: string) => {
      v = v.trim().replace(/[.,;:!?)\]]+$/, '');
      if (!v || /\s/.test(v) || v.length > 2048) return '';
      if (!/^https?:\/\//i.test(v)) v = 'https://' + v;
      try { const u = new URL(v); if (!/^https?:$/.test(u.protocol) || !u.hostname.includes('.')) return ''; u.hash = ''; return u.toString(); } catch { return ''; }
    };
    const isListing = (v: string) => {
      const n = norm(v); if (!n) return false;
      const u = new URL(n), h = u.hostname.replace(/^www\./, '');
      return ((h === 'apps.apple.com' || h === 'itunes.apple.com') && /\/id\d{5,12}/.test(u.pathname)) || (h === 'play.google.com' && /^\/store\/apps\/details/.test(u.pathname)) || (h === 'producthunt.com' && /^\/(posts|products)\//.test(u.pathname)) || (h === 'figma.com' && /^\/(file|design|proto|board|community\/file)\//.test(u.pathname));
    };
    const img = (src?: string) => (src && /^https:\/\//.test(src) ? `<img src="${esc(src)}" alt="" decoding="async" loading="lazy" referrerpolicy="no-referrer">` : '');
    const X = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>';
    const GLOBE = '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a14 14 0 0 1 0 18 14 14 0 0 1 0-18Z"/></svg>';
    const cardHtml = (r: Ref, i: number) => {
      const c = r.card || {};
      const nm = W.ref.remove.replace('{name}', c.name || r.host);
      const rm = `<button type="button" class="idea-rx" data-rm="${i}" aria-label="${esc(nm)}" title="${esc(nm)}">${X}</button>`;
      if (r.state === 'loading') return `<div class="idea-r1" aria-busy="true" aria-label="${esc(W.ref.reading)}"><div class="idea-rt"><span class="idea-ri"></span><span class="idea-rtx"><i class="bone" style="width:58%"></i><i class="bone sm" style="width:36%"></i></span>${rm}</div></div>`;
      const ok = r.state === 'ok' && !!c.ok;
      const site = !c.kind || c.kind === 'website';
      const meta = ok ? [c.developer, c.category, c.rating ? `★\u00a0${c.rating}` : '', KIND[c.kind || ''] || r.host].filter(Boolean).join(' · ') : (KIND[c.kind || ''] || r.host);
      const shots = ok ? (!site && c.screenshots && c.screenshots.length ? c.screenshots.slice(0, 3) : c.image ? [c.image] : []) : [];
      const wide = site || c.kind === 'figma' || c.kind === 'producthunt';
      return `<div class="idea-r1"><div class="idea-rt"><span class="idea-ri${site ? ' site' : ''}">${ok && c.icon ? img(c.icon) : GLOBE}</span><span class="idea-rtx"><b>${esc(ok ? c.name || r.host : c.name || r.host)}</b><small>${esc(meta)}</small></span>${rm}</div>`
        + (ok && c.description ? `<p class="idea-rd">${esc(c.description)}</p>` : !ok ? `<p class="idea-rd">${esc(W.ref.fail)}</p>` : '')
        + (shots.length ? `<div class="idea-rs${wide ? ' wide' : ''}">${shots.slice(0, wide ? 1 : 3).map((s) => img(s)).join('')}</div>` : '') + '</div>';
    };
    const draw = () => {
      list.innerHTML = refs.map(cardHtml).join('');
      whatWrap.hidden = !refs.length; what.disabled = !refs.length;
      list.querySelectorAll<HTMLImageElement>('img').forEach((im) => {
        const on = () => im.classList.add('ok');
        if (im.complete && im.naturalWidth) on(); else { im.addEventListener('load', on); im.addEventListener('error', () => { const p = im.parentElement; im.remove(); if (p && p.classList.contains('idea-ri')) p.innerHTML = GLOBE; if (p && p.classList.contains('idea-rs') && !p.children.length) p.remove(); }); }
      });
      list.querySelectorAll<HTMLButtonElement>('[data-rm]').forEach((b) => b.addEventListener('click', () => {
        const i = Number(b.dataset.rm); const el = b.closest<HTMLElement>('.idea-r1');
        const go = () => { refs.splice(i, 1); draw(); say(''); (refs.length ? rin : ta).focus(); };
        if (RM || !el) go(); else { el.classList.add('out'); setTimeout(go, 160); }
      }));
    };
    const addRef = async (v: string) => {
      const url = norm(v);
      if (!url) { say(W.ref.bad); return false; }
      if (refs.some((r) => r.url === url)) return true;
      if (refs.length >= 4) { say(W.ref.max); return false; }
      say('');
      const r: Ref = { url, host: new URL(url).hostname.replace(/^www\./, ''), state: 'loading', card: null };
      refs.push(r); draw();
      track('idea_reference', { location: form.dataset.phLocation, listing: isListing(url) });
      try {
        const res = await fetch(W.peek, { method: 'POST', mode: 'cors', credentials: 'omit', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ url }) });
        const c: Card | null = await res.json().catch(() => null);
        r.card = c; r.state = c && c.ok ? 'ok' : 'fail';
      } catch { r.state = 'fail'; }
      if (refs.includes(r)) draw();
      return true;
    };
    const open = (on: boolean) => { panel.hidden = !on; toggle.setAttribute('aria-expanded', String(on)); toggle.classList.toggle('on', on); if (on) rin.focus(); };
    toggle.addEventListener('click', () => open(panel.hasAttribute('hidden')));
    const addTyped = async () => { const v = rin.value; if (!norm(v)) { say(W.ref.bad); rin.focus(); return; } rin.value = ''; const first = !refs.length; await addRef(v); if (first && refs.length && !what.value) what.focus({ preventScroll: true }); };
    form.querySelector<HTMLButtonElement>('[data-ref-add]')!.addEventListener('click', addTyped);
    rin.addEventListener('keydown', (e) => { if (e.key === 'Enter' && !e.isComposing && e.keyCode !== 229) { e.preventDefault(); addTyped(); } else if (e.key === 'Escape' && !refs.length) { open(false); ta.focus(); } });
    rin.addEventListener('paste', () => setTimeout(() => { if (norm(rin.value)) addTyped(); }, 0));
    // A store or Product Hunt link pasted into the idea box is someone else's product: it becomes a reference card.
    ta.addEventListener('paste', () => setTimeout(() => { const v = ta.value.trim(); if (isListing(v)) { ta.value = ''; fit(); open(true); addRef(v); } }, 0));

    form.addEventListener('submit', (e) => {
      const v0 = ta.value.trim();
      // A goal's sentence start left alone next to a reference says nothing: the reference and its line carry the idea.
      const v = refs.length && goal && starter && v0 === starter.trim() ? '' : v0;
      // Only a goal's sentence start, not finished: stay, with the caret where the person writes next.
      if (!refs.length && goal && starter && v === starter.trim()) { e.preventDefault(); ta.focus(); ta.setSelectionRange(ta.value.length, ta.value.length); form.classList.remove('nudge'); void form.offsetWidth; form.classList.add('nudge'); return; }
      ta.value = v && goal ? `${v}\n\n${W.goalLine.replace('{goal}', W.goals[goal][0])}` : v;
      if (!v) ta.disabled = true; // no idea yet: open /start without an empty ?idea=
      // The references ride along as ref= (one per link); the "what should be different" line is the change= field.
      const extra = refs.map((r) => { const h = document.createElement('input'); h.type = 'hidden'; h.name = 'ref'; h.value = r.url; form.appendChild(h); return h; });
      track('idea_submit', { location: form.dataset.phLocation, has_idea: !!v, length: v.length, goal: goal || undefined, refs: refs.length || undefined });
      setTimeout(() => { ta.disabled = false; ta.value = v0; extra.forEach((h) => h.remove()); }, 0);
    });
  });
</script>
