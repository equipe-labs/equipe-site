---
// "What business do you want to run?" — the idea box that starts sign-up, the same composer as app.equipe.im/new.
// It is a plain GET form to app.equipe.im/start?idea=<text>, so it works without JavaScript; the script adds the
// growing box, example businesses rotating in the placeholder (still under reduced motion), Enter-to-send, Tab to
// take the example shown, and the goals. A goal never replaces typing: on an empty box it starts a sentence the person
// finishes, and it goes with the idea as one last line ("Goal: Sell my service online") for the PM. "Bring my existing
// site" opens the app's import. app.equipe.im keeps the idea as a draft, shows it on the sign-in page and carries it
// into team creation. `big`: the hero version (large rounded surface, + to bring a project, round send button).
import { SITE } from '../data/site';
import { getMessages, type LocaleCode } from '../i18n';

interface Props { code: LocaleCode; id: string; location: string; big?: boolean }
const { code, id, location, big = false } = Astro.props;
const m = getMessages(code);
const p = m.prompt;
const sv = (d: string) => `<svg viewBox="0 0 24 24" aria-hidden="true">${d}</svg>`;
// Lucide shapes (ISC): store, briefcase, credit card, graduation cap, globe.
const GI: Record<string, string> = {
  local: sv('<path d="M3 9.5 4.5 4h15L21 9.5"/><path d="M3 9.5a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0"/><path d="M5 12v8h14v-8"/><path d="M10 20v-5h4v5"/>'),
  service: sv('<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M3 13h18"/>'),
  app: sv('<rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="M2.5 10h19"/><path d="M6.5 15h4"/>'),
  expert: sv('<path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c3 2.5 9 2.5 12 0v-5"/>'),
  site: sv('<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a14 14 0 0 1 0 18 14 14 0 0 1 0-18Z"/>'),
};
const words = { ex: p.examples, goals: Object.fromEntries(p.goals.map((g) => [g.key, [g.label, g.starter]])), goalLine: p.goalLine, goalRemove: p.goalRemove };
---
<form class={`idea${big ? ' big' : ''}`} action={SITE.start} method="get" data-idea data-ph-location={location} data-words={JSON.stringify(words)}>
  <label class={big ? 'sr-only' : 'idea-l'} for={id}>{p.label}</label>
  <div class="idea-box">
    {big && <kbd class="idea-tab" aria-hidden="true">Tab</kbd>}
    <div class="idea-in">
      <textarea id={id} name="idea" rows="3" maxlength="2000" placeholder=" " enterkeyhint="send"></textarea>
      <span class="idea-ph" aria-hidden="true">{p.examples[0]}</span>
    </div>
    <div class="idea-bar">
      {big ? (
        <>
          <div class="idea-l2">
            <a class="idea-plus" href={SITE.importProject} aria-label={p.import} title={p.import} data-ph="import_click" data-ph-location={location}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
            </a>
            <span class="idea-gslot" data-gslot></span>
          </div>
          <button class="idea-send" type="submit" aria-label={p.submit} data-send><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M5.5 11.5L12 5l6.5 6.5" /></svg></button>
        </>
      ) : (
        <>
          <span class="idea-gslot" data-gslot></span>
          <button class="btn primary idea-go" type="submit"><span>{p.submit}</span><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
        </>
      )}
    </div>
  </div>
  <div class="idea-goals" role="group" aria-label={p.goalsLabel}>
    <span class="idea-gl">{p.goalsLabel}</span>
    {p.goals.map((g, i) => <button type="button" class="idea-goal" data-goal={g.key} aria-pressed="false" style={`--i:${i}`}><Fragment set:html={GI[g.key]} /><span>{g.label}</span></button>)}
    <a class="idea-goal site" href={SITE.importProject} data-ph="import_click" data-ph-location={location} style={`--i:${p.goals.length}`}><Fragment set:html={GI.site} /><span>{p.siteGoal}</span></a>
  </div>
  <p class="idea-next"><span class="nl">{p.nextLabel}</span>{p.steps.map((s, i) => <>{i > 0 && <svg class="sep" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>}<span>{s}</span></>)}</p>
  <p class="idea-note">{p.note}</p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-idea]').forEach((form) => {
    const ta = form.querySelector('textarea')!;
    const ph = form.querySelector<HTMLElement>('.idea-ph')!;
    const slot = form.querySelector<HTMLElement>('[data-gslot]')!;
    const W: { ex: string[]; goals: Record<string, [string, string]>; goalLine: string; goalRemove: string } = JSON.parse(form.dataset.words || '{}');
    const track = (n: string, props?: Record<string, unknown>) => (window as unknown as { eqTrack?: (n: string, p?: unknown) => void }).eqTrack?.(n, props);
    const send = form.querySelector<HTMLElement>('[data-send]');
    const esc = (x: string) => x.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
    // Grow with the text up to about seven lines, then scroll inside; the send button looks idle while the box is empty.
    const fit = () => {
      ta.style.height = 'auto';
      const lh = parseFloat(getComputedStyle(ta).lineHeight) || 26;
      const max = lh * 7 + 30;
      ta.style.height = Math.min(ta.scrollHeight, max) + 'px';
      ta.style.overflowY = ta.scrollHeight > max ? 'auto' : 'hidden';
      send?.classList.toggle('idle', !ta.value.trim());
      form.classList.toggle('empty', !ta.value);
    };
    // Goals: one at a time, tap again to clear. On an empty box (or one holding only another goal's sentence start) the
    // sentence start goes in, caret at its end; what the person already typed is never replaced.
    let goal = '', starter = '';
    const setGoal = (k: string) => {
      goal = k;
      form.querySelectorAll<HTMLElement>('.idea-goal[data-goal]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.goal === goal)));
      const untouched = !ta.value.trim() || (starter && ta.value === starter);
      if (untouched) { starter = goal ? W.goals[goal][1] : ''; ta.value = starter; if (goal) { ta.focus(); ta.setSelectionRange(ta.value.length, ta.value.length); } }
      else if (!goal) starter = '';
      const g = goal ? W.goals[goal] : null;
      slot.innerHTML = g ? `<span class="idea-gchip">${form.querySelector(`.idea-goal[data-goal="${goal}"] svg`)?.outerHTML || ''}<span>${esc(g[0])}</span><button type="button" aria-label="${esc(W.goalRemove)}" title="${esc(W.goalRemove)}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></button></span>` : '';
      slot.querySelector('button')?.addEventListener('click', () => { setGoal(''); ta.focus(); });
      fit();
      if (goal) track('idea_goal', { location: form.dataset.phLocation, goal });
    };
    form.querySelectorAll<HTMLButtonElement>('.idea-goal[data-goal]').forEach((b) => b.addEventListener('click', () => setGoal(goal === b.dataset.goal ? '' : b.dataset.goal!)));
    ta.addEventListener('input', () => { fit(); if (goal && starter && !ta.value.trim()) setGoal(''); });
    fit();
    // Tab takes the example shown, only while the box is empty; otherwise Tab moves focus as usual (no focus trap).
    let pi = 0;
    ta.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab' || e.shiftKey || e.altKey || e.ctrlKey || e.metaKey || ta.value) return;
      e.preventDefault();
      ta.value = W.ex[pi] || '';
      fit();
      ta.setSelectionRange(ta.value.length, ta.value.length);
      track('idea_tab_accept', { location: form.dataset.phLocation });
    });
    // Enter sends, Shift+Enter adds a line; never while an input method (Korean, Japanese, Chinese) is composing.
    ta.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey && !e.isComposing && e.keyCode !== 229) { e.preventDefault(); form.requestSubmit(); }
    });
    form.classList.add('sug');
    // Example businesses rotate in the placeholder while the box is empty and on screen (motion allowed only).
    if (document.documentElement.classList.contains('mo') && W.ex.length > 1) {
      let visible = false;
      new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(form);
      setInterval(() => {
        if (!visible || document.hidden || ta.value) return;
        ph.classList.add('out');
        setTimeout(() => { pi = (pi + 1) % W.ex.length; ph.textContent = W.ex[pi]; ph.classList.remove('out'); ph.classList.add('pre'); void ph.offsetWidth; ph.classList.remove('pre'); }, 280);
      }, 3600);
    }
    form.addEventListener('submit', (e) => {
      const v = ta.value.trim();
      // Only a goal's sentence start, not finished: stay, with the caret where the person writes next.
      if (goal && starter && v === starter.trim()) { e.preventDefault(); ta.focus(); ta.setSelectionRange(ta.value.length, ta.value.length); form.classList.remove('nudge'); void form.offsetWidth; form.classList.add('nudge'); return; }
      ta.value = v && goal ? `${v}\n\n${W.goalLine.replace('{goal}', W.goals[goal][0])}` : v;
      if (!v) ta.disabled = true; // no idea yet: open /start without an empty ?idea=
      track('idea_submit', { location: form.dataset.phLocation, has_idea: !!v, length: v.length, goal: goal || undefined });
      setTimeout(() => { ta.disabled = false; ta.value = v; }, 0);
    });
  });
</script>
