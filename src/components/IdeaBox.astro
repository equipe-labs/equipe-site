---
// "What do you want to build?" — the idea box that starts sign-up. It is a plain GET form to app.equipe.im/start?idea=<text>,
// so it works without JavaScript; the script adds Enter-to-send, the example chips/menu, the typing placeholder and drops an empty idea.
// app.equipe.im keeps the idea as a draft, shows it on the sign-in page and carries it into team creation.
// `big`: the hero version (large rounded surface, + to bring a project, round send button, chips below). No member picker:
// a first-time visitor talks to one team chat and the PM routes the work, so there is no choice to make here.
import { SITE } from '../data/site';
import { getMessages, type LocaleCode } from '../i18n';

interface Props { code: LocaleCode; id: string; location: string; big?: boolean }
const { code, id, location, big = false } = Astro.props;
const m = getMessages(code);
const p = m.prompt;
---
<form class={`idea${big ? ' big' : ''}`} action={SITE.start} method="get" data-idea data-ph-location={location} data-examples={JSON.stringify(p.examples)}>
  <label class={big ? 'sr-only' : 'idea-l'} for={id}>{p.label}</label>
  <div class="idea-box">
    {big && <kbd class="idea-tab" aria-hidden="true">Tab</kbd>}
    <textarea id={id} name="idea" rows={big ? 3 : 3} maxlength="2000" placeholder={p.placeholder} enterkeyhint="send"></textarea>
    <div class="idea-bar">
      {big ? (
        <>
          <div class="idea-l2">
            <a class="idea-plus" href={SITE.importProject} aria-label={p.import} title={p.import} data-ph="import_click" data-ph-location={location}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
            </a>
          </div>
          <button class="idea-send" type="submit" aria-label={p.submit} data-send><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M5.5 11.5L12 5l6.5 6.5" /></svg></button>
        </>
      ) : (
        <>
          <div class="idea-ex" role="group" aria-label={p.label}>
            {p.examples.map((x) => <button type="button" data-ex={x}>{x}</button>)}
          </div>
          <button class="btn primary idea-go" type="submit"><span>{p.submit}</span><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
        </>
      )}
    </div>
  </div>
  {big && <div class="idea-chips" role="group" aria-label={p.label}>{p.examples.map((x) => <button type="button" data-ex={x}>{x}</button>)}</div>}
  <p class="idea-note">{p.note}</p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-idea]').forEach((form) => {
    const ta = form.querySelector('textarea')!;
    const track = (n: string, props?: Record<string, unknown>) => (window as unknown as { eqTrack?: (n: string, p?: unknown) => void }).eqTrack?.(n, props);
    const send = form.querySelector<HTMLElement>('[data-send]');
    // Grow with the text up to about six lines; the send button looks idle while the box is empty.
    const fit = () => {
      if (form.classList.contains('big')) { ta.style.height = 'auto'; const lh = parseFloat(getComputedStyle(ta).lineHeight) || 26; ta.style.height = Math.min(ta.scrollHeight, lh * 6 + 30) + 'px'; }
      send?.classList.toggle('idle', !ta.value.trim());
      form.classList.toggle('empty', !ta.value);
    };
    ta.addEventListener('input', fit); fit();
    form.querySelectorAll<HTMLButtonElement>('[data-ex]').forEach((b) => b.addEventListener('click', () => { ta.value = b.dataset.ex!; fit(); ta.focus(); }));
    // The resting placeholder is a plain prompt ("Describe your idea…"), never an example: the examples live on the chips.
    // `suggestion` is the example currently typed into the placeholder (always the full text, never a half-typed frame);
    // empty until the typing starts, so Tab never pastes the plain prompt and the Tab hint stays hidden.
    const base = ta.placeholder;
    let suggestion = '';
    const setSug = (v: string) => { suggestion = v; form.classList.toggle('sug', !!v); };
    // Tab accepts it, only while the box is empty; otherwise Tab moves focus as usual (no focus trap).
    ta.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab' || e.shiftKey || e.altKey || e.ctrlKey || e.metaKey || ta.value || !suggestion) return;
      e.preventDefault();
      ta.value = suggestion;
      ta.placeholder = base;
      fit();
      ta.setSelectionRange(ta.value.length, ta.value.length);
      track('idea_tab_accept', { location: form.dataset.phLocation });
    });
    // Enter sends, Shift+Enter adds a line; never while an input method (Korean, Japanese, Chinese) is composing.
    ta.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey && !e.isComposing && e.keyCode !== 229) { e.preventDefault(); form.requestSubmit(); }
    });
    // The placeholder types out example ideas in turn (motion allowed only); it stops while the box has focus or text.
    if (document.documentElement.classList.contains('mo')) {
      const ex: string[] = JSON.parse(form.dataset.examples || '[]');
      let i = 0, n = 0, dir = 1, wait = 0, visible = false;
      new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(form);
      setInterval(() => {
        // Focused and empty: hold the full suggestion still, so Tab accepts exactly what is shown.
        if (!visible || document.activeElement === ta || ta.value) { if (document.activeElement === ta && !ta.value && suggestion && ta.placeholder !== suggestion) ta.placeholder = suggestion; return; }
        if (wait > 0) { wait--; return; }
        const w = ex[i] ?? base;
        setSug(w);
        n += dir;
        ta.placeholder = w.slice(0, Math.max(0, n)) + (dir > 0 ? '|' : '');
        if (dir > 0 && n >= w.length) { ta.placeholder = w; dir = -1; wait = 28; }
        else if (dir < 0 && n <= 0) { dir = 1; i = (i + 1) % ex.length; wait = 4; }
      }, 55);
    }
    form.addEventListener('submit', () => {
      const v = ta.value.trim();
      ta.value = v;
      if (!v) ta.disabled = true; // no idea yet: open /start without an empty ?idea=
      track('idea_submit', { location: form.dataset.phLocation, has_idea: !!v, length: v.length });
      setTimeout(() => (ta.disabled = false), 0);
    });
  });
</script>
