---
// The home page, for non-developers: a startup team for one person, in the cloud. Developer content lives on /developers.
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Mark from '../components/Mark.astro';
import WebApp from '../components/WebApp.astro';
import EarlyAccess from '../components/EarlyAccess.astro';
import Analytics from '../components/Analytics.astro';
import LangBanner from '../components/LangBanner.astro';
import OrganizationJsonLd from '../components/OrganizationJsonLd.astro';
import WebSiteJsonLd from '../components/WebSiteJsonLd.astro';
import FaqJsonLd from '../components/FaqJsonLd.astro';
import WebApplicationJsonLd from '../components/WebApplicationJsonLd.astro';
import '../styles/site.css';
import '../styles/webapp.css';
import '../styles/home.css';
import { SITE } from '../data/site';
import { available, getLocale, getMessages, localePath, subPath, type LocaleCode } from '../i18n';

// One page per language that has a src/i18n/<code>.ts file. English lives at `/`, the rest at `/<slug>/`.
export function getStaticPaths() {
  return available.map((l) => ({ params: { locale: l.slug || undefined }, props: { code: l.code } }));
}

const { code } = Astro.props as { code: LocaleCode };
const info = getLocale(code);
const t = getMessages(code);
const s = t.scene;
const pageUrl = new URL(localePath(info), Astro.site).href;
// How-it-works scenes, in step order. Step 4 (usage reports and proposals) is not shipped yet.
const howScenes = ['chat', 'team', 'decision', 'growth'] as const;
const howSoon = [false, false, false, true];
// Where we are: one state per item.
const statusState = ['now', 'early', 'soon'] as const;
const roleKeys = ['pm', 'eng', 'design', 'qa', 'data'] as const;
const roleIcon: Record<string, string> = {
  pm: 'M5 20V5h11l-2 4 2 4H5',
  eng: 'M9 7l-5 5 5 5M15 7l5 5-5 5',
  design: 'M4 20l4-1 11-11-3-3L5 16zM14 7l3 3',
  qa: 'M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6zM8.5 12l2.5 2.5 4.5-5',
  data: 'M5 20V11M12 20V5M19 20v-6',
};
const check = 'M5 12.5l4.5 4.5L19 7.5';
const faqMore = t.faq.more.split('{email}');
---

<Base locale={code} title={t.meta.title} description={t.meta.description} ogTitle={t.meta.ogTitle} ogDescription={t.meta.ogDescription} image={`/og/${info.slug || 'en'}.png`} imageAlt={t.meta.ogImageAlt}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://app.equipe.im" crossorigin />
    <script is:inline>
      // Scroll motion is opt-in: blocks are hidden only once this class is set, and only if the visitor allows motion.
      // If the script that reveals them never runs, the class is dropped after 3 s and everything shows.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('mo');
        setTimeout(function () { if (!window.__rv) document.documentElement.classList.remove('mo'); }, 3000);
      }
    </script>
    <OrganizationJsonLd />
    <WebSiteJsonLd lang={info.lang} url={pageUrl} description={t.meta.description} />
    <WebApplicationJsonLd lang={info.lang} url={pageUrl} description={t.meta.description} featureList={t.team.roles.map((r) => `${r.name}: ${r.text}`)} />
    <FaqJsonLd lang={info.lang} faqs={t.faq.items} />
  </Fragment>

  <a class="skip" href="#main">{t.ui.skip}</a>
  <SiteHeader code={code} page="home" />

  <main id="main" class="home">
    <section class="hero">
      <div class="wrap top">
        <div class="hl">
          <p class="badge"><i></i>{t.hero.badge}</p>
          <h1>{t.hero.title.split('\n').map((l, i) => <>{i > 0 && <>{' '}<br class="hb" /></>}{l}</>)}</h1>
        </div>
        <div class="hr">
          <p class="lead">{t.hero.lead}</p>
          <p class="approve">{t.hero.approve}</p>
          <div class="acts">
            <a class="btn primary lg" href="#early-access" data-ph="early_access_cta_click" data-ph-location="hero">{t.hero.cta}</a>
            <a class="btn ghost lg" href="#how-it-works">{t.hero.secondary}</a>
          </div>
          <p class="meta">{t.hero.meta}</p>
        </div>
      </div>
      <div class="wrap shot">
        <WebApp k="hero" s={s} alt={t.hero.shotAlt} />
        <p class="cap">{t.hero.caption}</p>
      </div>
    </section>

    <section class="wedge" id="from-claude">
      <div class="wrap">
        <div class="head rv">
          <p class="kicker">{t.wedge.kicker}</p>
          <h2>{t.wedge.title}</h2>
          <p class="sub">{t.wedge.text}</p>
        </div>
        <div class="rv"><WebApp k="import" s={s} alt={t.wedge.alt} /></div>
        <ol class="wsteps rv">
          {t.wedge.steps.map((st, i) => <li><span class="n">{i + 1}</span><h3>{st.title}</h3><p>{st.text}</p></li>)}
        </ol>
        <div class="handled rv">
          <div>
            <h3>{t.wedge.handledTitle}</h3>
            <ul>{t.wedge.handled.map((h) => <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d={check} /></svg>{h}</li>)}</ul>
          </div>
          <p class="never">{t.wedge.never}</p>
        </div>
        <p class="honest rv"><span class="soon">{t.ui.soon}</span><span>{t.wedge.note}</span></p>
      </div>
    </section>

    <section class="how" id="how-it-works">
      <div class="wrap">
        <div class="head rv">
          <p class="kicker">{t.nav.how}</p>
          <h2>{t.how.title}</h2>
          <p class="sub">{t.how.text}</p>
        </div>
        <ol class="rail rv" aria-hidden="true">
          {t.how.steps.map((st, i) => <li class={howSoon[i] ? 'is-soon' : undefined}><a href={`#step-${i + 1}`} tabindex="-1"><span class="n">{String(i + 1).padStart(2, '0')}</span><span class="t">{st.title}</span></a></li>)}
        </ol>
        <ol class="steps">
          {t.how.steps.map((st, i) => (
            <li class={`step${i % 2 ? ' rev' : ''}`} id={`step-${i + 1}`}>
              <div class="txt rv">
                <p class="lab"><span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{howSoon[i] && <span class="soon">{t.ui.soon}</span>}</p>
                <h3>{st.title}</h3>
                <p>{st.text}</p>
              </div>
              <div class="vis rv">
                <div class="stage"><WebApp k={howScenes[i]} s={s} alt={st.alt} /></div>
                <p class="cap">{st.caption}</p>
              </div>
            </li>
          ))}
        </ol>
        <div class="howcta rv"><a class="btn primary lg" href="#early-access" data-ph="early_access_cta_click" data-ph-location="how">{t.hero.cta}</a></div>
      </div>
    </section>

    <section class="team" id="team">
      <div class="wrap">
        <div class="head rv">
          <p class="kicker">{t.nav.team}</p>
          <h2>{t.team.title}</h2>
          <p class="sub">{t.team.text}</p>
        </div>
        <ul class="roles rv">
          {t.team.roles.map((r, i) => (
            <li class={`role r-${roleKeys[i]}`}>
              <span class="ri" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={roleIcon[roleKeys[i]]} /></svg></span>
              <h3>{r.name}</h3>
              <p>{r.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="compare">
      <div class="wrap">
        <h2 class="rv">{t.compare.title}</h2>
        <div class="cmp rv">
          <div class="cl">
            <h3>{t.compare.left.name}</h3>
            <ul>{t.compare.left.items.map((x) => <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7l10 10M17 7L7 17" /></svg>{x}</li>)}</ul>
          </div>
          <div class="cr">
            <h3><Mark size={22} />{t.compare.right.name}</h3>
            <ul>{t.compare.right.items.map((x) => <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d={check} /></svg>{x}</li>)}</ul>
          </div>
        </div>
        <div class="outcome rv">
          <ul>{t.compare.outcome.map((o, i) => <li><span class="on" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{o}</li>)}</ul>
          <a class="btn primary" href="#early-access" data-ph="early_access_cta_click" data-ph-location="compare">{t.hero.cta}</a>
        </div>
      </div>
    </section>

    <section class="control">
      <div class="wrap">
        <div class="cgrid">
          <div class="rv">
            <h2>{t.control.title}</h2>
            <p class="sub">{t.control.text}</p>
            <ul class="pts">
              {t.control.points.map((p) => <li><h3>{p.lead}</h3><p>{p.text}</p></li>)}
            </ul>
            <p class="honest"><span class="soon">{t.ui.soon}</span><span>{t.control.note}</span></p>
          </div>
          <div class="cvis rv">
            <WebApp k="cost" s={s} alt={t.control.alt} />
          </div>
        </div>
      </div>
    </section>

    <section class="who">
      <div class="wrap">
        <h2 class="rv">{t.who.title}</h2>
        <ul class="wcards rv">
          {t.who.items.map((w) => <li><h3>{w.title}</h3><p>{w.text}</p></li>)}
        </ul>
      </div>
    </section>

    <section class="status" id="status">
      <div class="wrap">
        <div class="head rv">
          <h2>{t.status.title}</h2>
          <p class="sub">{t.status.text}</p>
        </div>
        <ol class="track rv">
          {t.status.items.map((it, i) => (
            <li class={`is-${statusState[i]}`}>
              <span class="dot" aria-hidden="true"></span>
              <span class="lbl">{t.status.labels[statusState[i]]}</span>
              <h3>{it.title}</h3>
              <p>{it.text}</p>
            </li>
          ))}
        </ol>
        <div class="proof rv">
          <h3>{t.proof.title}</h3>
          <dl>{t.proof.nums.map((n) => <div><dt>{n.n}</dt><dd>{n.label}</dd></div>)}</dl>
          <p class="meta">{t.proof.small}</p>
        </div>
      </div>
    </section>

    <section class="faq" id="faq">
      <div class="wrap">
        <div class="fq">
          <div class="fqh rv">
            <h2>{t.faq.title}</h2>
            <p class="more">{faqMore[0]}<a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a>{faqMore[1]}</p>
          </div>
          <div class="faqs rv">
            {t.faq.items.map((f, i) => (
              <details data-faq-id={`faq-${i + 1}`} open={i === 0}>
                <summary><h3>{f.question}</h3></summary>
                <p>{f.answer}{i === t.faq.items.length - 1 && <> <a href={subPath(info, 'developers')} data-ph="developers_link_click" data-ph-location="faq">{t.faq.devLink} →</a></>}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="early" id="early-access">
      <div class="wrap">
        <div class="egrid">
          <div class="etxt">
            <p class="badge"><i></i>{t.hero.badge}</p>
            <h2>{t.form.title}</h2>
            <p class="sub">{t.form.text}</p>
            <ol class="ea-next">{t.form.next.map((n, i) => <li><span>{i + 1}</span>{n}</li>)}</ol>
          </div>
          <div class="ecard"><EarlyAccess code={code} /></div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter code={code} page="home" />
  <Analytics />
  <LangBanner locale={code} />

  <script>
    // Scroll motion: blocks fade up as they arrive. A scroll sweep (not only an observer) means blocks jumped over
    // by a fast scroll, an anchor link or a restored scroll position are shown too, never left as an empty area.
    if (document.documentElement.classList.contains('mo')) {
      (window as unknown as { __rv: boolean }).__rv = true;
      const pending = new Set(document.querySelectorAll<HTMLElement>('main.home .rv'));
      const sweep = () => {
        const line = window.innerHeight * 0.92;
        pending.forEach((el) => { if (el.getBoundingClientRect().top < line) { el.classList.add('in'); pending.delete(el); } });
      };
      let raf = 0;
      const queue = () => { if (!raf) raf = requestAnimationFrame(() => { raf = 0; sweep(); }); };
      addEventListener('scroll', queue, { passive: true });
      addEventListener('resize', queue);
      addEventListener('hashchange', queue);
      addEventListener('beforeprint', () => { pending.forEach((el) => el.classList.add('in')); pending.clear(); });
      sweep();
    }
  </script>
</Base>
