---
// The home page, for non-developers: a startup team for one person, in the cloud. Developer content lives on /developers.
// Nine blocks, each saying one thing once (landing audit P0-3, 2026-11-28): hero (idea box + customer logos), product demo,
// three steps, real products, customer proof, why it is different (day one), a pricing teaser in credits (dollars live on
// /pricing), FAQ, start. "From Claude" is a link in step 1 and has its own page; "where we are" lives on /facts and the FAQ.
// Section patterns were studied on 21st.dev (workflow hero, bento grid, how-it-works rail, marquee, pricing with a featured plan,
// call-to-action) and rewritten here as plain Astro + CSS with our tokens: no React, no new dependencies.
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Mark from '../components/Mark.astro';
import IdeaBox from '../components/IdeaBox.astro';
import Gallery from '../components/Gallery.astro';
import Analytics from '../components/Analytics.astro';
import LangBanner from '../components/LangBanner.astro';
import OrganizationJsonLd from '../components/OrganizationJsonLd.astro';
import WebSiteJsonLd from '../components/WebSiteJsonLd.astro';
import FaqJsonLd from '../components/FaqJsonLd.astro';
import WebApplicationJsonLd from '../components/WebApplicationJsonLd.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import CustomerLogos from '../components/CustomerLogos.astro';
import DayOne from '../components/DayOne.astro';
import HomeDemo from '../components/HomeDemo.astro';
import HomeProof from '../components/HomeProof.astro';
import { HOME } from '../data/home';
import { MIGRATE } from '../data/migrate';
import '../styles/site.css';
import '../styles/webapp.css';
import '../styles/iphone.css';
import '../styles/home.css';
import '../styles/sections.css';
import '../styles/motion.css';
import '../styles/home9.css';
import { SITE } from '../data/site';
import { available, getLocale, getMessages, localePath, subPath, type LocaleCode } from '../i18n';

// One page per language that has a src/i18n/<code>.ts file. English lives at `/`, the rest at `/<slug>/`.
export function getStaticPaths() {
  return available.map((l) => ({ params: { locale: l.slug || undefined }, props: { code: l.code } }));
}

const { code } = Astro.props as { code: LocaleCode };
const info = getLocale(code);
const t = getMessages(code);
const H = HOME[code];
const pageUrl = new URL(localePath(info), Astro.site).href;
const faqMore = t.faq.more.split('{email}');
---

<Base locale={code} title={t.meta.title} description={t.meta.description} ogTitle={t.meta.ogTitle} ogDescription={t.meta.ogDescription} image={`/og/v4/${info.slug || 'en'}.png`} imageAlt={t.meta.ogImageAlt}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://app.equipe.im" crossorigin />
    <script is:inline>
      // Motion is opt-in: blocks are hidden only once this class is set, and only if the visitor allows motion.
      // If the script that reveals them never runs, the class is dropped after 3 s and everything shows.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('mo');
        setTimeout(function () { if (!window.__rv) document.documentElement.classList.remove('mo'); }, 3000);
      }
    </script>
    <OrganizationJsonLd />
    <WebSiteJsonLd lang={info.lang} url={pageUrl} description={t.meta.description} />
    <WebApplicationJsonLd lang={info.lang} url={pageUrl} description={t.meta.description} featureList={t.team.roles.map((r) => `${r.name}: ${r.text}`)} />
    <FaqJsonLd lang={info.lang} faqs={t.faq.items} />
  </Fragment>

  <a class="skip" href="#main">{t.ui.skip}</a>
  <SiteHeader code={code} page="home" />

  <main id="main" class="home">
    <section class="hero">
      <div class="wrap hc">
        <h1 class="ld" style="--d:0">{t.hero.title.split('\n').map((l, i) => <>{i > 0 && <>{' '}<br class="hb" /></>}{l}</>)}</h1>
        <p class="hsub ld" style="--d:1">{t.hero.approve}</p>
        <div class="hbox ld" style="--d:2"><IdeaBox code={code} id="idea-hero" location="hero" big /></div>
      </div>
    </section>

    <section class="logos" aria-labelledby="trust-home">
      <div class="wrap"><CustomerLogos code={code} id="trust-home" class="ltrust" proof /></div>
    </section>

    <HomeDemo code={code} />

    <section class="flow steps3" id="how-it-works">
      <div class="wrap">
        <div class="head center rv">
          <p class="kicker">{t.nav.how}</p>
          <h2>{t.flow.title}</h2>
        </div>
        <ol class="s3">
          {t.flow.steps.map((st, i) => (
            <li class="s3-c rv" style={`--i:${i}`}>
              <span class="s3-n" aria-hidden="true">{i + 1}</span>
              <h3>{st.title}</h3>
              <p>{st.text}</p>
              {i === 0 && <a class="s3-more" href={subPath(info, 'from-claude')} data-ph="from_claude_link_click" data-ph-location="home_steps">{H.steps.claude}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>}
            </li>
          ))}
        </ol>
        <div class="fcta rv"><a class="btn primary lg" href={SITE.start} data-ph="signup_cta_click" data-ph-location="how">{t.hero.cta}</a></div>
      </div>
    </section>

    <Gallery code={code} />

    <HomeProof code={code} />

    <DayOne code={code} />

    <section class="pricing ptease" id="pricing">
      <div class="wrap">
        <div class="head center rv">
          <p class="kicker">{H.price.kicker}</p>
          <h2>{H.price.title}</h2>
          <p class="sub">{H.price.sub}</p>
        </div>
        <ul class="pt3" role="list">
          {H.price.cards.map((c, i) => (
            <li class="pt3-c rv" style={`--i:${i}`}>
              <span class="pt3-i" aria-hidden="true">{i === 0 ? <svg viewBox="0 0 24 24"><path d="M20 12v8a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-8M2.5 7.5h19v4.5h-19zM12 21V7.5" /></svg> : i === 1 ? <svg viewBox="0 0 24 24"><path d="M12 3l2.4 5.3 5.6.6-4.2 3.8 1.2 5.6L12 15.6l-5 2.7 1.2-5.6L4 8.9l5.6-.6z" /></svg> : <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg>}</span>
              <h3>{c.title}</h3>
              <p>{c.text}</p>
            </li>
          ))}
        </ul>
        <div class="fcta rv"><a class="btn ghost lg" href={subPath(info, 'pricing')} data-ph="pricing_link_click" data-ph-location="home_pricing">{H.price.link}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a></div>
      </div>
    </section>

    <section class="faq" id="faq">
      <div class="wrap">
        <div class="fq">
          <div class="fqh rv">
            <h2>{t.faq.title}</h2>
            <p class="more">{faqMore[0]}<a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a>{faqMore[1]}</p>
          </div>
          <div class="faqs rv">
            {t.faq.items.map((f, i) => (
              <details data-faq-id={`faq-${i + 1}`} open={i === 0}>
                <summary><h3>{f.question}</h3></summary>
                <p>{f.answer}{i === 1 && <> <a href={subPath(info, 'migrate')} data-ph="migrate_link_click" data-ph-location="faq">{(MIGRATE[code] ?? MIGRATE.en).homeLink} →</a></>}{i === t.faq.items.length - 1 && <> <a href={subPath(info, 'developers')} data-ph="developers_link_click" data-ph-location="faq">{t.faq.devLink} →</a></>}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="early final" id="start">
      <span id="early-access" aria-hidden="true"></span>
      <div class="wrap">
        <div class="fin rv">
          <span class="fin-mark" aria-hidden="true"><Mark size={44} /></span>
          <h2>{t.band.title}</h2>
          <p class="sub">{t.band.text}</p>
          <div class="fbox"><IdeaBox code={code} id="idea-band" location="band" big /></div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter code={code} page="home" />
  <Analytics />
  <LangBanner locale={code} />
  <ConsentBanner code={code} />

  <script>
    // Motion, all gated on html.mo (set in <head> only when the visitor allows motion):
    // - blocks fade up as they enter (IntersectionObserver; anything already on screen shows at once)
    // - drawn scenes get `.live` while on screen, so their loops only run when someone can see them
    // - numbers with data-tick count up once, the first time they are seen
    const root = document.documentElement;
    if (root.classList.contains('mo')) {
      (window as unknown as { __rv: boolean }).__rv = true;
      const reveal = new IntersectionObserver((es) => es.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('in'); reveal.unobserve(e.target); }
      }), { rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('main.home .rv, footer .rv').forEach((el) => reveal.observe(el));
      addEventListener('beforeprint', () => document.querySelectorAll('.rv').forEach((el) => el.classList.add('in')));

      const tickOnce = (box: Element) => box.querySelectorAll<HTMLElement>('[data-tick]').forEach((el) => {
        if (el.dataset.done) return; el.dataset.done = '1';
        const end = Number(String(el.dataset.tick).replace(/[^\d.]/g, '')); if (!end) return;
        const dec = Number(el.dataset.dec || 0), pre = el.dataset.prefix ?? '', suf = el.dataset.suffix ?? '';
        const t0 = performance.now(), D = 1200;
        const step = (now: number) => {
          const p = Math.min(1, (now - t0) / D), v = end * (1 - (1 - p) ** 3);
          el.textContent = pre + v.toFixed(dec) + suf;
          if (p < 1) requestAnimationFrame(step); else el.textContent = pre + end.toFixed(dec) + suf;
        };
        requestAnimationFrame(step);
      });
      const live = new IntersectionObserver((es) => es.forEach((e) => {
        e.target.classList.toggle('live', e.isIntersecting);
        if (e.isIntersecting) tickOnce(e.target);
      }), { threshold: 0.25 });
      document.querySelectorAll('.wa-fig, .proof').forEach((el) => live.observe(el));

    }
  </script>
</Base>
