---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import shot from '../assets/desktop-tickets.png';
import Mark from '../components/Mark.astro';
import LangMenu from '../components/LangMenu.astro';
import Rich from '../components/Rich.astro';
import Analytics from '../components/Analytics.astro';
import LangBanner from '../components/LangBanner.astro';
import OrganizationJsonLd from '../components/OrganizationJsonLd.astro';
import WebSiteJsonLd from '../components/WebSiteJsonLd.astro';
import SoftwareApplicationJsonLd from '../components/SoftwareApplicationJsonLd.astro';
import FaqJsonLd from '../components/FaqJsonLd.astro';
import { SITE } from '../data/site';
import { available, getLocale, getMessages, localePath, subPath, type LocaleCode } from '../i18n';

// One page per language that has a src/i18n/<code>.ts file. English lives at `/`, the rest at `/<slug>/`.
export function getStaticPaths() {
  return available.map((l) => ({ params: { locale: l.slug || undefined }, props: { code: l.code } }));
}

const { code } = Astro.props as { code: LocaleCode };
const info = getLocale(code);
const t = getMessages(code);
const pageUrl = new URL(localePath(info), Astro.site).href;

const install = 'curl -fsSL https://github.com/equipe-labs/equipe/releases/latest/download/install.sh | sh';
const brew = 'brew install equipe-labs/tap/equipe';
// The FAQ answer about installing is short and links to Get started, so the commands live in one place.
const installFaq = 4;
const tryIt = 'equipe try --edit "…"';
---

<Base locale={code} title={t.meta.title} description={t.meta.description} ogTitle={t.meta.ogTitle} ogDescription={t.meta.ogDescription} image={`/og/${info.slug || 'en'}.png`} imageAlt={t.meta.ogImageAlt}>
  <Fragment slot="head">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <OrganizationJsonLd />
    <WebSiteJsonLd lang={info.lang} url={pageUrl} description={t.meta.description} />
    <SoftwareApplicationJsonLd lang={info.lang} url={pageUrl} description={t.meta.description} featureList={t.features.items.map((f) => f.title)} />
    <FaqJsonLd lang={info.lang} faqs={t.faq.items} />
  </Fragment>

  <a class="skip" href="#main">{t.ui.skip}</a>
  <header class="site">
    <div class="wrap">
      <a class="brand" href={localePath(info)}><Mark size={28} /> equipe</a>
      <nav aria-label={t.ui.primaryNav}>
        <ul>
          <li class="opt"><a href="#how-it-works">{t.nav.howItWorks}</a></li>
          <li class="opt"><a href="#get-started">{t.nav.getStarted}</a></li>
          <li class="opt"><a href="#faq">{t.nav.faq}</a></li>
          <li><a href={SITE.repo} data-ph="cta_github_click" data-ph-location="header">{t.nav.github}</a></li>
          <li><LangMenu locale={code} label={t.ui.language} /></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    <section class="hero home">
      <div class="wrap">
        <div class="col">
          <h1>{t.hero.title}</h1>
          <p class="lead">{t.hero.lead}</p>
          <div class="hero-download">
            <a class="btn primary lg" href={SITE.desktopDmg} data-ph="desktop_download_click" data-ph-location="hero" download>{t.apps.download}</a>
            <p class="req">{t.apps.req}</p>
            <p class="alt"><a href="#cli-install" data-ph="cli_install_link_click" data-ph-location="hero">{t.hero.cliLink}</a> · <a href={SITE.repo} data-ph="cta_github_click" data-ph-location="hero">{t.hero.ctaPrimary}</a></p>
          </div>
          <span class="chip">{t.hero.chip}</span>
        </div>
        <figure class="hero-shot">
          <Image src={shot} alt={t.hero.shotAlt} widths={[640, 1040, 1440]} sizes="(min-width: 1088px) 1040px, calc(100vw - 32px)" format="webp" quality={80} loading="eager" fetchpriority="high" />
          <figcaption>{t.hero.shotCaption}</figcaption>
        </figure>
      </div>
    </section>

    <section id="how-it-works">
      <div class="wrap">
        <h2>{t.how.title}</h2>
        <p class="col">{t.how.intro}</p>
        <ol class="flow">
          {t.how.steps.map((c, i) => (
            <li class={`step${i === 2 ? ' key' : ''}`}>
              <svg class="diagram" viewBox="0 0 200 110" role="presentation" aria-hidden="true" focusable="false">
                {i === 0 && (
                  <g>
                    <rect x="8" y="8" width="184" height="94" rx="8" class="d-frame" />
                    <line x1="70" y1="8" x2="70" y2="102" class="d-line" /><line x1="131" y1="8" x2="131" y2="102" class="d-line" />
                    <rect x="16" y="20" width="46" height="16" rx="4" class="d-fill" /><rect x="16" y="42" width="46" height="16" rx="4" class="d-fill" /><rect x="16" y="64" width="46" height="16" rx="4" class="d-fill" />
                    <rect x="78" y="20" width="46" height="16" rx="4" class="d-soft" />
                    <rect x="139" y="20" width="46" height="16" rx="4" class="d-soft" />
                  </g>
                )}
                {i === 1 && (
                  <g>
                    <line x1="14" y1="22" x2="186" y2="22" class="d-line" /><line x1="14" y1="55" x2="186" y2="55" class="d-line" /><line x1="14" y1="88" x2="186" y2="88" class="d-line" />
                    <path d="M14 55 H40 M14 55 C28 55 28 22 44 22 M14 55 C28 55 28 88 44 88" class="d-branch" />
                    <line x1="44" y1="22" x2="150" y2="22" class="d-branch" /><line x1="40" y1="55" x2="150" y2="55" class="d-branch" /><line x1="44" y1="88" x2="150" y2="88" class="d-branch" />
                    <circle cx="14" cy="55" r="5" class="d-dot" /><circle cx="80" cy="22" r="5" class="d-dot" /><circle cx="120" cy="22" r="5" class="d-dot" />
                    <circle cx="80" cy="55" r="5" class="d-dot" /><circle cx="120" cy="55" r="5" class="d-dot" />
                    <circle cx="80" cy="88" r="5" class="d-dot" /><circle cx="150" cy="88" r="5" class="d-dot" />
                    <circle cx="150" cy="22" r="5" class="d-dot" /><circle cx="150" cy="55" r="5" class="d-dot" />
                  </g>
                )}
                {i === 2 && (
                  <g>
                    <line x1="8" y1="55" x2="192" y2="55" class="d-line" />
                    <path d="M8 24 H62" class="d-branch" /><path d="M62 24 C84 24 84 55 104 55" class="d-branch" />
                    <circle cx="40" cy="24" r="5" class="d-dot" />
                    <rect x="92" y="30" width="48" height="50" rx="10" class="d-gate" />
                    <path d="M105 56 l8 8 l14 -17" class="d-check" />
                    <circle cx="170" cy="55" r="6" class="d-dot-solid" />
                  </g>
                )}
              </svg>
              <h3><span class="num" aria-hidden="true">{i + 1}</span>{c.title}</h3>
              <p>{c.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="features">
      <div class="wrap">
        <h2>{t.features.title}</h2>
        <p class="col">{t.features.intro}</p>
        <ul class="cards features">
          {t.features.items.map((f) => (
            <li class="card">
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="who-for">
      <div class="wrap col">
        <h2>{t.who.title}</h2>
        <p>{t.who.intro}</p>
        <ul class="points">
          {t.who.points.map((p) => (
            <li><strong>{p.lead}</strong> {p.text}</li>
          ))}
        </ul>
        <p class="proof">{t.who.proof}</p>
      </div>
    </section>

    <section id="apps">
      <div class="wrap">
        <h2>{t.apps.title}</h2>
        <p class="col">{t.apps.intro}</p>
        <div class="cards">
          {t.apps.items.map((a, i) => (
            <div class="card app">
              <h3>{a.title}</h3>
              <p class="platform">{a.platform}</p>
              <p>{a.text}</p>
              {i === 0 ? (
                <figure class="shot">
                  <img src="/apps/desktop-decision.webp" width="1440" height="798" loading="lazy" decoding="async" alt={a.alt} />
                </figure>
              ) : (
                <div class="shot phone-wrap" role="img" aria-label={a.alt}>
                  <div class="phone" aria-hidden="true">
                    <small>{t.apps.phone.label}</small>
                    <div class="pc"><b>BACKEND · T-52</b>{t.apps.phone.askCommand}<code>cargo test -p equipe-core</code><div class="pb"><i>{t.apps.phone.allow}</i><i>{t.apps.phone.decline}</i></div></div>
                    <div class="pc"><b>MOBILE · T-37</b>{t.apps.phone.askMerge}<div class="pb"><i>{t.apps.phone.approve}</i><i>{t.apps.phone.changes}</i></div></div>
                  </div>
                </div>
              )}
              {i === 0 ? (
                <div class="app-action">
                  <a class="btn primary" href={SITE.desktopDmg} data-ph="desktop_download_click" data-ph-location="apps" download>{t.apps.download}</a>
                  <p class="req">{t.apps.req}</p>
                  <p class="req">{t.apps.cliNote}</p>
                </div>
              ) : (
                <div class="app-action"><span class="chip">{t.apps.soon}</span></div>
              )}
            </div>
          ))}
        </div>
        <p class="caption">{t.apps.caption}</p>
        <div class="notify">
          <div>
            <h3>{t.apps.notify.title}</h3>
            <p>{t.apps.notify.text}</p>
            <p class="muted">{t.apps.notify.how}</p>
          </div>
          <a class="btn primary" href={`${SITE.repo}`} data-ph="app_notify_click" data-ph-location="apps">{t.apps.notify.cta}</a>
        </div>
      </div>
    </section>

    <section id="get-started">
      <div class="wrap">
        <h2>{t.start.title}</h2>
        <ol class="app-steps">
          {t.start.appSteps.map((c, i) => (
            <li><span class="num" aria-hidden="true">{i + 1}</span><div><h3>{c.title}</h3><p><Rich s={c.text} /></p></div></li>
          ))}
        </ol>
        <h3 id="cli-install" class="cli-title">{t.start.cliTitle}</h3>
        <p class="col"><Rich s={t.start.cliIntro} /></p>
        <div class="tabs">
          <input type="radio" name="install-method" id="tab-brew" class="tab-input" checked />
          <input type="radio" name="install-method" id="tab-script" class="tab-input" />
          <div class="tablist" role="group" aria-label={t.start.tabsLabel}>
            <label for="tab-brew">Homebrew</label>
            <label for="tab-script">install.sh</label>
          </div>
          <div class="tab-panel" data-panel="brew">
            <p class="col"><Rich s={t.start.brew} /></p>
            <div class="codeblock"><pre tabindex="0"><code>{brew}</code></pre><button class="copy" type="button" data-ph="install_command_copy" data-ph-command="install_brew" aria-label={t.ui.copyInstall} data-label={t.ui.copy} data-done={t.ui.copied}>{t.ui.copy}</button></div>
          </div>
          <div class="tab-panel" data-panel="script">
            <p class="col"><Rich s={t.start.install} /></p>
            <div class="codeblock"><pre tabindex="0"><code>{install}</code></pre><button class="copy" type="button" data-ph="install_command_copy" data-ph-command="install" aria-label={t.ui.copyInstall} data-label={t.ui.copy} data-done={t.ui.copied}>{t.ui.copy}</button></div>
          </div>
        </div>
        <details class="advanced">
          <summary>{t.start.sourceTitle}</summary>
          <p><Rich s={t.start.source} /></p>
        </details>
        <p class="col">{t.start.run}</p>
        <div class="codeblock"><pre tabindex="0"><code>{t.start.runCode}</code></pre><button class="copy" type="button" data-ph="install_command_copy" data-ph-command="run" aria-label={t.ui.copyCommands} data-label={t.ui.copy} data-done={t.ui.copied}>{t.ui.copy}</button></div>
        <p class="col">{t.start.tryIntro}</p>
        <div class="codeblock"><pre tabindex="0"><code>{tryIt}</code></pre><button class="copy" type="button" data-ph="install_command_copy" data-ph-command="try" aria-label={t.ui.copyCommand} data-label={t.ui.copy} data-done={t.ui.copied}>{t.ui.copy}</button></div>
        <p class="links"><a href={SITE.docs}>{t.start.docs}</a><a href={SITE.roadmap}>{t.start.roadmap}</a><a href={SITE.architecture}>{t.start.architecture}</a></p>
      </div>
    </section>

    <section id="faq">
      <div class="wrap col">
        <h2>{t.faq.title}</h2>
        {t.faq.items.map((f, i) => (
          <details data-faq-id={`faq-${i + 1}`}>
            <summary><h3>{f.question}</h3></summary>
            <p><Rich s={f.answer} />{i === installFaq && <> <a href="#get-started">{t.start.title} →</a></>}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap">
      <span class="foot-links"><a href={SITE.repo} data-ph="cta_github_click" data-ph-location="footer">{t.nav.github}</a><a href={SITE.roadmap}>{t.start.roadmap}</a><a href={SITE.architecture}>{t.start.architecture}</a><a href={subPath(info, 'app/privacy')}>{t.app.nav.privacy}</a><a href={subPath(info, 'app/support')}>{t.app.nav.support}</a></span>
      <span>{t.footer.license}</span>
      <span>{t.footer.built}</span>
    </div>
  </footer>

  <Analytics />
  <LangBanner locale={code} />

  <script is:inline>
    document.querySelectorAll('.copy').forEach((b) =>
      b.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(b.previousElementSibling.textContent);
          b.textContent = b.dataset.done;
          setTimeout(() => (b.textContent = b.dataset.label), 1500);
        } catch {}
      }),
    );
  </script>
</Base>
