---
// The home page, for non-developers: a startup team for one person, in the cloud. Developer content lives on /developers.
// Section patterns were studied on 21st.dev (workflow hero, bento grid, how-it-works rail, marquee, pricing with a featured plan,
// call-to-action) and rewritten here as plain Astro + CSS with our tokens: no React, no new dependencies.
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Mark from '../components/Mark.astro';
import RoleIcon from '../components/RoleIcon.astro';
import WebApp from '../components/WebApp.astro';
import IdeaBox from '../components/IdeaBox.astro';
import Gallery from '../components/Gallery.astro';
import Analytics from '../components/Analytics.astro';
import LangBanner from '../components/LangBanner.astro';
import OrganizationJsonLd from '../components/OrganizationJsonLd.astro';
import WebSiteJsonLd from '../components/WebSiteJsonLd.astro';
import FaqJsonLd from '../components/FaqJsonLd.astro';
import WebApplicationJsonLd from '../components/WebApplicationJsonLd.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import CustomerLogos from '../components/CustomerLogos.astro';
import DayOne from '../components/DayOne.astro';
import { TYPICAL_TOTALS } from '../data/flags';
import '../styles/site.css';
import '../styles/webapp.css';
import '../styles/iphone.css';
import '../styles/home.css';
import '../styles/sections.css';
import '../styles/motion.css';
import { SITE } from '../data/site';
import { available, getLocale, getMessages, localePath, subPath, type LocaleCode } from '../i18n';

// One page per language that has a src/i18n/<code>.ts file. English lives at `/`, the rest at `/<slug>/`.
export function getStaticPaths() {
  return available.map((l) => ({ params: { locale: l.slug || undefined }, props: { code: l.code } }));
}

const { code } = Astro.props as { code: LocaleCode };
const info = getLocale(code);
const t = getMessages(code);
const s = t.scene;
const pageUrl = new URL(localePath(info), Astro.site).href;
// Where we are: one state per item.
const statusState = ['now', 'early', 'soon'] as const;
const roleKeys = ['pm', 'eng', 'design', 'qa', 'data'] as const;
// What each member is doing right now in the team section: a task from the app scene, and its state.
const roleNow = [
  { text: s.decision.label, st: 'next' },
  { text: s.activity.tasks[0], st: 'working' },
  { text: s.activity.tasks[2], st: 'done' },
  { text: s.activity.tasks[3], st: 'working' },
  { text: s.activity.tasks[4], st: 'next' },
] as const;
const stateName = (st: string) => (s.activity.states as Record<string, string>)[st];
const check = 'M5 12.5l4.5 4.5L19 7.5';
const faqMore = t.faq.more.split('{email}');
// Bento tiles: a scene, a title and a line. Reuses the how-it-works and cost strings.
const tiles = [
  { k: 'chat', title: t.how.steps[0].title, text: t.how.steps[0].caption, alt: t.how.steps[0].alt, cls: 'b-a' },
  { k: 'team', title: t.how.steps[1].title, text: t.how.steps[1].caption, alt: t.how.steps[1].alt, cls: 'b-b' },
  { k: 'decision', title: t.how.steps[2].title, text: t.how.steps[2].caption, alt: t.how.steps[2].alt, cls: 'b-c' },
  { k: 'growth', title: t.how.steps[3].title, text: t.how.steps[3].caption, alt: t.how.steps[3].alt, cls: 'b-d', soon: true },
  { k: 'cost', title: t.control.points[1].lead, text: t.control.points[1].text, alt: t.control.alt, cls: 'b-e' },
] as const;
---

<Base locale={code} title={t.meta.title} description={t.meta.description} ogTitle={t.meta.ogTitle} ogDescription={t.meta.ogDescription} image={`/og/${info.slug || 'en'}.png`} imageAlt={t.meta.ogImageAlt}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://app.equipe.im" crossorigin />
    <script is:inline>
      // Motion is opt-in: blocks are hidden only once this class is set, and only if the visitor allows motion.
      // If the script that reveals them never runs, the class is dropped after 3 s and everything shows.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('mo');
        setTimeout(function () { if (!window.__rv) document.documentElement.classList.remove('mo'); }, 3000);
      }
    </script>
    <OrganizationJsonLd />
    <WebSiteJsonLd lang={info.lang} url={pageUrl} description={t.meta.description} />
    <WebApplicationJsonLd lang={info.lang} url={pageUrl} description={t.meta.description} featureList={t.team.roles.map((r) => `${r.name}: ${r.text}`)} />
    <FaqJsonLd lang={info.lang} faqs={t.faq.items} />
  </Fragment>

  <a class="skip" href="#main">{t.ui.skip}</a>
  <SiteHeader code={code} page="home" />

  <main id="main" class="home">
    <section class="hero">
      <div class="field" aria-hidden="true"><i class="f1"></i><i class="f2"></i><i class="f3"></i></div>
      <div class="wrap hc">
        <h1 class="ld" style="--d:0">{t.hero.title.split('\n').map((l, i) => <>{i > 0 && <>{' '}<br class="hb" /></>}{l}</>)}</h1>
        <p class="hsub ld" style="--d:1">{t.hero.approve}</p>
        <div class="hbox ld" style="--d:2"><IdeaBox code={code} id="idea-hero" location="hero" big /></div>
        <div class="more ld" style="--d:3"><span class="hnote">{t.prompt.note}</span><a class="cue" href="#see">{t.hero.secondary}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10l5 5 5-5" /></svg></a></div>
      </div>
    </section>

    <section class="logos" aria-labelledby="trust-home">
      <div class="wrap"><CustomerLogos code={code} id="trust-home" class="ltrust" /></div>
    </section>

    <section class="see" id="see">
      <div class="wrap top">
        <div class="hl rv">
          <p class="kicker">{t.see.kicker}</p>
          <h2>{t.see.title}</h2>
        </div>
        <div class="hr rv">
          <p class="lead">{t.hero.lead}</p>
        </div>
        <div class="side rv"><WebApp k="mini" s={s} alt={s.activity.title} /></div>
      </div>
      <div class="wrap shot">
        <WebApp k="hero" s={s} alt={t.hero.shotAlt} />
        <p class="cap">{t.hero.caption}</p>
      </div>
    </section>

    <section class="ideas" aria-label={t.marquee.label}>
      <p class="ideas-l">{t.marquee.label}</p>
      <div class="mq" tabindex="0">
        <ul class="mq-track">
          {t.marquee.items.map((x) => <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v3M12 18v3M3 12h3M18 12h3M6 6l2 2M16 16l2 2M6 18l2-2M16 8l2-2" /></svg>{x}</li>)}
        </ul>
        <ul class="mq-track" aria-hidden="true">
          {t.marquee.items.map((x) => <li><svg viewBox="0 0 24 24"><path d="M12 3v3M12 18v3M3 12h3M18 12h3M6 6l2 2M16 16l2 2M6 18l2-2M16 8l2-2" /></svg>{x}</li>)}
        </ul>
      </div>
    </section>

    <section class="flow" id="how-it-works">
      <div class="wrap">
        <div class="head center rv">
          <p class="kicker">{t.nav.how}</p>
          <h2>{t.flow.title}</h2>
        </div>
        <div class="hiw" data-hiw>
          <ol class="hiw-steps">
            {t.flow.steps.map((st, i) => (
              <li class={`hiw-step${i === 0 ? ' on' : ''}`} data-step={i}>
                <button type="button" class="hiw-b" aria-controls={`hiw-p${i}`} data-go={i}>
                  <span class="fn" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <span class="hiw-t"><b>{st.title}</b><span>{st.text}</span></span>
                </button>
                <div class="hiw-m">{i === 0 ? <div class="hiw-type"><span class="ht-l">{t.prompt.label}</span><p class="ht-x" data-typer={JSON.stringify(t.prompt.examples)}>{t.prompt.examples[0]}</p><span class="ht-send" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 19V5M5.5 11.5L12 5l6.5 6.5" /></svg></span></div> : i === 1 ? <WebApp k="mini" s={s} alt={st.title} /> : <WebApp k="growth" s={s} alt={st.title} />}</div>
              </li>
            ))}
          </ol>
          <div class="hiw-stage" aria-hidden="true">
            <div class="hiw-p on" id="hiw-p0"><div class="hiw-type big"><span class="ht-l">{t.prompt.label}</span><p class="ht-x" data-typer={JSON.stringify(t.prompt.examples)}>{t.prompt.examples[0]}</p><span class="ht-send"><svg viewBox="0 0 24 24"><path d="M12 19V5M5.5 11.5L12 5l6.5 6.5" /></svg></span></div></div>
            <div class="hiw-p" id="hiw-p1"><WebApp k="mini" s={s} alt="" /></div>
            <div class="hiw-p" id="hiw-p2"><WebApp k="growth" s={s} alt="" /></div>
          </div>
        </div>
        <div class="fcta rv"><a class="btn primary lg" href={SITE.start} data-ph="signup_cta_click" data-ph-location="how">{t.hero.cta}</a></div>
      </div>
    </section>

    <DayOne code={code} />

    <Gallery code={code} />

    <section class="wedge" id="from-claude">
      <div class="wrap">
        <div class="head rv">
          <p class="kicker">{t.wedge.kicker}</p>
          <h2>{t.wedge.title}</h2>
          <p class="sub">{t.wedge.text}</p>
        </div>
        <div class="rv"><WebApp k="import" s={s} alt={t.wedge.alt} /></div>
        <ol class="wsteps rv">
          {t.wedge.steps.map((st, i) => <li><span class="n">{i + 1}</span><h3>{st.title}</h3><p>{st.text}</p></li>)}
        </ol>
        <div class="handled rv">
          <div>
            <h3>{t.wedge.handledTitle}</h3>
            <ul>{t.wedge.handled.map((h) => <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d={check} /></svg>{h}</li>)}</ul>
          </div>
          <p class="never">{t.wedge.never}</p>
        </div>
        <p class="honest rv"><span class="soon">{t.ui.soon}</span><span>{t.wedge.note}</span></p>
      </div>
    </section>

    <section class="bento-s" id="what">
      <div class="wrap">
        <div class="head rv">
          <h2>{t.bento.title}</h2>
          <p class="sub">{t.bento.text}</p>
        </div>
        <div class="bento">
          {tiles.map((x, i) => (
            <article class={`tile ${x.cls} rv`} style={`--i:${i}`}>
              <div class="tile-vis"><WebApp k={x.k} s={s} alt={x.alt} /></div>
              <div class="tile-t">
                <h3>{x.title}{'soon' in x && x.soon && <span class="soon">{t.ui.soon}</span>}</h3>
                <p>{x.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="team" id="team">
      <div class="wrap">
        <div class="head rv">
          <p class="kicker">{t.nav.team}</p>
          <h2>{t.team.title}</h2>
          <p class="sub">{t.team.text}</p>
        </div>
        <div class="flowmap rv">
          <i class="px px-tl" aria-hidden="true"></i><i class="px px-tr" aria-hidden="true"></i><i class="px px-bl" aria-hidden="true"></i><i class="px px-br" aria-hidden="true"></i>
          <ol class="nodes">
            {t.team.roles.map((r, i) => (
              <li class={`node r-${roleKeys[i]}`} style={`--i:${i}`}>
                {i < 4 && (
                  <svg class="conn" viewBox="0 0 100 60" preserveAspectRatio="none" aria-hidden="true">
                    <path class="base" d={i % 2 ? 'M0 50 C 45 50, 55 10, 100 10' : 'M0 10 C 45 10, 55 50, 100 50'} />
                    <path class="flow" d={i % 2 ? 'M0 50 C 45 50, 55 10, 100 10' : 'M0 10 C 45 10, 55 50, 100 50'} />
                  </svg>
                )}
                <div class="nd">
                  <span class="ri" aria-hidden="true"><RoleIcon r={roleKeys[i]} /><i class="pulse"></i></span>
                  <h3>{r.name}</h3>
                  <p>{r.text}</p>
                  <span class={`nd-now st-${roleNow[i].st}`}><em>{stateName(roleNow[i].st)}</em>{roleNow[i].text}</span>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section class="loop-s" id="process">
      <div class="wrap">
        <div class="head center rv">
          <p class="kicker">{t.loop.kicker}</p>
          <h2>{t.loop.title}</h2>
          <p class="sub">{t.loop.text}</p>
        </div>
        <div class="loop-c rv">
          <ol class="loop-steps">
            {t.loop.steps.map((x, i) => (
              <li style={`--i:${i}`}><span class="loop-n">{i + 1}</span><h3>{x.name}</h3><p>{x.text}</p></li>
            ))}
          </ol>
          <p class="loop-r"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.3-5.7M20 4v5h-5" /></svg>{t.loop.repeat}</p>
          <div class="loop-b">
            <p class="loop-bt">{t.loop.builtTitle}</p>
            <ul role="list">{t.loop.built.map((x) => <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d={check} /></svg>{x}</li>)}</ul>
          </div>
        </div>
        <div class="smart rv">
          <div class="smart-t">
            <h3>{t.loop.smartTitle}</h3>
            <p>{t.loop.smartText}</p>
          </div>
          <ul class="smart-l" role="list">
            {t.loop.smart.map((x, i) => (
              <li><span class="smart-i" aria-hidden="true">{i === 0 ? <svg viewBox="0 0 24 24"><path d="M7 4h10a1 1 0 0 1 1 1v15l-6-3.5L6 20V5a1 1 0 0 1 1-1z" /></svg> : i === 1 ? <svg viewBox="0 0 24 24"><path d="M4 19h16M7 16v-4M12 16V7M17 16v-6" /></svg> : <svg viewBox="0 0 24 24"><path d="M20 12a8 8 0 1 1-2.3-5.7M20 4v5h-5" /></svg>}</span>{x}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="compare">
      <div class="wrap">
        <h2 class="rv">{t.compare.title}</h2>
        <div class="cmp rv">
          <div class="cl">
            <h3>{t.compare.left.name}</h3>
            <ul>{t.compare.left.items.map((x) => <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7l10 10M17 7L7 17" /></svg>{x}</li>)}</ul>
          </div>
          <div class="cr">
            <h3><Mark size={22} />{t.compare.right.name}</h3>
            <ul>{t.compare.right.items.map((x) => <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d={check} /></svg>{x}</li>)}</ul>
          </div>
        </div>
        <div class="outcome rv">
          <ul>{t.compare.outcome.map((o, i) => <li><span class="on" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{o}</li>)}</ul>
          <a class="btn primary" href={SITE.start} data-ph="signup_cta_click" data-ph-location="compare">{t.hero.cta}</a>
        </div>
      </div>
    </section>

    <section class="pricing" id="pricing">
      <div class="wrap">
        <div class="head center rv">
          <p class="kicker">{t.plans.title}</p>
          <h2>{t.control.title}</h2>
          <p class="sub">{t.plans.text}</p>
        </div>
        <ul class="plans">
          {t.plans.items.map((p, i) => (
            <li class={`plan rv${i === 1 ? ' featured' : ''}`} style={`--i:${i}`}>
              <div class="plan-h"><h3>{p.name}</h3>{i === 1 && <span class="plan-b">{t.plans.featured}</span>}</div>
              <p class="plan-d">{p.text}</p>
              <p class="plan-p"><b>{p.price}</b><span>{p.per}</span></p>
          {i === 1 && <p class="plan-y">{t.plans.yearly}</p>}
              <ul class="plan-f">{p.points.map((x) => <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d={check} /></svg>{x}</li>)}</ul>
              <a class={`btn ${i === 1 ? 'primary' : 'ghost'} plan-a`} href={SITE.start} data-ph="signup_cta_click" data-ph-location={`pricing_${i}`}>{p.cta}</a>
            </li>
          ))}
        </ul>
        <div class="pfacts rv">
          <div class="pfact"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5v8.5" /><path d="M7.2 6.8a7.5 7.5 0 1 0 9.6 0" /></svg><div><h3>{t.plans.runout.title}</h3><p>{t.plans.runout.text}</p></div></div>
          <div class="pfact"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="6" width="17" height="12" rx="2.5" /><path d="M3.5 10h17M7 14.5h3" /></svg><div><h3>{t.plans.credits.title}</h3><p>{t.plans.credits.text}</p></div></div>
          <div class="pfact"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 18.5h16M7 15V11M12 15V7M17 15v-2.5" /></svg><div><h3>{t.plans.estimate.title}</h3><p>{t.plans.estimate.text}</p>{TYPICAL_TOTALS?.[code] && <p class="pfact-x">{TYPICAL_TOTALS[code]}</p>}</div></div>
        </div>
        <ul class="pts rv">
          {t.control.points.map((p) => <li><h3>{p.lead}</h3><p>{p.text}</p></li>)}
        </ul>
        <p class="honest center rv"><span class="soon">{t.status.labels.now}</span><span>{t.control.note}</span></p>
      </div>
    </section>

    <section class="who">
      <div class="wrap">
        <h2 class="rv">{t.who.title}</h2>
        <ul class="wcards rv">
          {t.who.items.map((w) => <li><h3>{w.title}</h3><p>{w.text}</p></li>)}
        </ul>
      </div>
    </section>

    <section class="status" id="status">
      <div class="wrap">
        <div class="head rv">
          <h2>{t.status.title}</h2>
          <p class="sub">{t.status.text}</p>
        </div>
        <ol class="track rv">
          {t.status.items.map((it, i) => (
            <li class={`is-${statusState[i]}`}>
              <span class="dot" aria-hidden="true"></span>
              <span class="lbl">{t.status.labels[statusState[i]]}</span>
              <h3>{it.title}</h3>
              <p>{it.text}</p>
            </li>
          ))}
        </ol>
        <div class="proof rv">
          <h3>{t.proof.title}</h3>
          <dl>{t.proof.nums.map((n) => <div><dt data-tick={n.n}>{n.n}</dt><dd>{n.label}</dd></div>)}</dl>
          <p class="meta">{t.proof.small}</p>
        </div>
      </div>
    </section>

    <section class="faq" id="faq">
      <div class="wrap">
        <div class="fq">
          <div class="fqh rv">
            <h2>{t.faq.title}</h2>
            <p class="more">{faqMore[0]}<a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a>{faqMore[1]}</p>
          </div>
          <div class="faqs rv">
            {t.faq.items.map((f, i) => (
              <details data-faq-id={`faq-${i + 1}`} open={i === 0}>
                <summary><h3>{f.question}</h3></summary>
                <p>{f.answer}{i === t.faq.items.length - 1 && <> <a href={subPath(info, 'developers')} data-ph="developers_link_click" data-ph-location="faq">{t.faq.devLink} →</a></>}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="early final" id="start">
      <span id="early-access" aria-hidden="true"></span>
      <div class="wrap">
        <div class="fin rv">
          <span class="fin-mark" aria-hidden="true"><Mark size={44} /></span>
          <h2>{t.band.title}</h2>
          <p class="sub">{t.band.text}</p>
          <div class="fbox"><IdeaBox code={code} id="idea-band" location="band" big /></div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter code={code} page="home" />
  <Analytics />
  <LangBanner locale={code} />
  <ConsentBanner code={code} />

  <script>
    // Motion, all gated on html.mo (set in <head> only when the visitor allows motion):
    // - blocks fade up as they enter (IntersectionObserver; anything already on screen shows at once)
    // - drawn scenes get `.live` while on screen, so their loops only run when someone can see them
    // - numbers with data-tick count up once, the first time they are seen
    // How it works: the step in the middle of the screen is active; its preview fades in on the right. Clicking a step jumps to it.
    document.querySelectorAll<HTMLElement>('[data-hiw]').forEach((box) => {
      const steps = [...box.querySelectorAll<HTMLElement>('.hiw-step')];
      const panes = [...box.querySelectorAll<HTMLElement>('.hiw-p')];
      const set = (n: number) => { steps.forEach((s, i) => s.classList.toggle('on', i === n)); panes.forEach((p, i) => p.classList.toggle('on', i === n)); box.style.setProperty('--prog', String(n / Math.max(1, steps.length - 1))); };
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) set(Number((e.target as HTMLElement).dataset.step)); }), { rootMargin: '-45% 0px -45% 0px' });
      steps.forEach((s) => io.observe(s));
      box.querySelectorAll<HTMLButtonElement>('[data-go]').forEach((b) => b.addEventListener('click', () => { const n = Number(b.dataset.go); set(n); steps[n].scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'center' }); }));
    });
    const root = document.documentElement;
    if (root.classList.contains('mo')) {
      // the step-1 preview types example ideas
      document.querySelectorAll<HTMLElement>('[data-typer]').forEach((el) => {
        const ex: string[] = JSON.parse(el.dataset.typer!); let i = 0, n = ex[0].length, dir = -1, wait = 30;
        setInterval(() => {
          if (wait > 0) { wait--; return; }
          const w = ex[i]; n += dir; el.textContent = w.slice(0, Math.max(0, n));
          if (dir > 0 && n >= w.length) { dir = -1; wait = 30; } else if (dir < 0 && n <= 0) { dir = 1; i = (i + 1) % ex.length; wait = 6; }
        }, 60);
      });
      (window as unknown as { __rv: boolean }).__rv = true;
      const reveal = new IntersectionObserver((es) => es.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('in'); reveal.unobserve(e.target); }
      }), { rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('main.home .rv, footer .rv').forEach((el) => reveal.observe(el));
      addEventListener('beforeprint', () => document.querySelectorAll('.rv').forEach((el) => el.classList.add('in')));

      const tickOnce = (box: Element) => box.querySelectorAll<HTMLElement>('[data-tick]').forEach((el) => {
        if (el.dataset.done) return; el.dataset.done = '1';
        const end = Number(String(el.dataset.tick).replace(/[^\d.]/g, '')); if (!end) return;
        const dec = Number(el.dataset.dec || 0), pre = el.dataset.prefix ?? '', suf = el.dataset.suffix ?? '';
        const t0 = performance.now(), D = 1200;
        const step = (now: number) => {
          const p = Math.min(1, (now - t0) / D), v = end * (1 - (1 - p) ** 3);
          el.textContent = pre + v.toFixed(dec) + suf;
          if (p < 1) requestAnimationFrame(step); else el.textContent = pre + end.toFixed(dec) + suf;
        };
        requestAnimationFrame(step);
      });
      const live = new IntersectionObserver((es) => es.forEach((e) => {
        e.target.classList.toggle('live', e.isIntersecting);
        if (e.isIntersecting) tickOnce(e.target);
      }), { threshold: 0.25 });
      document.querySelectorAll('.wa-fig, .proof').forEach((el) => live.observe(el));

    }
  </script>
</Base>
