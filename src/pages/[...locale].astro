---
import Base from '../layouts/Base.astro';
import AppUi from '../components/AppUi.astro';
import IconSprite from '../components/IconSprite.astro';
import HeroScene from '../components/HeroScene.astro';
import '../styles/app.css';
import { getAppText } from '../i18n/app';
import State from '../components/State.astro';
import '../styles/landing.css';
import '../styles/motion.css';
import Mark from '../components/Mark.astro';
import LangMenu from '../components/LangMenu.astro';
import Rich from '../components/Rich.astro';
import Analytics from '../components/Analytics.astro';
import LangBanner from '../components/LangBanner.astro';
import OrganizationJsonLd from '../components/OrganizationJsonLd.astro';
import WebSiteJsonLd from '../components/WebSiteJsonLd.astro';
import SoftwareApplicationJsonLd from '../components/SoftwareApplicationJsonLd.astro';
import FaqJsonLd from '../components/FaqJsonLd.astro';
import { SITE } from '../data/site';
import { DESIGN_LIVE } from '../data/design';
import { getDesignText } from '../i18n/design';
import { available, getLocale, getMessages, localePath, subPath, type LocaleCode } from '../i18n';

// One page per language that has a src/i18n/<code>.ts file. English lives at `/`, the rest at `/<slug>/`.
export function getStaticPaths() {
  return available.map((l) => ({ params: { locale: l.slug || undefined }, props: { code: l.code } }));
}

const { code } = Astro.props as { code: LocaleCode };
const info = getLocale(code);
const t = getMessages(code);
const at = getAppText(code);
const dz = getDesignText(code);
const pageUrl = new URL(localePath(info), Astro.site).href;

const install = 'curl -fsSL https://github.com/equipe-labs/equipe/releases/latest/download/install.sh | sh';
const brew = 'brew install equipe-labs/tap/equipe';
// Status of each stage and loop step: now = works today, part = partly, soon = coming (the same in every language).
const stageState = ['now', 'part', 'soon', 'soon'] as const;
const loopState = ['part', 'now'] as const;
// The last three FAQ items are for developers.
const devFrom = t.faq.items.length - 3;
// The large scenes in Features (the permission card is shown in section 1, so its feature sits in the list below): which `now` item each one shows.
const scenes = [{ k: 'fa', n: 0 }, { k: 'fb', n: 4 }, { k: 'fc', n: 3, tall: true }];
// Headline breaks at the sentence boundary (never mid-phrase): "Your whole startup team." / "You just approve."
const heroLines = t.hero.title.split(/(?<=[.。])\s*(?=\S)/);
const tryIt = 'equipe try --edit "…"';
const androidFileSha256 = 'bd8f267edeb10ce0aaed1efbb80f7b3c349895f6121e5f8a97d647d09f8d9773';
const androidCertificateSha256 = 'f6884e264a84a48b04cf7b04256e40e3887543795b430e367aee2ff769041a87';
---

<Base locale={code} title={t.meta.title} description={t.meta.description} ogTitle={t.meta.ogTitle} ogDescription={t.meta.ogDescription} image={`/og/${info.slug || 'en'}.png`} imageAlt={t.meta.ogImageAlt}>
  <Fragment slot="head">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Scroll motion is opt-in: blocks are hidden only once this class is set, and only if the visitor allows motion.
      // If the script that reveals them never runs, the class is dropped after 3 s and everything shows.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('mo');
        setTimeout(function () { if (!window.__rv) document.documentElement.classList.remove('mo'); }, 3000);
      }
    </script>
    <OrganizationJsonLd />
    <WebSiteJsonLd lang={info.lang} url={pageUrl} description={t.meta.description} />
    <SoftwareApplicationJsonLd lang={info.lang} url={pageUrl} description={t.meta.description} featureList={t.feat.now.map((f) => f.title)} />
    <FaqJsonLd lang={info.lang} faqs={t.faq.items} />
  </Fragment>

  <IconSprite />
  <a class="skip" href="#main">{t.ui.skip}</a>
  <header class="site">
    <div class="wrap">
      <a class="brand" href={localePath(info)}><Mark size={28} /> <span class="bt">equipe</span></a>
      <nav aria-label={t.ui.primaryNav}>
        <ul>
          <li class="opt"><a href="#stage">{t.nav.stage}</a></li>
          <li class="opt"><a href="#how-it-works">{t.nav.howItWorks}</a></li>
          <li class="opt"><a href="#features">{t.nav.features}</a></li>
          {DESIGN_LIVE && <li class="dz-link"><a href={subPath(info, 'design')} data-ph="design_menu_click">{dz.menu}</a></li>}
          <li class="opt"><a href="#get-started">{t.nav.getStarted}</a></li>
          <li class="opt"><a href="#faq">{t.nav.faq}</a></li>
          <li class="opt"><a href={SITE.repo} data-ph="cta_github_click" data-ph-location="header">{t.nav.github}</a></li>
          <li><LangMenu locale={code} label={t.ui.language} /></li>
          <li><a class="btn primary sm" href={SITE.desktopDmg} data-ph="desktop_download_click" data-ph-location="header" download>{t.hero.cta}</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main" class="landing">
    <section class="hero">
      <div class="wrap w">
        <h1>{heroLines.map((l, i) => <><span class="hl">{l}</span>{i < heroLines.length - 1 && ' '}</>)}</h1>
        <p class="lead">{t.hero.lead}</p>
        <div class="acts">
          <a class="btn primary lg" href={SITE.desktopDmg} data-ph="desktop_download_click" data-ph-location="hero" download>{t.hero.cta}</a>
          <a class="link" href="#cli-install" data-ph="cli_install_link_click" data-ph-location="hero">{t.hero.cliLink}</a>
        </div>
        <p class="meta">{t.hero.req} · <span class="evline">{t.hero.proof}</span></p>
      </div>
      <div class="wrap w heroshot">
        <HeroScene t={at} alt={t.hero.shotAlt} />
      </div>
    </section>

    <section class="launch">
      <div class="wrap w">
        <div class="row">
          <div>
            <h2>{t.launch.title}</h2>
            <p class="lede">{t.launch.text}</p>
            <div class="lines">
              <div class="ln"><span class="tagcol"><span class="now">{t.ui.now}</span></span><p>{t.launch.now}</p></div>
              <div class="ln"><span class="tagcol"><span class="soon">{t.ui.soon}</span></span><p>{t.launch.soon}</p></div>
            </div>
          </div>
          <div><AppUi k="launch" t={at} alt={t.launch.alt} /><p class="cap">{t.launch.caption}</p></div>
        </div>
      </div>
    </section>

    <section id="stage" class="alt">
      <div class="wrap w">
        <div class="row rev half">
          <div class="sk"><AppUi k="stage" t={at} alt={t.stage.alt} /><p class="cap">{t.stage.caption}</p></div>
          <div>
            <h2>{t.stage.title} <span class="tone">{t.stage.text}</span></h2>
            <ol class="tl">
              {t.stage.items.map((s, i) => (
                <li class={`st is-${stageState[i]}`}>
                  <i class="dot" aria-hidden="true"></i>
                  <h3>{s.title} <State s={stageState[i]} now={t.ui.now} soon={t.ui.soon} /></h3>
                  <p>{s.text}</p>
                  {stageState[i] === 'part' && <span class="pn">{t.stage.partNote}</span>}
                </li>
              ))}
            </ol>
            <p class="close"><span class="soon">{t.ui.soon}</span><span>{t.stage.close}</span></p>
          </div>
        </div>
      </div>
    </section>

    <section id="how-it-works">
      <div class="wrap w">
        <h2>{t.loop.title} <span class="tone">{t.loop.text}</span></h2>
        <div class="loopw">
          {[0, 1].map((i) => (
            <div class="row">
              <ol class="lps" start={i + 1}>
                <li class="lp"><span class="n" aria-hidden="true">{i + 1}</span><div><h3>{t.loop.steps[i].title} <State s={loopState[i]} now={t.ui.now} soon={t.ui.soon} /></h3><p>{t.loop.steps[i].text}</p>{loopState[i] === 'part' && <span class="pn">{t.loop.partNote}</span>}</div></li>
              </ol>
              {i === 0
                ? <div><AppUi k="goal" t={at} alt={t.loop.goalAlt} /><p class="cap">{t.loop.goalCaption}</p></div>
                : <div><AppUi k="build" t={at} alt={t.loop.buildAlt} /><p class="cap">{t.loop.buildCaption}</p></div>}
            </div>
          ))}

          <div class="row rev appr">
            <div class="duo">
              <div class="sk"><AppUi k="appr" t={at} alt={t.loop.approveAlt} /><p class="cap">{t.loop.approveCaption}</p></div>
              <div class="phonebox">
                <div>
                  <div class="phone" role="img" aria-label={t.loop.phoneCaption}>
                    <div class="scr" aria-hidden="true">
                      <div class="isl"></div>
                      <div class="sb"><span>9:41</span></div>
                      <div class="nav"><span class="cl">{t.demo.phone.close}</span><b>{t.demo.phone.name}</b></div>
                      <div class="body">
                        <p class="who">{t.demo.phone.name} {t.demo.phone.verb}</p>
                        <p class="sec">{t.demo.phone.age}</p>
                        <p class="wh">{t.demo.phone.where}</p>
                        <p class="tool">{t.demo.phone.tool}</p>
                        <p class="act">{t.demo.phone.action}</p>
                        <p class="sec fn">{t.demo.phone.once}</p>
                      </div>
                      <div class="bar"><span class="deny">{t.demo.phone.deny}</span><span class="allow">{t.demo.phone.allow}</span></div>
                      <div class="hi"></div>
                    </div>
                  </div>
                  <p class="cap narrow"><span class="now">{t.ui.now}</span> {t.loop.phoneCaption} <a href={SITE.appStore} rel="noopener">{t.loop.appStore}</a> · <a href={SITE.androidApk} data-ph="android_download_click" data-ph-location="phone">Android (APK)</a></p>
                  <p class="cap narrow">{t.start.android.playStore}</p>
                </div>
              </div>
            </div>
            <div>
              <svg class="tick" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
              <h3 class="h3big">{t.loop.approveTitle}</h3>
              <p class="bp">{t.loop.approveText}</p>
            </div>
          </div>

          <div class="row">
            <ol class="lps" start="3">
              {[2, 3, 4].map((i) => (
                <li class="lp soonlp"><span class="n" aria-hidden="true">{i + 1}</span><div><h3>{t.loop.steps[i].title} <State s="soon" now={t.ui.now} soon={t.ui.soon} /></h3><p>{t.loop.steps[i].text}</p></div></li>
              ))}
            </ol>
            <div class="sk">
              <div class="mr" role="img" aria-label={t.ui.illu}>
                <h4>{t.loop.reportTitle}<span class="soon">{t.ui.soon}</span></h4>
                {t.loop.reportRows.map((r) => <div class="rw"><span>{r}</span><i></i></div>)}
              </div>
              <p class="cap">{t.ui.illu}</p>
            </div>
          </div>
        </div>
        <p class="back"><span>↺ {t.loop.back}</span><i></i></p>
      </div>
    </section>

    <section id="who-for" class="alt">
      <div class="wrap w">
        <h2>{t.who.title} <span class="tone">{t.who.text}</span></h2>
        <div class="whofig sk"><AppUi k="who" t={at} alt={t.who.alt} /><p class="cap">{t.who.caption}</p></div>
        <ul class="pts">
          {t.who.points.map((p) => <li class="pt"><h3>{p.lead}</h3><p>{p.text}</p></li>)}
        </ul>
      </div>
    </section>

    <section id="features">
      <div class="wrap w">
        <h2>{t.feat.title}</h2>
        <div class="fr">
          {scenes.map((sc, i) => (
            <div class={`row${i % 2 ? ' rev' : ''}`}>
              {i % 2 === 1 && <div class="sk"><AppUi k={sc.k} t={at} alt={t.feat.scenes[i].alt} /><p class="cap">{t.feat.scenes[i].caption}</p></div>}
              <div>
                <span class="now">{t.ui.now}</span>
                <h3>{t.feat.now[sc.n].title}</h3>
                <p>{t.feat.now[sc.n].text}</p>
              </div>
              {i % 2 === 0 && (
                <div class={sc.tall ? 'sk' : undefined}>
                  {sc.tall ? <div class="tall"><AppUi k={sc.k} t={at} alt={t.feat.scenes[i].alt} /></div> : <AppUi k={sc.k} t={at} alt={t.feat.scenes[i].alt} />}
                  <p class="cap">{t.feat.scenes[i].caption}</p>
                </div>
              )}
            </div>
          ))}
        </div>
        <p class="alsoh"><span>{t.feat.more}</span><i></i></p>
        <ul class="also swipe" tabindex="0" aria-label={t.feat.more}>
          {[1, 2, 5, 6, 7, 8].map((n) => <li><h4>{t.feat.now[n].title}</h4><p>{t.feat.now[n].text}</p></li>)}
        </ul>
        <div class="cm">
          <h3>{t.feat.comingTitle}</h3>
          <ul class="cl swipe" tabindex="0" aria-label={t.feat.comingTitle}>
            {t.feat.coming.map((f) => <li><h4>{f.title}</h4><p>{f.text}</p></li>)}
          </ul>
        </div>
        {DESIGN_LIVE && (
          <a class="dz-bridge" href={subPath(info, 'design')} data-ph="design_menu_click" data-ph-location="home">
            <code>equipe-design</code>
            <span>{dz.bridge.text}</span>
            <span class="go">{dz.bridge.link} →</span>
          </a>
        )}
      </div>
    </section>

    <section class="evs">
      <div class="wrap w">
        <h2>{t.ev.title} <span class="tone">{t.ev.text}</span></h2>
        <div class="evg">
          <dl class="nums">
            {t.ev.nums.map((n) => <div class="num"><dt>{n.n}</dt><dd>{n.label}</dd></div>)}
          </dl>
          <div><AppUi k="ev" dark t={at} alt={t.ev.alt} /><p class="cap">{t.ev.caption}</p></div>
        </div>
        <p class="meta">{t.ev.small}</p>
      </div>
    </section>

    <section id="get-started">
      <div class="wrap w">
        <h2>{t.start.title}</h2>
        <ol class="go">
          {t.start.steps.map((s, i) => (
            <li class="gs">
              <div class="vis"><AppUi k={`st${i + 1}`} t={at} alt={s.alt} /></div>
              <span class="n" aria-hidden="true">{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              {i === 1 && <p class="note"><Rich s={t.start.note2} /></p>}
              {i === 2 && <p class="note"><Rich s={t.start.note3} /></p>}
            </li>
          ))}
        </ol>
        <div class="acts">
          <a class="btn primary lg" href={SITE.desktopDmg} data-ph="desktop_download_click" data-ph-location="start" download>{t.hero.cta}</a>
          <a class="btn lg" href={SITE.androidApk} data-ph="android_download_click" data-ph-location="start">{t.start.android.download}</a>
          <span class="meta">{t.hero.req}</span>
        </div>
        <div class="android-install">
          <h3>{t.start.android.title}</h3>
          <p>{t.start.android.intro}</p>
          <ol>
            {t.start.android.steps.map((step) => <li><Rich s={step} /></li>)}
          </ol>
          <p>{t.start.android.playStore}</p>
          <dl class="android-hashes">
            <div><dt>{t.start.android.fileSha256}</dt><dd><code>{androidFileSha256}</code></dd></div>
            <div><dt>{t.start.android.certificateSha256}</dt><dd><code>{androidCertificateSha256}</code></dd></div>
          </dl>
        </div>
        <div class="cli">
          <h3 id="cli-install" class="cli-title">{t.start.cliTitle}</h3>
          <p class="col"><Rich s={t.start.cliIntro} /></p>
          <div class="tabs">
            <input type="radio" name="install-method" id="tab-brew" class="tab-input" checked />
            <input type="radio" name="install-method" id="tab-script" class="tab-input" />
            <div class="tablist" role="group" aria-label={t.start.tabsLabel}>
              <label for="tab-brew">Homebrew</label>
              <label for="tab-script">install.sh</label>
            </div>
            <div class="tab-panel" data-panel="brew">
              <p class="col"><Rich s={t.start.brew} /></p>
              <div class="codeblock"><pre tabindex="0"><code>{brew}</code></pre><button class="copy" type="button" data-ph="install_command_copy" data-ph-command="install_brew" aria-label={t.ui.copyInstall} data-label={t.ui.copy} data-done={t.ui.copied} data-fallback={t.ui.copyFallback} aria-live="polite">{t.ui.copy}</button></div>
            </div>
            <div class="tab-panel" data-panel="script">
              <p class="col"><Rich s={t.start.install} /></p>
              <div class="codeblock"><pre tabindex="0"><code>{install}</code></pre><button class="copy" type="button" data-ph="install_command_copy" data-ph-command="install" aria-label={t.ui.copyInstall} data-label={t.ui.copy} data-done={t.ui.copied} data-fallback={t.ui.copyFallback} aria-live="polite">{t.ui.copy}</button></div>
            </div>
          </div>
          <details class="advanced">
            <summary>{t.start.sourceTitle}</summary>
            <p><Rich s={t.start.source} /></p>
          </details>
          <p class="col">{t.start.run}</p>
          <div class="codeblock"><pre tabindex="0"><code>{t.start.runCode}</code></pre><button class="copy" type="button" data-ph="install_command_copy" data-ph-command="run" aria-label={t.ui.copyCommands} data-label={t.ui.copy} data-done={t.ui.copied} data-fallback={t.ui.copyFallback} aria-live="polite">{t.ui.copy}</button></div>
          <p class="col">{t.start.tryIntro}</p>
          <div class="codeblock"><pre tabindex="0"><code>{tryIt}</code></pre><button class="copy" type="button" data-ph="install_command_copy" data-ph-command="try" aria-label={t.ui.copyCommand} data-label={t.ui.copy} data-done={t.ui.copied} data-fallback={t.ui.copyFallback} aria-live="polite">{t.ui.copy}</button></div>
          <p class="links"><a href={SITE.docs}>{t.start.docs}</a><a href={SITE.roadmap}>{t.start.roadmap}</a><a href={SITE.architecture}>{t.start.architecture}</a></p>
        </div>
      </div>
    </section>

    <section id="faq" class="alt">
      <div class="wrap w">
        <div class="fq">
          <h2>{t.faq.title}</h2>
          <div class="faqs">
            {t.faq.items.map((f, i) => (
              <details data-faq-id={`faq-${i + 1}`} open={i === 0 || i === 4}>
                <summary>
                  <h3>{i >= devFrom && <span class="dv">{t.faq.devLabel}</span>}{f.question}</h3>
                </summary>
                <p><Rich s={f.answer} /></p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="end">
      <div class="wrap">
        <h2>{t.close.title}</h2>
        <div class="acts"><a class="btn primary xl" href={SITE.desktopDmg} data-ph="desktop_download_click" data-ph-location="close" download>{t.hero.cta}</a></div>
        <p class="meta">{t.hero.req}</p>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap">
      <span class="foot-links"><a href={SITE.repo} data-ph="cta_github_click" data-ph-location="footer">{t.nav.github}</a><a href={SITE.roadmap}>{t.start.roadmap}</a><a href={SITE.architecture}>{t.start.architecture}</a>{DESIGN_LIVE && <a href={`${subPath(info, 'design/docs')}#guardrails`}>{dz.nav.guidelines}</a>}<a href={subPath(info, 'app/privacy')}>{t.app.nav.privacy}</a><a href={subPath(info, 'app/support')}>{t.app.nav.support}</a></span>
      <span>{t.footer.license}</span>
      <span>{t.footer.built}</span>
    </div>
  </footer>

  <Analytics />
  <LangBanner locale={code} />

  <script>
    // Scroll motion (T-252): blocks fade up as they arrive, product screens start their own small motion once on screen, numbers count up.
    if (document.documentElement.classList.contains('mo')) {
      (window as unknown as { __rv: boolean }).__rv = true;
      const S = 'main.landing > section:not(.hero)';
      const tiers: [string, string][] = [
        ['2', `${S} :is(.lede, .lines, .tl, .lps, .pts, .alsoh, .also, .cm, .nums, .faqs, .back, .links, .h3big, .bp, .tick, .cli, .end .acts, .meta, .go ~ .acts, .fr .row > div > :is(.now, h3, p:not(.cap)))`],
        ['1', `${S} h2`],
        ['3', `${S} :is(.win, .phone, .mr, .cap):not(.gs *)`],
      ];
      // A block is revealed once its top is above the lower 8% of the screen. A scroll sweep (not only an observer) means blocks
      // jumped over by a fast scroll, an anchor link or a restored scroll position are shown too, never left as an empty area.
      const pending = new Set<HTMLElement>();
      const sweep = () => {
        const line = window.innerHeight * 0.92;
        pending.forEach((el) => { if (el.getBoundingClientRect().top < line) { el.classList.add('in'); pending.delete(el); } });
      };
      for (const [t, sel] of tiers) document.querySelectorAll<HTMLElement>(sel).forEach((el) => {
        if (el.classList.contains('rv')) return;
        el.classList.add('rv'); el.dataset.t = t; pending.add(el);
      });
      document.querySelectorAll<HTMLElement>('.go').forEach((el) => pending.add(el));
      let raf = 0;
      const queue = () => { if (!raf) raf = requestAnimationFrame(() => { raf = 0; sweep(); }); };
      addEventListener('scroll', queue, { passive: true });
      addEventListener('resize', queue);
      addEventListener('hashchange', queue);
      addEventListener('beforeprint', () => { pending.forEach((el) => el.classList.add('in')); pending.clear(); });
      sweep();

      const play = new IntersectionObserver((es) => es.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('play'); play.unobserve(e.target); }
      }), { threshold: 0.3 });
      document.querySelectorAll(`${S} .win`).forEach((el) => play.observe(el));

      const nums = new IntersectionObserver((es) => es.forEach((e) => {
        if (!e.isIntersecting) return;
        nums.unobserve(e.target);
        const el = e.target as HTMLElement, end = el.dataset.end!, to = Number(end.match(/\d+/)![0]);
        const t0 = performance.now(), D = 1100;
        const tick = (now: number) => {
          const p = Math.min(1, (now - t0) / D), v = Math.round(to * (1 - (1 - p) ** 3));
          el.textContent = end.replace(/\d+/, String(v));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }), { threshold: 0.6 });
      document.querySelectorAll<HTMLElement>('.num dt').forEach((el) => {
        const end = el.textContent ?? '';
        if (!/\d/.test(end)) return;
        el.dataset.end = end; el.textContent = end.replace(/\d+/, '0'); nums.observe(el);
      });
    }
  </script>

  <script is:inline>
    document.querySelectorAll('.copy').forEach((b) =>
      b.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(b.previousElementSibling.textContent);
          b.textContent = b.dataset.done;
          setTimeout(() => (b.textContent = b.dataset.label), 1500);
        } catch {
          const r = document.createRange();
          r.selectNodeContents(b.previousElementSibling);
          const sel = getSelection();
          sel.removeAllRanges();
          sel.addRange(r);
          b.textContent = b.dataset.fallback;
          setTimeout(() => (b.textContent = b.dataset.label), 3000);
        }
      }),
    );
  </script>
