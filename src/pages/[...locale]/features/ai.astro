---
// /features/ai/: the ready-made AI features an equipe team adds to the product it builds ("AI in your product").
// Copy: src/data/productai.ts (8 languages). Facts: equipe-cloud docs/product-ai.md and ai.equipe.im/docs, public parts only.
// Layout: hero with the quotable short answer, the 11 features (each with a small drawn scene, not a screenshot), how it
// works with a real screenshot of the chat widget, pricing with the real AI panel (sample numbers), security in plain words,
// what is not available yet, developers, FAQ (FAQPage JSON-LD from the same strings), call to action.
import PageShell from '../../../components/PageShell.astro';
import FaqJsonLd from '../../../components/FaqJsonLd.astro';
import JsonLd from '../../../components/JsonLd.astro';
import { SITE } from '../../../data/site';
import { NAV } from '../../../data/nav';
import { AI_GROUPS, AI_FEATURES, aiCopy, type AiFeature, type AiGroup } from '../../../data/productai';
import { available, getLocale, localePath, subPath, type LocaleCode } from '../../../i18n';
import '../../../styles/ai.css';

export function getStaticPaths() { return available.map((l) => ({ params: { locale: l.slug || undefined }, props: { code: l.code } })); }
const { code } = Astro.props as { code: LocaleCode };
const info = getLocale(code);
const c = aiCopy(code);
const P = c.page;
const v = c.vis;
const url = new URL(subPath(info, 'features/ai'), Astro.site).href;
const home = new URL(localePath(info), Astro.site).href;
const start = NAV[code]?.start ?? NAV.en.start;
const DOCS = 'https://ai.equipe.im/docs';
const groups = Object.keys(AI_GROUPS) as AiGroup[];
const GI: Record<AiGroup, string> = {
  site: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM3.5 12h17M12 3c2.4 2.6 3.6 5.6 3.6 9s-1.2 6.4-3.6 9c-2.4-2.6-3.6-5.6-3.6-9S9.6 5.6 12 3z',
  admin: 'M4.5 4.5h15v15h-15zM4.5 9.5h15M10 9.5v10',
  server: 'M5 4.5h14v6H5zM5 13.5h14v6H5zM8.5 7.5h.01M8.5 16.5h.01',
};
const SI = [
  'M15.5 8.5a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0zM12 12v8.5M12 16.5h3M12 19h2',
  'M4 5.5h16v10H4zM8 19h8M12 15.5V19M7.5 9l9 4M16.5 9l-9 4',
  'M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM3.5 19.5c0-3 2.5-5.5 5.5-5.5s5.5 2.5 5.5 5.5M16 8h4.5M16 12h4.5M17.5 16h3',
  'M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17zM12 7.5v4.5l3 2',
  'M7 11V8a5 5 0 0 1 10 0v3M5 11h14v9H5zM12 15v2',
  'M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13M10 11v5M14 11v5',
];
const spark = 'M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3z';
const arrow = 'M5 12h14M13 6l6 6-6 6';
---
<PageShell code={code} page="features/ai" title={P.title} description={P.desc} image={`/og/ai-${info.slug || 'en'}.png`} imageAlt={P.ogAlt}>
  <Fragment slot="head">
    <JsonLd data={{
      '@type': 'WebPage', '@id': `${url}#page`, url, name: P.h1, description: P.desc, inLanguage: info.lang,
      isPartOf: { '@id': `${url}#website` }, about: { '@id': `${SITE.url}/#organization` },
      primaryImageOfPage: new URL(`/og/ai-${info.slug || 'en'}.png`, Astro.site).href,
      significantLink: [DOCS],
      mainEntity: { '@type': 'ItemList', name: c.featuresTitle, numberOfItems: AI_FEATURES.length, itemListElement: AI_FEATURES.map((k, i) => ({ '@type': 'ListItem', position: i + 1, name: c.features[k].title, description: c.features[k].text })) },
    }} />
    <JsonLd data={{
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'equipe', item: home },
        { '@type': 'ListItem', position: 2, name: c.nav, item: url },
      ],
    }} />
    <FaqJsonLd lang={info.lang} faqs={c.faq} />
  </Fragment>

  <section class="ai-hero"><div class="wrap">
    <h1>{P.h1}</h1>
    <p class="lead">{P.lead}</p>
    <div class="acts">
      <a class="btn primary lg" href={SITE.start} data-ph="signup_cta_click" data-ph-location="ai_hero">{start}</a>
      <a class="btn ghost lg" href="#how">{c.ctaHow}</a>
    </div>
    <p class="ai-answer"><strong>{c.answerLabel}</strong> {c.answer}</p>
  </div></section>

  <section class="ai-feats" id="features" aria-labelledby="ai-feats-h"><div class="wrap">
    <div class="ai-head ai-rv">
      <h2 id="ai-feats-h">{c.featuresTitle}</h2>
      <p>{c.featuresSub}</p>
    </div>
    {groups.map((g) => (
      <div class="ai-group">
        <div class="ai-gh ai-rv">
          <span class="ai-gi" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={GI[g]} /></svg></span>
          <h3>{c.groups[g].title}</h3>
          <p>{c.groups[g].text}</p>
        </div>
        <ul class={`ai-grid g-${g}`} role="list">
          {AI_GROUPS[g].map((k: AiFeature, i: number) => (
            <li class="ai-card ai-rv" style={`--i:${i}`}>
              <div class={`ai-vis v-${k}`} aria-hidden="true">
                {k === 'support' && <><p class="b me">{v.support.q}</p><p class="b ai"><i class="sp"><svg viewBox="0 0 24 24"><path d={spark} /></svg></i>{v.support.a}</p></>}
                {k === 'faq' && <><p class="field"><svg viewBox="0 0 24 24"><path d="M10.5 4a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13zM20 20l-4.8-4.8" /></svg>{v.faq.q}</p><p class="ans">{v.faq.a}<span>{v.faq.from}</span></p></>}
                {k === 'translate' && <><p class="src">{v.translate.from}</p><p class="chip on">{v.translate.lang}</p><p class="out">{v.translate.to}</p></>}
                {k === 'autofill' && <><p class="paste">{v.autofill.pasted}</p><dl>{v.autofill.fields.map(([a, b]) => <><dt>{a}</dt><dd>{b}</dd></>)}</dl></>}
                {k === 'recommend' && <><p class="field"><svg viewBox="0 0 24 24"><path d={spark} /></svg>{v.recommend.q}</p><ul>{v.recommend.items.map(([a, b], n) => <li><span class="th" style={`--h:${n}`}></span><b>{a}</b><span>{b}</span></li>)}</ul></>}
                {k === 'reviews' && <><p class="cnt"><span class="stars">★★★★★</span>{v.reviews.count}</p><ul>{v.reviews.lines.map((l) => <li>{l}</li>)}</ul></>}
                {k === 'describe' && <><p class="paste">{v.describe.notes}</p><p class="out">{v.describe.out}</p><p class="use">{v.describe.use}</p></>}
                {k === 'reply' && <><p class="b them">{v.reply.incoming}</p><p class="draft">{v.reply.draft}</p><p class="use">{v.reply.use}</p></>}
                {k === 'image' && <><p class="field"><svg viewBox="0 0 24 24"><path d={spark} /></svg>{v.image.prompt}</p><svg class="pic" viewBox="0 0 480 120" preserveAspectRatio="xMidYMid slice"><defs><linearGradient id={`pw-${code}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" class="p-wall1" /><stop offset="1" class="p-wall2" /></linearGradient><radialGradient id={`pl-${code}`} cx=".7" cy="0" r=".6"><stop offset="0" class="p-light" /><stop offset="1" class="p-light0" /></radialGradient></defs><rect width="480" height="120" fill={`url(#pw-${code})`} /><rect width="480" height="120" fill={`url(#pl-${code})`} /><rect y="82" width="480" height="38" class="p-table" /><path d="M0 95h480M0 108h480" class="p-grain" /><ellipse cx="240" cy="92" rx="46" ry="7" class="p-shadow" /><ellipse cx="240" cy="88" rx="40" ry="8" class="p-saucer" /><path d="M214 54h52l-5 30a6 6 0 0 1-6 5h-30a6 6 0 0 1-6-5z" class="p-cup" /><path d="M266 60c10 0 12 14 0 16" class="p-handle" /><ellipse cx="240" cy="54" rx="26" ry="5" class="p-coffee" /><path d="M234 53c3-2 9-2 12 0-3 2-9 2-12 0z" class="p-foam" /><path d="M232 44c-4-5 4-8 0-14M246 44c-4-5 4-8 0-14" class="p-steam" /></svg><p class="use">{v.image.use}</p></>}
                {k === 'leads' && <><div class="inbox"><div class="row hot"><p class="msg">{v.leads.msg}</p><p class="tagrow"><span class="tag">{v.leads.tag}</span><span>{v.leads.next}</span></p></div><div class="row ghost"><i></i><i></i></div><div class="row ghost"><i></i><i></i></div></div></>}
                {k === 'moderation' && <ul>{v.moderation.rows.map(([t, s], n) => <li class={n === 2 ? 'no' : undefined}><span>{t}</span><b>{s}</b></li>)}</ul>}
              </div>
              <h4>{c.features[k].title}</h4>
              <p>{c.features[k].text}</p>
            </li>
          ))}
        </ul>
      </div>
    ))}
    <p class="ai-illu">{c.illuNote}</p>
  </div></section>

  <section class="ai-how" id="how" aria-labelledby="ai-how-h"><div class="wrap">
    <div class="ai-head ai-rv"><h2 id="ai-how-h">{c.how.title}</h2></div>
    <div class="ai-how-in">
      <div class="ai-how-l ai-rv">
        <p class="ai-ask"><span>{c.how.askLabel}</span>{c.how.ask}</p>
        <ol class="ai-steps">
          {c.how.steps.map((s, i) => <li><span class="n" aria-hidden="true">{i + 1}</span><div><h3>{s.title}</h3><p>{s.text}</p></div></li>)}
        </ol>
        <p class="ai-note">{c.how.note}</p>
      </div>
      <figure class="ai-shot ai-rv">
        <div class="ai-frame">
          <picture class="th-light"><source media="(max-width: 600px)" srcset="/screens/ai/widget-phone-light.webp" width="864" height="1024" /><img src="/screens/ai/widget-light.webp" width="1520" height="1120" loading="lazy" decoding="async" alt={c.how.shotAlt} /></picture>
          <picture class="th-dark"><source media="(max-width: 600px)" srcset="/screens/ai/widget-phone-dark.webp" width="864" height="1024" /><img src="/screens/ai/widget-dark.webp" width="1520" height="1120" loading="lazy" decoding="async" alt={c.how.shotAlt} /></picture>
        </div>
        <figcaption>{c.how.shotCaption}</figcaption>
      </figure>
    </div>
  </div></section>

  <section class="ai-price" id="pricing" aria-labelledby="ai-price-h"><div class="wrap">
    <div class="ai-head ai-rv"><h2 id="ai-price-h">{c.pricing.title}</h2><p>{c.pricing.lead}</p></div>
    <div class="ai-price-in">
      <ul class="ai-points" role="list">
        {c.pricing.points.map((p, i) => <li class="ai-rv" style={`--i:${i}`}><h3>{p.title}</h3><p>{p.text}</p></li>)}
        <li class="ai-models ai-rv" style="--i:3"><p>{c.pricing.models}</p></li>
      </ul>
      <figure class="ai-shot ai-rv">
        <div class="ai-frame">
          <img class="th-light" src="/screens/ai/panel-light.webp" width="1040" height="1078" loading="lazy" decoding="async" alt={c.pricing.panelAlt} />
          <img class="th-dark" src="/screens/ai/panel-dark.webp" width="1040" height="1078" loading="lazy" decoding="async" alt={c.pricing.panelAlt} />
        </div>
        <figcaption>{c.pricing.panelCaption}</figcaption>
      </figure>
    </div>
  </div></section>

  <section class="ai-sec" id="security" aria-labelledby="ai-sec-h"><div class="wrap">
    <div class="ai-head ai-rv"><h2 id="ai-sec-h">{c.security.title}</h2><p>{c.security.lead}</p></div>
    <ul class="ai-sec-grid" role="list">
      {c.security.items.map((it, i) => (
        <li class="ai-rv" style={`--i:${i % 3}`}>
          <span class="ai-gi" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={SI[i]} /></svg></span>
          <h3>{it.title}</h3>
          <p>{it.text}</p>
        </li>
      ))}
    </ul>
  </div></section>

  <section class="ai-more"><div class="wrap">
    <div class="ai-two">
      <div class="ai-box ai-rv">
        <h2>{c.later.title}</h2>
        <p>{c.later.text}</p>
        <ul>{c.later.items.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div class="ai-box ai-dev ai-rv">
        <h2>{c.dev.title}</h2>
        <p>{c.dev.text}</p>
        <pre><code>curl https://ai.equipe.im/v1/chat/completions \
  -H "Authorization: Bearer $EQUIPE_AI_KEY" \
  -d '&#123;"model": "fast", "messages": [...]&#125;'</code></pre>
        <a class="ai-link" href={DOCS} data-ph="ai_docs_click" data-ph-location="ai_page">{c.dev.link}<svg viewBox="0 0 24 24" aria-hidden="true"><path d={arrow} /></svg></a>
      </div>
    </div>
  </div></section>

  <section class="ai-faq" id="faq" aria-labelledby="ai-faq-h"><div class="wrap">
    <h2 id="ai-faq-h">{c.faqTitle}</h2>
    <div class="faqs">
      {c.faq.map((f, i) => <details open={i === 0}><summary><h3>{f.question}</h3></summary><p>{f.answer}</p></details>)}
    </div>
  </div></section>

  <section class="ai-cta"><div class="wrap">
    <h2>{c.cta.title}</h2>
    <p>{c.cta.text}</p>
    <div class="acts">
      <a class="btn primary lg" href={SITE.start} data-ph="signup_cta_click" data-ph-location="ai_bottom">{start}</a>
      <a class="btn ghost lg" href={subPath(info, 'pricing')}>{c.cta.pricing}</a>
    </div>
  </div></section>
</PageShell>

<script>
  // Motion, only when the visitor allows it: blocks fade up as they arrive and each feature's little scene plays once.
  // Anything already on screen at load is shown as it is (no flash). Without this script everything shows its finished state.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const els = [...document.querySelectorAll<HTMLElement>('.ai-rv')];
    const vh = innerHeight;
    els.forEach((el) => { if (el.getBoundingClientRect().top < vh) el.classList.add('in'); });
    document.documentElement.classList.add('ai-mo');
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
    els.forEach((el) => { if (!el.classList.contains('in')) io.observe(el); });
    addEventListener('beforeprint', () => els.forEach((el) => el.classList.add('in')));
  }
</script>
