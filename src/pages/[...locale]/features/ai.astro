---
// /features/ai/: the ready-made AI features an equipe team adds to the product it builds ("AI in your product").
// Copy: src/data/productai.ts (8 languages). Facts: equipe-cloud docs/product-ai.md and ai.equipe.im/docs, public parts only.
// Layout: a left-aligned hero beside the quotable short answer, the 11 features as cards (ui.equipe.im features/feature-72:
// a picture of the part above its words), how it works (features/how-it-works-steps) with the chat widget rendered from
// its own styles, pricing with the real AI panel (sample numbers), security as a divided grid (features/features-4), what
// is not available yet, developers, FAQ (FAQPage JSON-LD from the same strings), call to action.
// The pictures are small product parts built from kit pieces (shadcn Message/Bubble, a macOS segmented control, form
// fields, Decision Inbox rows, a rating summary) with sample words from made-up businesses, aria-hidden. No sparkles,
// robots, gradients or tinted icon tiles; icons are Lucide at one stroke width; equipe blue is the only accent.
import PageShell from '../../../components/PageShell.astro';
import FaqJsonLd from '../../../components/FaqJsonLd.astro';
import JsonLd from '../../../components/JsonLd.astro';
import { SITE } from '../../../data/site';
import { NAV } from '../../../data/nav';
import { AI_GROUPS, AI_FEATURES, aiCopy, type AiFeature, type AiGroup } from '../../../data/productai';
import { available, getLocale, localePath, subPath, type LocaleCode } from '../../../i18n';
import '../../../styles/ai.css';

export function getStaticPaths() { return available.map((l) => ({ params: { locale: l.slug || undefined }, props: { code: l.code } })); }
const { code } = Astro.props as { code: LocaleCode };
const info = getLocale(code);
const c = aiCopy(code);
const P = c.page;
const v = c.vis;
const url = new URL(subPath(info, 'features/ai'), Astro.site).href;
const home = new URL(localePath(info), Astro.site).href;
const start = NAV[code]?.start ?? NAV.en.start;
const DOCS = 'https://ai.equipe.im/docs';
const groups = Object.keys(AI_GROUPS) as AiGroup[];
// Lucide icons (the set ui.equipe.im uses), as SVG children; drawn at 16 px with one stroke width.
const IC = {
  search: '<path d="m21 21-4.34-4.34"/><circle cx="11" cy="11" r="8"/>',
  paste: '<path d="M11 14h10"/><path d="M16 4h2a2 2 0 0 1 2 2v1.344"/><path d="m17 18 4-4-4-4"/><path d="M8 4H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 1.793-1.113"/><rect x="8" y="2" width="8" height="4" rx="1"/>',
  image: '<rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>',
  cup: '<path d="M10 2v2"/><path d="M14 2v2"/><path d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 1 1 0 8h-1"/><path d="M6 2v2"/>',
  flower: '<path d="M12 5a3 3 0 1 1 3 3m-3-3a3 3 0 1 0-3 3m3-3v1M9 8a3 3 0 1 0 3 3M9 8h1m5 0a3 3 0 1 1-3 3m3-3h-1m-2 3v-1"/><circle cx="12" cy="8" r="2"/><path d="M12 10v12"/><path d="M12 22c4.2 0 7-1.667 7-5-4.2 0-7 1.667-7 5Z"/><path d="M12 22c-4.2 0-7-1.667-7-5 4.2 0 7 1.667 7 5Z"/>',
  ok: '<circle cx="12" cy="12" r="10"/><path d="m16 9-5.5 5.5L8 12"/>',
  ban: '<circle cx="12" cy="12" r="10"/><path d="M4.929 4.929 19.07 19.071"/>',
  arrow: '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
  key: '<path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"/><circle cx="16.5" cy="7.5" r=".5" fill="currentColor"/>',
  browser: '<path d="m14.5 12.5-5-5"/><path d="m9.5 12.5 5-5"/><rect width="20" height="14" x="2" y="3" rx="2"/><path d="M12 17v4"/><path d="M8 21h8"/>',
  people: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><path d="M16 3.128a4 4 0 0 1 0 7.744"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><circle cx="9" cy="7" r="4"/>',
  clock: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',
  lock: '<rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
  trash: '<path d="M10 11v6"/><path d="M14 11v6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>',
};
const SI = [IC.key, IC.browser, IC.people, IC.clock, IC.lock, IC.trash];
const STAR = 'M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z';
// "Mood: very positive" -> ["Mood", "very positive"] (full-width colon too), for the summary's label/value rows.
const kv = (line: string) => { const m = line.match(/^(.+?)\s*[:：]\s*(.+)$/); return m ? [m[1], m[2]] : ['', line]; };
// The reply draft's "[check: …]" note, marked the way the admin shows it.
const draftParts = (t: string) => { const m = t.match(/^(.*?)(\[[^\]]+\])(.*)$/); return m ? [m[1], m[2], m[3]] : [t, '', '']; };
const reviewRows = v.reviews.lines.map(kv);
const draft = draftParts(v.reply.draft);
---
<PageShell code={code} page="features/ai" title={P.title} description={P.desc} image={`/og/ai-${info.slug || 'en'}.png`} imageAlt={P.ogAlt}>
  <Fragment slot="head">
    <JsonLd data={{
      '@type': 'WebPage', '@id': `${url}#page`, url, name: P.h1, description: P.desc, inLanguage: info.lang,
      isPartOf: { '@id': `${url}#website` }, about: { '@id': `${SITE.url}/#organization` },
      primaryImageOfPage: new URL(`/og/ai-${info.slug || 'en'}.png`, Astro.site).href,
      significantLink: [DOCS],
      mainEntity: { '@type': 'ItemList', name: c.featuresTitle, numberOfItems: AI_FEATURES.length, itemListElement: AI_FEATURES.map((k, i) => ({ '@type': 'ListItem', position: i + 1, name: c.features[k].title, description: c.features[k].text })) },
    }} />
    <JsonLd data={{
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'equipe', item: home },
        { '@type': 'ListItem', position: 2, name: c.nav, item: url },
      ],
    }} />
    <FaqJsonLd lang={info.lang} faqs={c.faq} />
  </Fragment>

  <section class="ai-hero"><div class="wrap">
    <div class="ai-hero-l">
      <h1>{P.h1}</h1>
      <p class="lead">{P.lead}</p>
      <div class="acts">
        <a class="btn primary lg" href={SITE.start} data-ph="signup_cta_click" data-ph-location="ai_hero">{start}</a>
        <a class="btn ghost lg" href="#how">{c.ctaHow}</a>
      </div>
    </div>
    <p class="ai-answer"><strong>{c.answerLabel}</strong> {c.answer}</p>
  </div></section>

  <section class="ai-feats" id="features" aria-labelledby="ai-feats-h"><div class="wrap">
    <div class="ai-head">
      <h2 id="ai-feats-h">{c.featuresTitle}</h2>
      <p>{c.featuresSub}</p>
    </div>
    {groups.map((g) => (
      <div class="ai-group">
        <h3 class="ai-gh">{c.groups[g].title}<span>{c.groups[g].text}</span></h3>
        <ul class={`ai-grid g-${g}`} role="list">
          {AI_GROUPS[g].map((k: AiFeature) => (
            <li class={`ai-card${k === 'support' ? ' wide' : ''}`}>
              <div class={`ai-vis v-${k}`} aria-hidden="true"><div class="sc">
                {k === 'support' && <><p class="sc-who"><span class="mono sm">SD</span><b>Sunny Days Travel</b></p><p class="k-me">{v.support.q}</p><p class="k-ai">{v.support.a}</p></>}
                {k === 'faq' && <><p class="k-field"><svg class="ic" viewBox="0 0 24 24" set:html={IC.search} /><span>{v.faq.q}</span></p><div class="k-card"><p>{v.faq.a}</p><p class="k-src">{v.faq.from}</p></div></>}
                {k === 'translate' && <><p class="k-seg"><span>{info.name}</span><span class="on">{v.translate.lang}</span></p><p class="k-orig">{v.translate.from}</p><div class="k-card k-page"><p class="k-pg-t">{v.translate.to}</p></div></>}
                {k === 'autofill' && <><p class="k-note"><svg class="ic" viewBox="0 0 24 24" set:html={IC.paste} /><span>{v.autofill.pasted}</span></p><dl class="k-form">{v.autofill.fields.map(([a, b]) => <div><dt>{a}</dt><dd>{b}</dd></div>)}</dl></>}
                {k === 'recommend' && <><p class="k-field"><svg class="ic" viewBox="0 0 24 24" set:html={IC.search} /><span>{v.recommend.q}</span></p><ul class="k-rows">{v.recommend.items.map(([a, b], n) => <li><span class="k-th"><svg class="ic" viewBox="0 0 24 24" set:html={n ? IC.flower : IC.cup} /></span><b>{a}</b><span class="r-n">{b}</span></li>)}</ul></>}
                {k === 'reviews' && <><p class="k-rate"><b>4.8</b><span class="stars">{[0, 1, 2, 3, 4].map(() => <svg class="star" viewBox="0 0 24 24"><path d={STAR} /></svg>)}</span><span class="r-n">{v.reviews.count}</span></p><dl class="k-kv">{reviewRows.map(([a, b]) => <div><dt>{a}</dt><dd>{b}</dd></div>)}</dl></>}
                {k === 'describe' && <><p class="k-note"><span>{v.describe.notes}</span></p><div class="k-card"><p>{v.describe.out}</p></div><p class="k-acts"><span class="k-btn">{v.describe.use}</span></p></>}
                {k === 'reply' && <><p class="k-msg"><span class="k-av">M</span><span>{v.reply.incoming}</span></p><div class="k-card"><p>{draft[0]}{draft[1] && <mark>{draft[1]}</mark>}{draft[2]}</p></div><p class="k-acts"><span class="k-btn">{v.reply.use}</span></p></>}
                {k === 'image' && <><p class="k-field"><svg class="ic" viewBox="0 0 24 24" set:html={IC.image} /><span>{v.image.prompt}</span></p><div class="k-pic"><svg viewBox="0 0 320 112" preserveAspectRatio="xMidYMid slice"><rect width="320" height="112" class="p-wall" /><rect y="74" width="320" height="38" class="p-table" /><path d="M0 88h320M0 101h320" class="p-grain" /><ellipse cx="160" cy="82" rx="44" ry="7" class="p-saucer" /><path d="M134 44h52l-5 32a6 6 0 0 1-6 5h-30a6 6 0 0 1-6-5z" class="p-cup" /><path d="M186 50c10 0 12 14 0 16" class="p-handle" /><ellipse cx="160" cy="44" rx="26" ry="5" class="p-coffee" /><path d="M153 43c3-2 11-2 14 0-3 2-11 2-14 0z" class="p-foam" /></svg><span class="k-btn">{v.image.use}</span></div></>}
                {k === 'leads' && <><ul class="k-inbox"><li><span class="k-av">J</span><span class="msg">{v.leads.msg}</span><b class="k-tag on">{v.leads.tag}</b></li><li class="ghost"><span class="k-av"></span><i></i><i class="t"></i></li><li class="ghost"><span class="k-av"></span><i class="s"></i><i class="t"></i></li></ul><p class="k-next"><svg class="ic" viewBox="0 0 24 24" set:html={IC.arrow} />{v.leads.next}</p></>}
                {k === 'moderation' && <ul class="k-inbox k-mod">{v.moderation.rows.map(([t, st], n) => <li class={n === 2 ? 'no' : undefined}><span class="msg">{t}</span><b><svg class="ic" viewBox="0 0 24 24" set:html={n === 2 ? IC.ban : IC.ok} />{st}</b></li>)}</ul>}
              </div></div>
              <div class="ai-card-t">
                <h4>{c.features[k].title}</h4>
                <p>{c.features[k].text}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))}
    <p class="ai-illu">{c.illuNote}</p>
  </div></section>

  <section class="ai-how" id="how" aria-labelledby="ai-how-h"><div class="wrap">
    <div class="ai-head"><h2 id="ai-how-h">{c.how.title}</h2></div>
    <div class="ai-how-in">
      <div class="ai-how-l">
        <div class="ai-ask"><span>{c.how.askLabel}</span><p>{c.how.ask}</p></div>
        <ol class="ai-steps">
          {c.how.steps.map((s, i) => <li><span class="n" aria-hidden="true">{i + 1}</span><div><h3>{s.title}</h3><p>{s.text}</p></div></li>)}
        </ol>
        <p class="ai-note">{c.how.note}</p>
      </div>
      <figure class="ai-shot">
        <div class="ai-frame">
          <picture class="th-light"><source media="(max-width: 600px)" srcset="/screens/ai/widget-phone-light.webp" width="864" height="1024" /><img src="/screens/ai/widget-light.webp" width="1520" height="1120" loading="lazy" decoding="async" alt={c.how.shotAlt} /></picture>
          <picture class="th-dark"><source media="(max-width: 600px)" srcset="/screens/ai/widget-phone-dark.webp" width="864" height="1024" /><img src="/screens/ai/widget-dark.webp" width="1520" height="1120" loading="lazy" decoding="async" alt={c.how.shotAlt} /></picture>
        </div>
        <figcaption>{c.how.shotCaption}</figcaption>
      </figure>
    </div>
  </div></section>

  <section class="ai-price" id="pricing" aria-labelledby="ai-price-h"><div class="wrap">
    <div class="ai-head"><h2 id="ai-price-h">{c.pricing.title}</h2><p>{c.pricing.lead}</p></div>
    <div class="ai-price-in">
      <ul class="ai-points" role="list">
        {c.pricing.points.map((p) => <li><h3>{p.title}</h3><p>{p.text}</p></li>)}
        <li class="ai-models"><p>{c.pricing.models}</p></li>
      </ul>
      <figure class="ai-shot">
        <div class="ai-frame">
          <img class="th-light" src="/screens/ai/panel-light.webp" width="1040" height="1078" loading="lazy" decoding="async" alt={c.pricing.panelAlt} />
          <img class="th-dark" src="/screens/ai/panel-dark.webp" width="1040" height="1078" loading="lazy" decoding="async" alt={c.pricing.panelAlt} />
        </div>
        <figcaption>{c.pricing.panelCaption}</figcaption>
      </figure>
    </div>
  </div></section>

  <section class="ai-sec" id="security" aria-labelledby="ai-sec-h"><div class="wrap">
    <div class="ai-head"><h2 id="ai-sec-h">{c.security.title}</h2><p>{c.security.lead}</p></div>
    <ul class="ai-sec-grid" role="list">
      {c.security.items.map((it, i) => (
        <li>
          <h3><svg class="ic" viewBox="0 0 24 24" aria-hidden="true" set:html={SI[i]} />{it.title}</h3>
          <p>{it.text}</p>
        </li>
      ))}
    </ul>
  </div></section>

  <section class="ai-more"><div class="wrap">
    <div class="ai-two">
      <div class="ai-box">
        <h2>{c.later.title}</h2>
        <p>{c.later.text}</p>
        <ul>{c.later.items.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div class="ai-box ai-dev">
        <h2>{c.dev.title}</h2>
        <p>{c.dev.text}</p>
        <pre><code>curl https://ai.equipe.im/v1/chat/completions \
  -H "Authorization: Bearer $EQUIPE_AI_KEY" \
  -d '&#123;"model": "fast", "messages": [...]&#125;'</code></pre>
        <a class="ai-link" href={DOCS} data-ph="ai_docs_click" data-ph-location="ai_page">{c.dev.link}<svg class="ic" viewBox="0 0 24 24" aria-hidden="true" set:html={IC.arrow} /></a>
      </div>
    </div>
  </div></section>

  <section class="ai-faq" id="faq" aria-labelledby="ai-faq-h"><div class="wrap">
    <h2 id="ai-faq-h">{c.faqTitle}</h2>
    <div class="faqs">
      {c.faq.map((f, i) => <details open={i === 0}><summary><h3>{f.question}</h3></summary><p>{f.answer}</p></details>)}
    </div>
  </div></section>

  <section class="ai-cta"><div class="wrap">
    <h2>{c.cta.title}</h2>
    <p>{c.cta.text}</p>
    <div class="acts">
      <a class="btn primary lg" href={SITE.start} data-ph="signup_cta_click" data-ph-location="ai_bottom">{start}</a>
      <a class="btn ghost lg" href={subPath(info, 'pricing')}>{c.cta.pricing}</a>
    </div>
  </div></section>
</PageShell>
