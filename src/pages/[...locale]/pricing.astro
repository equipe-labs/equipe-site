---
// /pricing: the plans (same data as the home page), the pricing facts and the cost FAQ.
import PageShell from '../../components/PageShell.astro';
import WebApplicationJsonLd from '../../components/WebApplicationJsonLd.astro';
import FaqJsonLd from '../../components/FaqJsonLd.astro';
import CustomerLogos from '../../components/CustomerLogos.astro';
import PlanCards from '../../components/PlanCards.astro';
import PromoBanner from '../../components/PromoBanner.astro';
import PackStrip from '../../components/PackStrip.astro';
import '../../styles/sections.css';
import { TYPICAL_TOTALS } from '../../data/flags';
import { aiCopy } from '../../data/productai';
import { available, getLocale, getMessages, subPath, type LocaleCode } from '../../i18n';
export function getStaticPaths() { return available.map((l) => ({ params: { locale: l.slug || undefined }, props: { code: l.code } })); }
const { code } = Astro.props as { code: LocaleCode };
const info = getLocale(code);
const t = getMessages(code);
const P = t.pages.pricing;
const cost = t.faq.items[4];
const AI = aiCopy(code).pricingNote;
---
<PageShell code={code} page="pricing" title={P.title} description={P.desc} image={`/og/v4/pricing-${info.slug || 'en'}.png`} imageAlt={`equipe — ${P.lead}`}>
  <WebApplicationJsonLd slot="head" lang={info.lang} url={new URL(subPath(info, 'pricing'), Astro.site).href} description={P.desc} />
  <FaqJsonLd slot="head" lang={info.lang} faqs={[cost, ...t.plans.faq]} />
  <section class="pg-h pr-h"><div class="wrap"><h1>{P.h1}</h1><p class="pg-lead">{P.lead}</p></div></section>
  <section class="pg-s"><div class="wrap">
    <PromoBanner code={code} lang={info.lang} target="tp-pricing_page" />
    <PlanCards t={t} level="h2" loc="pricing_page" code={code} />
    <p class="pg-note tp-existing">{t.plans.existing}</p>
    <div class="pwhich"><span class="pwhich-i" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 4v16M8 20h8M5 8h14M5 8l-2.5 6a2.5 2.5 0 0 0 5 0L5 8zM19 8l-2.5 6a2.5 2.5 0 0 0 5 0L19 8z" /></svg></span><p><b>{t.plans.whichTitle}</b> {t.plans.whichText}</p></div>
    <CustomerLogos code={code} id="trust-pricing" class="ptrust" />
    <div class="pfacts">
          <div class="pfact"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5v8.5" /><path d="M7.2 6.8a7.5 7.5 0 1 0 9.6 0" /></svg><div><h2>{t.plans.runout.title}</h2><p>{t.plans.runout.text}</p></div></div>
          <div class="pfact"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="6" width="17" height="12" rx="2.5" /><path d="M3.5 10h17M7 14.5h3" /></svg><div><h2>{t.plans.credits.title}</h2><p>{t.plans.credits.text}</p></div></div>
          <div class="pfact"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 18.5h16M7 15V11M12 15V7M17 15v-2.5" /></svg><div><h2>{t.plans.estimate.title}</h2><p>{t.plans.estimate.text}</p>{TYPICAL_TOTALS?.[code] && <p class="pfact-x">{TYPICAL_TOTALS[code]}</p>}</div></div>
        </div>
    <PackStrip code={code} />
    <a class="pai" href={subPath(info, 'features/ai')} data-ph="ai_features_click" data-ph-location="pricing">
      <span class="pai-i" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z" /></svg></span>
      <span class="pai-t"><b>{AI.title}</b><span>{AI.text}</span></span>
      <span class="pai-l">{AI.link}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
    </a>
    <p class="pg-note">{t.plans.text}</p>
    <p class="pg-note pg-free">{t.plans.freeNote}</p>
    <div class="pg-prose" style="margin-top:64px">
      <h2>{cost.question}</h2>
      <p>{cost.answer}</p>
      {t.plans.faq.map((f) => <><h2>{f.question}</h2><p>{f.answer}</p></>)}
    </div>
  </div></section>
</PageShell>
