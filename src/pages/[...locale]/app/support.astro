---
import AppPageShell from '../../../components/AppPageShell.astro';
import Rich from '../../../components/Rich.astro';
import { available, getLocale, getMessages, subPath, type LocaleCode } from '../../../i18n';
import { SITE } from '../../../data/site';

// /app/support/ in English, /<slug>/app/support/ in every other language that has a translation file.
export function getStaticPaths() {
  return available.map((l) => ({ params: { locale: l.slug || undefined }, props: { code: l.code } }));
}

const { code } = Astro.props as { code: LocaleCode };
const messages = getMessages(code);
const locale = getLocale(code);
const s = messages.app.support;
const android = messages.start.android;
const privacy = subPath(locale, 'app/privacy');
const androidFileSha256 = 'bd8f267edeb10ce0aaed1efbb80f7b3c349895f6121e5f8a97d647d09f8d9773';
const androidCertificateSha256 = 'f6884e264a84a48b04cf7b04256e40e3887543795b430e367aee2ff769041a87';
---

<AppPageShell code={code} subpage="app/support" title={s.meta.title} description={s.meta.description}>
  <h1>{s.title}</h1>
  <p class="lead">{s.intro}</p>
  <p><a class="btn primary" href={SITE.desktopDmg} data-ph="desktop_download_click" data-ph-location="support" download>{messages.hero.cta}</a></p>

  <section class="doc-section android-install">
    <h2>{android.title}</h2>
    <p>{android.intro}</p>
    <p><a class="btn" href={SITE.androidApk} data-ph="android_download_click" data-ph-location="support">{android.download}</a></p>
    <ol>
      {android.steps.map((step) => <li><Rich s={step} /></li>)}
    </ol>
    <p>{android.playStore}</p>
    <dl class="android-hashes">
      <div><dt>{android.fileSha256}</dt><dd><code>{androidFileSha256}</code></dd></div>
      <div><dt>{android.certificateSha256}</dt><dd><code>{androidCertificateSha256}</code></dd></div>
    </dl>
  </section>

  <section class="doc-section">
    <h2>{s.pairTitle}</h2>
    <ol>
      {s.pairSteps.map((step) => <li><Rich s={step} /></li>)}
    </ol>
    <div class="codeblock"><pre tabindex="0"><code>{s.pairCode}</code></pre></div>
    <h3>{s.removeTitle}</h3>
    <p><Rich s={s.removeText} /></p>
  </section>

  <section class="doc-section">
    <h2>{s.faqTitle}</h2>
    {s.faq.map((f) => (
      <details>
        <summary><h3>{f.question}</h3></summary>
        <p><Rich s={f.answer} /></p>
      </details>
    ))}
    <p class="small"><a href={privacy}>{getMessages(code).app.nav.privacy}</a></p>
  </section>

  <section class="doc-section">
    <h2>{s.contactTitle}</h2>
    <p>{s.contactText}</p>
  </section>
</AppPageShell>

<style is:global>
  body:has(.android-install) header.site { position: static; }
  main.doc:has(.android-install) { padding-top: var(--s-8); }
</style>
