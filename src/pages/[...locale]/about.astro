---
// /about: who runs equipe and why. The founder block shows only once the owner supplies it (src/data/flags.ts FOUNDER).
import PageShell from '../../components/PageShell.astro';
import JsonLd from '../../components/JsonLd.astro';
import { SITE } from '../../data/site';
import { FOUNDER, ADVISERS, ADVISERS_HEADING, TEAM, TEAM_HEADING } from '../../data/flags';
import { available, getLocale, getMessages, subPath, type LocaleCode } from '../../i18n';
import { BLOG_UI, blogLangFor, blogPath } from '../../data/blog';
export function getStaticPaths() { return available.map((l) => ({ params: { locale: l.slug || undefined }, props: { code: l.code } })); }
const { code } = Astro.props as { code: LocaleCode };
const A = getMessages(code).pages.about;
const lang = getLocale(code).code;
const [cBefore, cAfter] = A.contact.split('{email}');
const T = getMessages(code);
const info = getLocale(code);
// Facts and the blog exist in English and Korean; other languages link to the English pages.
const bl = blogLangFor(code);
const bu = BLOG_UI[bl];
const factsHref = bl === 'en' ? '/facts/' : `/${bl}/facts/`;
// Origin story: English and Korean; other languages show the English line.
const ORIGIN: Record<string, [string, string]> = {
  en: ['equipe started as an open-source project, the equipe engine, and is now a cloud service that gives people who do not code their own AI startup team.', 'github.com/equipe-labs/equipe'],
  ko: ['equipe는 오픈소스 프로젝트(equipe 엔진)로 시작했고, 지금은 코딩을 모르는 사람에게 자기만의 AI 스타트업 팀을 주는 클라우드 서비스예요.', 'github.com/equipe-labs/equipe'],
};
const origin = ORIGIN[lang] ?? ORIGIN.en;
const links = [
  { href: subPath(info, 'security'), label: T.nav.security },
  { href: subPath(info, 'pricing'), label: T.nav.pricing },
  { href: subPath(info, 'changelog'), label: T.pages.changelog.h1 },
  { href: factsHref, label: bu.facts },
  { href: blogPath(bl), label: bu.nav },
  { href: SITE.repo, label: 'GitHub' },
];
---
<PageShell code={code} page="about" title={A.title} description={A.desc}>
  <section class="pg-h"><div class="wrap"><h1>{A.h1}</h1></div></section>
  <section class="pg-s"><div class="wrap">
    <div class="pg-prose">
      <p class="mission">{A.mission}</p>
      {A.body.map((p) => <p>{p}</p>)}
      <p>{origin[0]} <a href={SITE.repo}>{origin[1]}</a></p>
      {FOUNDER && (
        <>
          <h2 id="team">{TEAM_HEADING[lang] ?? TEAM_HEADING.en}</h2>
          <div class="pg-founder"><picture><source type="image/webp" srcset="/brand/founder-400.webp" /><img src={FOUNDER.photo} alt={FOUNDER.name} width="120" height="120" /></picture><div><p><b>{FOUNDER.name}</b> · {FOUNDER.role[lang] ?? FOUNDER.role.en}</p><p>{FOUNDER.story[lang] ?? FOUNDER.story.en}</p><p class="pg-links"><a href={FOUNDER.links.x} rel="me noopener">X</a><a href={FOUNDER.links.linkedin} rel="me noopener">LinkedIn</a></p></div></div>
        </>
      )}
      {TEAM.map((m) => (
        <div class="pg-founder pg-adviser">{m.photo ? <picture><source type="image/webp" srcset={m.photo.replace(/\.jpg$/, '.webp')} /><img src={m.photo} alt={m.name} width="120" height="120" loading="lazy" /></picture> : <div class="pg-mono" aria-hidden="true">{m.initials}</div>}<div><p><b>{m.name}</b> · {m.role[lang] ?? m.role.en}</p><p>{m.bio[lang] ?? m.bio.en}</p><p class="pg-links"><a href={m.links.linkedin} rel="me noopener">LinkedIn</a></p></div></div>
      ))}
      {ADVISERS.length > 0 && (
        <>
          <h2 id="advisers">{ADVISERS_HEADING[lang] ?? ADVISERS_HEADING.en}</h2>
          {ADVISERS.map((a) => (
            <div class="pg-founder pg-adviser">{a.photo ? <picture><source type="image/webp" srcset="/brand/akki-400.webp" /><img src={a.photo} alt={a.name} width="120" height="120" loading="lazy" /></picture> : <div class="pg-mono" aria-hidden="true">{a.initials}</div>}<div><p><b>{a.name}</b> · {a.role[lang] ?? a.role.en}</p><p>{a.bio[lang] ?? a.bio.en}</p><p class="pg-links"><a href={a.links.linkedin} rel="me noopener">LinkedIn</a><a href={a.links.web} rel="me noopener">Web</a><a href={a.links.github} rel="me noopener">GitHub</a></p></div></div>
          ))}
        </>
      )}
      <h2>{A.ossH}</h2>
      <p>{A.oss} <a href={SITE.repo}>github.com/equipe-labs/equipe</a></p>
      <h2>{bu.links}</h2>
      <ul class="pg-links">{links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      <h2>{A.contactH}</h2>
      <p>{cBefore}<a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a>{cAfter}</p>
    </div>
  </div></section>
  {TEAM.map((m) => (
    <JsonLd data={{ '@type': 'Person', name: m.name, alternateName: m.fullName, jobTitle: 'Tech', ...(m.photoLarge ? { image: `${SITE.url}${m.photoLarge}` } : {}), worksFor: { '@id': `${SITE.url}/#organization` }, url: `${SITE.url}/about/`, sameAs: [m.links.linkedin] }} />
  ))}
  {ADVISERS.map((a) => (
    <JsonLd data={{ '@type': 'Person', name: a.name, jobTitle: 'Head of Voices', ...(a.photoLarge ? { image: `${SITE.url}${a.photoLarge}` } : {}), worksFor: { '@type': 'Organization', name: 'Cartesia' }, affiliation: { '@id': `${SITE.url}/#organization` }, url: `${SITE.url}/about/`, sameAs: [a.links.linkedin, a.links.web, a.links.github] }} />
  ))}
</PageShell>
