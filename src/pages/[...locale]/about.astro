---
// /about: who runs equipe and why. The founder block shows only once the owner supplies it (src/data/flags.ts FOUNDER).
import PageShell from '../../components/PageShell.astro';
import JsonLd from '../../components/JsonLd.astro';
import PersonCard from '../../components/PersonCard.astro';
import { ABOUT, FOUNDER_LINE } from '../../data/about';
import { SITE } from '../../data/site';
import { FOUNDER, ADVISERS, ADVISERS_HEADING, TEAM, TEAM_HEADING } from '../../data/flags';
import { available, getLocale, getMessages, subPath, type LocaleCode } from '../../i18n';
import { BLOG_UI, blogLangFor, blogPath } from '../../data/blog';
export function getStaticPaths() { return available.map((l) => ({ params: { locale: l.slug || undefined }, props: { code: l.code } })); }
const { code } = Astro.props as { code: LocaleCode };
const A = getMessages(code).pages.about;
const lang = getLocale(code).code;
const [cBefore, cAfter] = A.contact.split('{email}');
const T = getMessages(code);
const info = getLocale(code);
// Facts and the blog exist in English and Korean; other languages link to the English pages.
const bl = blogLangFor(code);
const bu = BLOG_UI[bl];
const factsHref = bl === 'en' ? '/facts/' : `/${bl}/facts/`;
const C = ABOUT[lang] ?? ABOUT.en;
const links = [
  { href: subPath(info, 'security'), label: T.nav.security },
  { href: subPath(info, 'pricing'), label: T.nav.pricing },
  { href: subPath(info, 'changelog'), label: T.pages.changelog.h1 },
  { href: factsHref, label: bu.facts },
  { href: blogPath(bl), label: bu.nav },
  { href: SITE.repo, label: 'GitHub' },
];
---
{/* Languages without their own About copy show the English text: kept out of search so they are not duplicates of /about/ (scripts/seo-audit.mjs). */}
<PageShell code={code} page="about" title={A.title} description={A.desc} langs={Object.keys(ABOUT) as LocaleCode[]} noindex={!ABOUT[lang]}>
  <div class="ab">
    <section class="pg-h ab-hero"><div class="wrap">
      <h1 class="ld">{C.h1}</h1>
      <p class="pg-lead ab-lead ld">{C.lead}</p>
    </div></section>

    <section class="ab-s"><div class="wrap ab-story">
      <div class="rv"><h2>{C.storyH}</h2><a class="ab-gh" href={SITE.repo} rel="noopener">{C.gh}<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg></a></div>
      <div class="ab-st">
        {C.story.map((p, i) => <p class="rv" style={`--i:${i + 1}`}>{p}</p>)}
        {C.nameNote && <p class="rv ab-name" id="name" style={`--i:${C.story.length + 1}`}>{C.nameNote}</p>}
        <div class="ab-path rv" style="--i:3">
          <div class="ab-stage"><b>{C.stageA[0]}</b><span>{C.stageA[1]}</span></div>
          <svg class="ab-arrow" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          <div class="ab-stage on"><b>{C.stageB[0]}</b><span>{C.stageB[1]}</span></div>
        </div>
      </div>
    </div></section>

    <section class="ab-s"><div class="wrap">
      <h2 class="rv ab-c">{C.beliefsH}</h2>
      <div class="ab-grid ab-bel">
        {C.beliefs.map((b, i) => <div class="ab-b rv" style={`--i:${i + 1}`}><h3>{b.h}</h3><p>{b.p}</p></div>)}
      </div>
    </div></section>

    <section class="ab-s"><div class="wrap">
      <h2 id="team" class="rv ab-c">{TEAM_HEADING[lang] ?? TEAM_HEADING.en}</h2>
      <div class={`ab-people${TEAM.length + (FOUNDER ? 1 : 0) === 5 || TEAM.length + (FOUNDER ? 1 : 0) === 6 ? ' ab-c3' : ''}`}>
        {FOUNDER && <PersonCard i={1} name={FOUNDER.name} role={FOUNDER.role[lang] ?? FOUNDER.role.en} bio={FOUNDER_LINE[lang] ?? FOUNDER_LINE.en} photo={FOUNDER.photoLarge} initials="AK" links={{ linkedin: FOUNDER.links.linkedin, x: FOUNDER.links.x }} />}
        {TEAM.map((m, i) => <PersonCard i={i + 2} name={m.name} role={m.role[lang] ?? m.role.en} bio={m.bio[lang] ?? m.bio.en} photo={m.photo} initials={m.initials} links={m.links} />)}
      </div>
    </div></section>

    {ADVISERS.length > 0 && (
      <section class="ab-s"><div class="wrap">
        <h2 id="advisers" class="rv ab-c">{ADVISERS_HEADING[lang] ?? ADVISERS_HEADING.en}</h2>
        <div class={`ab-people${ADVISERS.length === 5 || ADVISERS.length === 6 ? ' ab-c3' : ''}`}>
          {ADVISERS.map((a, i) => <PersonCard i={i + 1} name={a.names?.[lang] ?? a.name} role={a.role[lang] ?? a.role.en} bio={a.bio[lang] ?? a.bio.en} photo={a.photo} initials={a.initials} links={a.links} />)}
        </div>
      </div></section>
    )}

    <section class="ab-s"><div class="wrap">
      <div class="ab-cta rv">
        <h2>{C.ctaH}</h2>
        <p>{C.ctaP}</p>
        <div class="ab-ctas"><a class="btn primary" href={SITE.start} data-ph="signup_cta_click" data-ph-location="about_page">{T.nav.cta}</a><a class="btn ghost" href={subPath(info, 'pricing')}>{C.ctaMore}</a></div>
      </div>
    </div></section>

    <section class="ab-s ab-end"><div class="wrap">
      <div class="pg-prose">
        <h2>{bu.links}</h2>
        <ul class="pg-links">{links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        <h2>{A.contactH}</h2>
        <p>{cBefore}<a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a>{cAfter}</p>
      </div>
    </div></section>
  </div>
  {TEAM.map((m) => (
    <JsonLd data={{ '@type': 'Person', name: m.name, alternateName: m.fullName, description: m.bio.en, jobTitle: m.role.en, ...(m.photoLarge ? { image: `${SITE.url}${m.photoLarge}` } : {}), worksFor: { '@id': `${SITE.url}/#organization` }, url: `${SITE.url}/about/`, sameAs: [m.links.linkedin] }} />
  ))}
  {ADVISERS.map((a) => (
    <JsonLd data={{ '@type': 'Person', name: a.name, ...(a.names?.ko ? { alternateName: a.names.ko } : {}), description: a.bio.en, jobTitle: a.jobTitle, worksFor: { '@type': 'Organization', name: a.worksFor }, ...(a.alumniOf ? { alumniOf: { '@type': 'CollegeOrUniversity', name: a.alumniOf } } : {}), affiliation: { '@id': `${SITE.url}/#organization` }, ...(a.photoLarge ? { image: `${SITE.url}${a.photoLarge}` } : {}), url: `${SITE.url}/about/`, sameAs: Object.values(a.links) }} />
  ))}
</PageShell>

<script is:inline>
  // Reveal on scroll (opacity and transform only). Skipped entirely when the visitor prefers reduced motion.
  (function () {
    var root = document.querySelector('.ab');
    if (!root || !('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    root.setAttribute('data-rv', '');
    var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); setTimeout(function () { e.target.classList.add('done'); }, 1500); } }); }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
    root.querySelectorAll('.rv').forEach(function (n) { io.observe(n); });
  })();
</script>
