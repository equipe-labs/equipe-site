---
// /websites/: the hub for the "[business type] website" guides. Lists the types this language has copy for.
import PageShell from '../../../components/PageShell.astro';
import JsonLd from '../../../components/JsonLd.astro';
import { SITE } from '../../../data/site';
import { INDUSTRY, META, typesFor } from '../../../data/industries';
import { available, getLocale, subPath, type LocaleCode } from '../../../i18n';
import '../../../styles/industry.css';

export function getStaticPaths() {
  return available.filter((l) => typesFor(l.code).length).map((l) => ({ params: { locale: l.slug || undefined }, props: { code: l.code } }));
}
const { code } = Astro.props as { code: LocaleCode };
const info = getLocale(code);
const L = INDUSTRY[code];
const u = L.ui;
const types = typesFor(code);
const url = new URL(subPath(info, 'websites'), Astro.site).href;
const langs = available.filter((l) => typesFor(l.code).length).map((l) => l.code);

const built = Object.keys(import.meta.glob(['../grader.astro', '../grader/index.astro', '../tools.astro', '../tools/index.astro']));
const toolsHub = built.some((k) => k.startsWith('../tools')) ? subPath(info, 'tools') : null;
const grader = built.some((k) => k.startsWith('../grader')) ? subPath(info, 'grader') : null;

const icon = (d: string) => `<svg viewBox="0 0 24 24" aria-hidden="true">${d}</svg>`;
const arrow = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>';
---
<PageShell code={code} page="websites" title={u.hub.title} description={u.hub.desc} langs={langs}>
  <Fragment slot="head">
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('mo');
        setTimeout(function () { if (!window.__inrv) document.documentElement.classList.remove('mo'); }, 3000);
      }
    </script>
    <JsonLd data={{
      '@type': 'CollectionPage', '@id': `${url}#page`, url, name: u.hub.h1, description: u.hub.desc, inLanguage: info.lang,
      isPartOf: { '@id': `${SITE.url}/#website` }, about: { '@id': `${SITE.url}/#organization` },
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: types.map((k, i) => ({ '@type': 'ListItem', position: i + 1, name: L.pages[k]!.name, url: new URL(subPath(info, `websites/${k}`), Astro.site).href })),
      },
    }} />
  </Fragment>

  <section class="ih-hero"><div class="wrap">
    <h1 class="in-ld" style="--d:0">{u.hub.h1}</h1>
    <p class="in-lead in-ld" style="--d:1">{u.hub.lead}</p>
  </div></section>

  <section class="in-sec" style="padding-top:0"><div class="wrap">
    <ul class="ih-grid">
      {types.map((k, i) => {
        const p = L.pages[k]!;
        return (
          <li class="in-rv" style={`transition-delay:${(i % 3) * 60}ms`}>
            <a class="ih-card" href={subPath(info, `websites/${k}`)} data-ph="industry_hub_click" data-ph-location={`hub-${k}`}>
              <span class="in-ic"><Fragment set:html={icon(META[k].icon)} /></span>
              <span class="ih-name">{p.name}</span>
              <span class="ih-lead">{p.lead}</span>
              <span class="in-go">{u.hub.open}<Fragment set:html={arrow} /></span>
            </a>
          </li>
        );
      })}
    </ul>
  </div></section>

  {(grader || toolsHub) && (
    <section class="in-sec"><div class="wrap">
      <h2 class="in-rv">{u.hub.toolsTitle}</h2>
      <ul class="in-tools">
        {grader && (
          <li class="in-rv"><a class="in-tool" href={grader} data-ph="grader_link" data-ph-location="industry-hub">
            <span class="in-tool-t">{u.grader.title}</span><span class="in-tool-d">{u.grader.text}</span>
            <span class="in-go">{u.grader.cta}<Fragment set:html={arrow} /></span>
          </a></li>
        )}
        {toolsHub && (
          <li class="in-rv" style="transition-delay:60ms"><a class="in-tool" href={toolsHub} data-ph="tools_hub_link" data-ph-location="industry-hub">
            <span class="in-tool-t">{u.toolsHub}</span><span class="in-tool-d">{u.cost.text}</span>
            <span class="in-go">{u.toolsHub}<Fragment set:html={arrow} /></span>
          </a></li>
        )}
      </ul>
    </div></section>
  )}
  <div class="in-end"></div>

  <script>
    if (document.documentElement.classList.contains('mo')) {
      (window as unknown as { __inrv: boolean }).__inrv = true;
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('.in-rv').forEach((el) => io.observe(el));
    }
  </script>
</PageShell>
