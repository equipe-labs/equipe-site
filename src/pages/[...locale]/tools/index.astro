---
// /tools/: every free tool, grouped. Data-driven: each tool is one file in src/data/tools/ (see index.ts), so adding a
// tool never touches this page. Page copy: src/data/toolshub.ts.
import PageShell from '../../../components/PageShell.astro';
import JsonLd from '../../../components/JsonLd.astro';
import { SITE } from '../../../data/site';
import { TOOLS, TOOL_ICONS, toolCopy, type ToolEntry } from '../../../data/tools/index';
import { hubCopy } from '../../../data/toolshub';
import { available, getLocale, subPath, type LocaleCode } from '../../../i18n';
import '../../../styles/tools.css';

export function getStaticPaths() { return available.map((l) => ({ params: { locale: l.slug || undefined }, props: { code: l.code } })); }
const { code } = Astro.props as { code: LocaleCode };
const info = getLocale(code);
const H = hubCopy(code);
const url = new URL(subPath(info, 'tools'), Astro.site).href;
const ORDER = ['site', 'ai', 'money', 'start', 'other'] as const;
const groups = ORDER.map((g) => ({ g, items: TOOLS.filter((t) => (t.group ?? 'other') === g) })).filter((x) => x.items.length);
const arrow = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>';
const icon = (k: string) => `<svg viewBox="0 0 24 24" aria-hidden="true">${TOOL_ICONS[k] ?? TOOL_ICONS.wrench}</svg>`;
const href = (t: ToolEntry) => new URL(subPath(info, t.path), SITE.url).href;
---
<PageShell code={code} page="tools" title={H.page.title} description={H.page.desc} image="/og/tools/tools.png" imageAlt={H.page.h1}>
  <Fragment slot="head">
    <script is:inline>if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('mo');</script>
    <JsonLd data={{
      '@type': 'CollectionPage', '@id': `${url}#page`, url, name: H.page.h1, description: H.page.desc, inLanguage: info.lang,
      publisher: { '@id': `${SITE.url}/#organization` },
      mainEntity: { '@type': 'ItemList', itemListElement: TOOLS.map((t, i) => ({ '@type': 'ListItem', position: i + 1, url: href(t), name: toolCopy(t, code).name })) },
    }} />
  </Fragment>
  <div class="tl">
    <section class="tl-hero"><div class="wrap">
      <h1>{H.page.h1}</h1>
      <p class="tl-lead">{H.page.lead}</p>
    </div></section>
    <div class="wrap tl-end">
      {groups.map(({ g, items }) => (
        <section class="tl-grp">
          <h2>{H.groups[g]}</h2>
          <ul class="tl-grid">
            {items.map((t, i) => { const c = toolCopy(t, code); return (
              <li class="tl-in" style={`--d:${Math.min(i, 6) * 60}ms`}><a class="tl-tool" href={subPath(info, t.path)} data-ph="tools_hub_click" data-ph-location="hub" data-ph-tool={t.slug}>
                <span class="ic"><Fragment set:html={icon(t.icon)} /></span><b>{c.name}</b><span class="bl">{c.blurb}</span><span class="go">{c.cta}<Fragment set:html={arrow} /></span>
              </a></li>
            ); })}
          </ul>
        </section>
      ))}
      <div class="tl-more">
        <h2>{H.more.title}</h2>
        <p>{H.more.text}</p>
        <a class="btn primary lg" href={`${SITE.start}?utm_source=equipe.im&utm_medium=tool&utm_campaign=tools-hub&utm_content=more`} data-ph="signup_cta_click" data-ph-location="tools-hub">{H.more.button}</a>
      </div>
    </div>
  </div>
  <script>
    // Every card fades in on load, a little after the one before (no scroll trigger: a card is never left hidden).
    const cards = document.querySelectorAll<HTMLElement>('.tl-in');
    requestAnimationFrame(() => requestAnimationFrame(() => cards.forEach((x) => x.classList.add('on'))));
  </script>
</PageShell>
