---
// /from-claude/: paste a Claude artifact (code, file or published link) and it goes live as a real product on
// <name>.equipe.page; the import runs on app.equipe.im/import. Copy: src/data/fromclaude.ts. Paste box: ArtifactImport.astro.
// "Claude artifact" is descriptive only: no Claude/Anthropic logo or branding, and the disclaimer closes the page.
import PageShell from '../../components/PageShell.astro';
import ArtifactImport from '../../components/ArtifactImport.astro';
import FaqJsonLd from '../../components/FaqJsonLd.astro';
import JsonLd from '../../components/JsonLd.astro';
import { SITE } from '../../data/site';
import { FROM_CLAUDE, FORMATS } from '../../data/fromclaude';
import { available, getLocale, getMessages, subPath, type LocaleCode } from '../../i18n';
import '../../styles/fromclaude.css';

export function getStaticPaths() { return available.map((l) => ({ params: { locale: l.slug || undefined }, props: { code: l.code } })); }
const { code } = Astro.props as { code: LocaleCode };
const info = getLocale(code);
const c = FROM_CLAUDE[code] ?? FROM_CLAUDE.en;
const live = getMessages(code).scene.live;
const P = c.page;
const url = new URL(subPath(info, 'from-claude'), Astro.site).href;
const sv = (d: string) => `<svg viewBox="0 0 24 24" aria-hidden="true">${d}</svg>`;
// Lucide shapes (ISC): globe, user round, credit card, database, panels, trending up.
const NEXT_ICONS = [
  sv('<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>'),
  sv('<circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/>'),
  sv('<rect width="20" height="14" x="2" y="5" rx="2"/><path d="M2 10h20"/>'),
  sv('<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 18 0V5"/><path d="M3 12a9 3 0 0 0 18 0"/>'),
  sv('<rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/>'),
  sv('<path d="M22 7 13.5 15.5 8.5 10.5 2 17"/><path d="M16 7h6v6"/>'),
];
// Addresses like your-name.equipe.page never break at their hyphen.
const nw = (text: string) => text.split(/(\S*equipe\.page)/).filter(Boolean);
const formats = FORMATS.map((f) => (f === '{icons}' ? c.how.icons : f));
const arrow = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M5.5 11.5L12 5l6.5 6.5" /></svg>';
---
<PageShell code={code} page="from-claude" title={P.title} description={P.desc}>
  <Fragment slot="head">
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('mo');
        setTimeout(function () { if (!window.__fcrv) document.documentElement.classList.remove('mo'); }, 3000);
      }
    </script>
    <JsonLd data={{
      '@type': 'WebPage', '@id': `${url}#page`, url, name: P.ogTitle, description: P.desc, inLanguage: info.lang,
      isPartOf: { '@id': `${url}#website` }, about: { '@id': `${SITE.url}/#organization` },
      mainEntity: { '@type': 'HowTo', name: P.ogTitle, step: c.how.steps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.title, text: s.text })) },
    }} />
    <FaqJsonLd lang={info.lang} faqs={c.faq.items} />
  </Fragment>

  <section class="fc-hero"><div class="wrap">
    <p class="fc-kick">{P.kicker}</p>
    <h1>{P.h1}</h1>
    <p class="fc-lead">{nw(P.lead).map((x) => (/equipe\.page$/.test(x) ? <span class="nw">{x}</span> : x))}</p>
    <p class="fc-then">{P.then}</p>
    <div class="fc-box" id="paste"><ArtifactImport code={code} id="fc-page" location="from_claude_page" /></div>
  </div></section>

  <section class="fc-sec fc-how" id="how"><div class="wrap">
    <h2 class="fc-rv">{c.how.title}</h2>
    <ol class="fc-steps">
      {c.how.steps.map((s, i) => (
        <li class="fc-rv" style={`transition-delay:${i * 80}ms`}>
          <span class="n" aria-hidden="true">{i + 1}</span>
          <h3>{s.title}</h3>
          <p>{nw(s.text).map((x) => (/equipe\.page$/.test(x) ? <span class="nw">{x}</span> : x))}</p>
          <div class="fc-vis">
            {i === 0 && <span class="fc-keys" aria-hidden="true"><kbd>⌘</kbd><kbd>V</kbd></span>}
            {i === 1 && <><span class="fc-fmt-l">{c.how.formats}</span><ul class="fc-fmts">{formats.map((f) => <li>{f}</li>)}</ul></>}
            {i === 2 && <span class="fc-url"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg><b>your-name.equipe.page</b><span class="fc-live"><i></i>{live}</span></span>}
          </div>
        </li>
      ))}
    </ol>
  </div></section>

  <section class="fc-sec" id="next"><div class="wrap">
    <h2 class="fc-rv">{c.next.title}</h2>
    <p class="fc-sub fc-rv">{c.next.sub}</p>
    <ul class="fc-next">
      {c.next.items.map((it, i) => (
        <li class="fc-rv" style={`transition-delay:${(i % 3) * 70}ms`}>
          <span class="fc-ic"><Fragment set:html={NEXT_ICONS[i]} /></span>
          <h3>{it.title}</h3>
          <p>{it.text}</p>
        </li>
      ))}
    </ul>
  </div></section>

  <section class="fc-sec fc-faq" id="faq"><div class="wrap">
    <h2 class="fc-rv">{c.faq.title}</h2>
    <div class="faqs fc-rv">
      {c.faq.items.map((f, i) => <details open={i === 0}><summary><h3>{f.question}</h3></summary><p>{f.answer}</p></details>)}
    </div>
  </div></section>

  <section class="fc-cta"><div class="wrap">
    <h2 class="fc-rv">{c.cta.title}</h2>
    <a class="btn primary lg fc-rv" href="#paste" data-aim-focus data-ph="from_claude_cta_click" data-ph-location="from_claude_bottom"><Fragment set:html={arrow} />{c.cta.button}</a>
  </div></section>

  <aside class="fc-legal"><div class="wrap"><p>{c.disclaimer}</p></div></aside>

  <script>
    const root = document.documentElement;
    if (root.classList.contains('mo')) {
      (window as unknown as { __fcrv: boolean }).__fcrv = true;
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('.fc-rv').forEach((el) => io.observe(el));
      addEventListener('beforeprint', () => document.querySelectorAll('.fc-rv').forEach((el) => el.classList.add('in')));
    }
  </script>
</PageShell>
