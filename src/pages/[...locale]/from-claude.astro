---
// /from-claude/: drop or paste a Claude artifact; it is live at a link in about 20 seconds with no sign-up, then three
// ideas, and sign-in only when one is tapped (src/components/FromClaudeFlow.astro, copy in src/data/fromclaude-flow.ts).
// "Claude artifact" is descriptive only: no Claude/Anthropic logo or branding, and the disclaimer closes the page.
import FromClaudeFlow from '../../components/FromClaudeFlow.astro';
import { available, type LocaleCode } from '../../i18n';

export function getStaticPaths() { return available.map((l) => ({ params: { locale: l.slug || undefined }, props: { code: l.code } })); }
const { code } = Astro.props as { code: LocaleCode };
---
<FromClaudeFlow code={code} />
