---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import { getMessages } from '../i18n';

// Served by the host for any unknown path, with a 404 status. Not language-specific, so it
// carries no hreflang cluster of its own and is kept out of the index and the sitemap.
const t = getMessages('en');
---

<Base locale="en" title="Page not found — equipe" description="This page does not exist." noindex>
  <a class="skip" href="#main">{t.ui.skip}</a>
  <header class="site">
    <div class="wrap">
      <a class="brand" href="/"><Mark size={28} /> equipe</a>
    </div>
  </header>

  <main id="main">
    <section class="hero">
      <div class="wrap">
        <div class="col">
          <p class="chip">404</p>
          <h1>Page not found</h1>
          <p class="lead">There is nothing at this address. It may have moved, or the link may be wrong.</p>
          <div class="ctas">
            <a class="btn primary" href="/">Go to the home page</a>
          </div>
        </div>
        <div class="hero-mark"><Mark size={200} /></div>
      </div>
    </section>
  </main>
</Base>
