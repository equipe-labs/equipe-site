---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import OrganizationJsonLd from '../components/OrganizationJsonLd.astro';
import WebSiteJsonLd from '../components/WebSiteJsonLd.astro';
import SoftwareApplicationJsonLd from '../components/SoftwareApplicationJsonLd.astro';
import FaqJsonLd from '../components/FaqJsonLd.astro';
import { SITE } from '../data/site';
import { FAQS } from '../data/faqs';

// Render `inline code` markers from the shared FAQ strings.
const parts = (s: string) => s.split('`').map((t, i) => ({ t, code: i % 2 === 1 }));

const cards = [
  { h: 'Roles', p: 'Each member has a role — PM, Designer, Frontend, Backend, QA or Data — with a model suited to that role and its own memory.', dot: 'faded' },
  { h: 'Tickets', p: 'The board is the single source of truth. Members coordinate through tickets and immutable events, not chat, so every action leaves something you can see.', dot: 'faded' },
  { h: 'Branches', p: 'Each member works in its own isolated git worktree, on its own branch, so several can work on your repository at the same time without touching your checkout.', dot: 'faded' },
  { h: 'Your approval', p: 'You stay in the loop at the approval gates. Nothing merges until you say so.', dot: 'solid' },
] as const;

const install = `git clone https://github.com/equipe-labs/equipe && cd equipe
cargo install --locked --path crates/cli`;
const run = `equipe login     # sign in to Codex or Claude Code
equipe status    # check engine readiness and model availability
equipe           # open the squad console`;
const tryIt = 'equipe try --edit "…"';
---

<Base title={SITE.title} description={SITE.description} image={SITE.ogImage} imageAlt={SITE.ogImageAlt}>
  <Fragment slot="head">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <OrganizationJsonLd />
    <WebSiteJsonLd />
    <SoftwareApplicationJsonLd description={SITE.description} />
    <FaqJsonLd faqs={FAQS} />
  </Fragment>

  <a class="skip" href="#main">Skip to content</a>
  <header class="site">
    <div class="wrap">
      <a class="brand" href="/"><Mark size={28} /> equipe</a>
      <nav aria-label="Primary">
        <ul>
          <li class="opt"><a href="#how-it-works">How it works</a></li>
          <li class="opt"><a href="#get-started">Get started</a></li>
          <li class="opt"><a href="#faq">FAQ</a></li>
          <li><a href={SITE.repo}>GitHub</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    <section class="hero">
      <div class="wrap">
        <div class="col">
          <h1>Your AI software squad, led by you.</h1>
          <p class="lead">equipe is an open-source AI software squad: a team of role-based agents (PM, Designer, Frontend, Backend, QA and Data) that works on your repository through a shared board, in isolated git worktrees, and waits for a person's approval before anything merges.</p>
          <p class="muted">equipe isn't another agent loop. It's the team layer on top of the ones that already exist — Codex and Claude Code today.</p>
          <div class="ctas">
            <a class="btn primary" href={SITE.repo}>View on GitHub</a>
            <a class="btn secondary" href="#get-started">Get started</a>
          </div>
          <span class="chip">Early-stage · MIT licensed</span>
        </div>
        <div class="hero-mark"><Mark size={200} /></div>
      </div>
    </section>

    <section id="how-it-works">
      <div class="wrap">
        <h2>How it works</h2>
        <p class="col">One person leads. The squad works in parallel. Everything passes through the board.</p>
        <div class="cards">
          {cards.map((c) => (
            <div class="card">
              <Mark size={20} single={c.dot} />
              <h3>{c.h}</h3>
              <p>{c.p}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="who-for">
      <div class="wrap col">
        <h2>Who equipe is for</h2>
        <p>equipe is for people who want to lead a small software team of AI agents instead of prompting one agent at a time. You set the direction and review the work. The squad splits it into tickets and does it on branches.</p>
        <ul class="points">
          <li><strong>You already use Codex or Claude Code.</strong> equipe drives them; you sign in the way you already do.</li>
          <li><strong>You want parallel work you can review.</strong> Each change arrives as a branch, never as a surprise on your main line.</li>
          <li><strong>You want to keep the decisions.</strong> Approval gates sit where they matter, so the call stays yours.</li>
        </ul>
        <p class="proof">This site was built by an equipe squad, in public. Every change started as a ticket and landed as a branch a person accepted.</p>
      </div>
    </section>

    <section id="get-started">
      <div class="wrap">
        <h2>Get started</h2>
        <p class="col">equipe is installed from source today. You need Rust 1.88+ and git. The Claude engine also needs the <code>claude</code> binary.</p>
        <div class="codeblock"><pre tabindex="0"><code>{install}</code></pre><button class="copy" type="button" aria-label="Copy install commands">Copy</button></div>
        <p class="col">Sign in to an engine, check it's ready, then open the squad console:</p>
        <div class="codeblock"><pre tabindex="0"><code>{run}</code></pre><button class="copy" type="button" aria-label="Copy commands">Copy</button></div>
        <p class="col">Want a first taste without the board? Let one agent edit your repo on a new branch, in an isolated worktree:</p>
        <div class="codeblock"><pre tabindex="0"><code>{tryIt}</code></pre><button class="copy" type="button" aria-label="Copy command">Copy</button></div>
        <p class="links">Read the docs on GitHub → <a href={SITE.roadmap}>Roadmap</a><a href={SITE.architecture}>Architecture</a></p>
      </div>
    </section>

    <section id="faq">
      <div class="wrap col">
        <h2>Frequently asked questions</h2>
        {FAQS.map((f) => (
          <details>
            <summary><h3>{f.question}</h3></summary>
            <p>{parts(f.answer).map((x) => (x.code ? <code>{x.t}</code> : x.t))}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap">
      <span><a href={SITE.repo}>GitHub</a> · <a href={SITE.roadmap}>Roadmap</a> · <a href={SITE.architecture}>Architecture</a></span>
      <span>MIT License</span>
      <span>Built by an equipe squad, in public.</span>
    </div>
  </footer>

  <script is:inline>
    document.querySelectorAll('.copy').forEach((b) =>
      b.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(b.previousElementSibling.textContent);
          b.textContent = 'Copied';
          setTimeout(() => (b.textContent = 'Copy'), 1500);
        } catch {}
      }),
    );
  </script>
</Base>
